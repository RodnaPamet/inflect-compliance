# ─── E2E Environment (local Playwright) ───
# Copy to .env.e2e and adjust if needed.
# Used by: scripts/e2e-local.mjs, npm run e2e:local

# Test database (docker-compose.test.yml)
DATABASE_URL=postgresql://test:test@localhost:5434/inflect_test?schema=public
DATABASE_URL_TEST=postgresql://test:test@localhost:5434/inflect_test?schema=public

# E2E test mode — enables credential login bypass
# ⚠️  NEVER set this in production!
AUTH_TEST_MODE=1

# App secrets (dummy)
AUTH_SECRET=test-auth-secret-that-is-long-enough-32chars
JWT_SECRET=test-jwt-secret-that-is-long-enough-32chars
NEXTAUTH_SECRET=test-auth-secret-that-is-long-enough-32chars
NEXTAUTH_URL=http://localhost:3006
AUTH_URL=http://localhost:3006

# OAuth stubs
GOOGLE_CLIENT_ID=test-google-id
GOOGLE_CLIENT_SECRET=test-google-secret
MICROSOFT_CLIENT_ID=test-ms-id
MICROSOFT_CLIENT_SECRET=test-ms-secret
MICROSOFT_TENANT_ID=test-ms-tenant

# File storage — explicitly pick the local-filesystem provider.
# Without this, `src/lib/storage/index.ts` defaults to `s3` and every
# evidence-upload E2E then 500s on the S3_BUCKET env validation.
STORAGE_PROVIDER=local

# The deployment's half of the agent-engine gate. On, so that
# tests/e2e/agent-engines.spec.ts can switch an isolated tenant's engine: with it
# off, the AI features page disables the choice by design. It changes nothing
# for any other tenant, because each tenant defaults to the built-in engine and
# a Flue run also needs a registered agent and a bound key.
AGENT_DRIVER_FLUE=1

# Agent profiles (Step 1b, #4144). On, so that tests/e2e/agent-behaviour.spec.ts
# can draft, submit and approve a profile in an isolated tenant: with it off the
# Behaviour tab does not exist and every profile route answers 404. Only the
# Tool Runner engine runs a profile, and only for a tenant that chose it.
AGENT_PROFILES=1

# The deployment's half of the Tool Runner engine's gate (Step 2c, #4150). On,
# so that tests/e2e/agent-profile-test-run.spec.ts can choose the engine for an
# isolated tenant and start a Test run. Each tenant defaults to the built-in
# engine, and with no ANTHROPIC_API_KEY and no worker here a started run stays
# queued: it sends nothing anywhere.
AGENT_DRIVER_TOOL_RUNNER=1
UPLOAD_DIR=./tmp/test-uploads
FILE_STORAGE_ROOT=./tmp/test-uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3006

SKIP_ENV_VALIDATION=1
NODE_ENV=test
