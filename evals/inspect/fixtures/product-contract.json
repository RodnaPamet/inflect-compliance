{
    "about": "Every product response the Inspect harness reads (evals/inspect/inflect_inspect/product.py), one sample per route, in the shape the product serves it. tests/unit/inspect-harness-product-contract.test.ts holds each route file and each field read here to the product's own types; evals/inspect/tests serves these bodies to HttpProduct over HTTP. A field the harness reads that the product does not return fails one of the two.",
    "slug": "inspect-ext-flue",
    "routes": {
        "startRun": {
            "method": "POST",
            "path": "/agent-runs",
            "route": "src/app/api/t/[tenantSlug]/agent-runs/route.ts",
            "credential": "agent-key",
            "status": 201,
            "body": { "runId": "run_1", "status": "RUNNING", "workflowKey": "ad-hoc-question", "stepFailures": 0 }
        },
        "startRunMissingInput": {
            "method": "POST",
            "path": "/agent-runs",
            "route": "src/app/api/t/[tenantSlug]/agent-runs/route.ts",
            "credential": "agent-key",
            "status": 400,
            "body": { "error": { "code": "BAD_REQUEST", "message": "Workflow ad-hoc-question requires a non-empty question. Supply it in the run input.", "requestId": "req_1" } }
        },
        "startRunUnknownWorkflow": {
            "method": "POST",
            "path": "/agent-runs",
            "route": "src/app/api/t/[tenantSlug]/agent-runs/route.ts",
