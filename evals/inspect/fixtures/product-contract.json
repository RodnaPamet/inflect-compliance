            "path": "/agent-runs/run_1/abort",
            "route": "src/app/api/t/[tenantSlug]/agent-runs/[id]/abort/route.ts",
            "credential": "session",
            "status": 200,
            "body": { "ok": true }
        },
        "listRuns": {
            "method": "GET",
            "path": "/agent-runs",
