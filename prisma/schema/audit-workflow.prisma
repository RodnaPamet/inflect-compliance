// ─────────────────────────────────────────────────────────────────
//  AUDIT WORKFLOW — the compliance-audit domain (external auditors).
//
//  Owns:
//    • Audit + AuditChecklistItem   — a fieldwork audit and its checklist
//    • AuditCycle                   — the engagement a fieldwork audit sits in
//    • AuditPack + AuditPackItem    — the evidence bundle handed to an auditor
//    • AuditPackShare + …Comment    — the share link and its comment thread
//    • AuditorAccount + AuditorPackAccess — external-auditor RBAC tier
//    • ReadinessSnapshot            — the readiness trend time-series
//    • AuditWorkpaper + …Finding    — the auditor agent's re-performance of
//                                     one procedure for one period (#3675)
//
//  THIS IS NOT THE PLATFORM AUDIT TRAIL. The hash-chained immutable
//  event log (AuditLog / OrgAuditLog) lives in `audit-trail.prisma`.
//  See that file's header for why the two were separated.
//
//  Internal "audit-of-controls" tasks live with `Control*` in the
//  controls schema — they're written and read by the compliance team,
//  not by auditors.
// ─────────────────────────────────────────────────────────────────

model Audit {
  id              String               @id @default(cuid())
  tenantId        String
  title           String
  // B8 — framework linkage. Audits now declare which compliance
  // framework they assess (ISO27001, NIS2, …). The string is the
  // Framework.key (not the FK id) so an Audit can survive a global
  // framework re-key without dangling. Nullable for legacy rows +
  // ad-hoc audits that span multiple frameworks. The Audit page
  // surfaces the linked Framework as a clickable header chip.
  frameworkKey    String?
  // feat/audit-cycle-unify — an Audit is a fieldwork phase WITHIN an
  // AuditCycle (the cycle is the spine). NULLABLE: standalone / ad-hoc
  // audits with no cycle must still work. Deleting a cycle SetNulls its
  // fieldwork audits (they survive as unattached audits, not cascade-
  // deleted). Mirrors AuditPack.cycle's single-key reference to
  // AuditCycle(id).
  auditCycleId    String?
  auditScope      String?
  criteria        String?
  schedule        DateTime?
  auditors        String?
  auditees        String?
  departments     String?
  status          AuditStatus          @default(PLANNED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  auditCycle      AuditCycle?          @relation(fields: [auditCycleId, tenantId], references: [id, tenantId])
  checklist       AuditChecklistItem[]
  findings        Finding[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, frameworkKey])
  @@index([tenantId, auditCycleId])
  @@index([tenantId, deletedAt])
}

model AuditChecklistItem {
  // denorm-tenantId — Phase 2: see EvidenceReview for the shape.
  // Composite parent FK (auditId, tenantId) → Audit(id, tenantId).
  id          String          @id @default(cuid())
  tenantId    String
  auditId     String
  prompt      String
  result      ChecklistResult @default(NOT_TESTED)
  notes       String?
  evidenceRef String?
  sortOrder   Int             @default(0)
  audit       Audit           @relation(fields: [auditId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant      Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, auditId])
}

model AuditCycle {
  id                 String              @id @default(cuid())
  tenantId           String
  frameworkKey       String
  frameworkVersion   String
  name               String
  periodStartAt      DateTime?
  periodEndAt        DateTime?
  status             AuditCycleStatus    @default(PLANNING)
  createdByUserId    String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  deletedByUserId    String?
  createdBy          User                @relation(fields: [createdByUserId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  packs              AuditPack[]
  // feat/audit-cycle-unify — fieldwork audits attached to this cycle.
  audits             Audit[]
  readinessSnapshots ReadinessSnapshot[]

  /// #2356 batch 3 — the composite an FK from a tenant-scoped child
  /// references. `id` alone is already unique; this exists so Postgres
  /// will accept ([childFk, tenantId]) -> ([id, tenantId]), which is what
  /// makes a cross-tenant reference unrepresentable rather than merely
  /// filtered.
  @@unique([id, tenantId])
  @@index([tenantId, frameworkKey, status])
  @@index([tenantId, deletedAt])
}

model AuditPack {
  id              String                  @id @default(cuid())
  tenantId        String
  auditCycleId    String
  name            String
  status          AuditPackStatus         @default(DRAFT)
  frozenAt        DateTime?
  frozenByUserId  String?
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?
  /// SP-5 — last SharePoint export of this (frozen) pack.
  spExportItemId  String?
  spExportWebUrl  String?
  spExportedAt    DateTime?
  cycle           AuditCycle              @relation(fields: [auditCycleId, tenantId], references: [id, tenantId])
  frozenBy        User?                   @relation("AuditPackFrozenBy", fields: [frozenByUserId], references: [id])
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  items           AuditPackItem[]
  shares          AuditPackShare[]
  auditorAccess   AuditorPackAccess[]
  shareComments   AuditPackShareComment[]

  @@unique([id, tenantId])
  @@index([tenantId, auditCycleId])
  @@index([tenantId, deletedAt])
}

model AuditPackItem {
  id            String                  @id @default(cuid())
  tenantId      String
  auditPackId   String
  entityType    AuditPackItemEntityType
  entityId      String
  snapshotJson  String
  sortOrder     Int                     @default(0)
  createdAt     DateTime                @default(now())
  pack          AuditPack               @relation(fields: [auditPackId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  shareComments AuditPackShareComment[]

  @@unique([auditPackId, entityType, entityId])
  /// #2356 batch 3 — the composite an FK from a tenant-scoped child
  /// references. `id` alone is already unique; this exists so Postgres
  /// will accept ([childFk, tenantId]) -> ([id, tenantId]), which is what
  /// makes a cross-tenant reference unrepresentable rather than merely
  /// filtered.
  @@unique([id, tenantId])
  @@index([tenantId, auditPackId])
}

model AuditPackShare {
  id              String                  @id @default(cuid())
  tenantId        String
  auditPackId     String
  tokenHash       String
  expiresAt       DateTime?
  createdByUserId String
  revokedAt       DateTime?
  createdAt       DateTime                @default(now())
  pack            AuditPack               @relation(fields: [auditPackId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy       User                    @relation(fields: [createdByUserId], references: [id])
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  comments        AuditPackShareComment[]

  /// #2356 batch 3 — the composite an FK from a tenant-scoped child
  /// references. `id` alone is already unique; this exists so Postgres
  /// will accept ([childFk, tenantId]) -> ([id, tenantId]), which is what
  /// makes a cross-tenant reference unrepresentable rather than merely
  /// filtered.
  @@unique([id, tenantId])
  @@index([tokenHash])
  @@index([tenantId, auditPackId])
}

// feat/auditor-return-channel — the RETURN CHANNEL that closes the
// audit-pack sharing loop. Today an external auditor opens a shared
// pack read-only via a token; this table lets them send messages BACK
// to the tenant (comment / request more evidence / raise a finding or
// question). A single table with a `kind` discriminator serves all four.
//
//   • `body` is auditor-authored FREE TEXT → encrypted at rest via the
//     Epic B manifest (`src/lib/security/encrypted-fields.ts`) and
//     sanitised on write via `sanitizePlainText`.
//   • `authorLabel` is the external auditor's self-supplied display
//     name/email captured from the share session — NOT a User FK
//     (the auditor has no platform account).
//   • `auditPackShareId` records WHICH share session produced the row.
//   • `auditPackItemId` is optional — set when the auditor comments on a
//     specific pack item rather than the pack as a whole.
//   • `status` is OPEN until a tenant user resolves an actionable row
//     (EVIDENCE_REQUEST / FINDING / QUESTION); `resolvedByUserId` is the
//     tenant user who did so.

model AuditPackShareComment {
  id               String                  @id @default(cuid())
  tenantId         String
  auditPackId      String
  auditPackShareId String
  auditPackItemId  String?
  kind             AuditShareCommentKind   @default(COMMENT)
  body             String
  authorLabel      String
  status           AuditShareCommentStatus @default(OPEN)
  createdAt        DateTime                @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  pack       AuditPack      @relation(fields: [auditPackId, tenantId], references: [id, tenantId], onDelete: Cascade)
  share      AuditPackShare @relation(fields: [auditPackShareId, tenantId], references: [id, tenantId], onDelete: Cascade)
  item       AuditPackItem? @relation(fields: [auditPackItemId, tenantId], references: [id, tenantId])
  resolvedBy User?          @relation("AuditPackShareCommentResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, auditPackId])
  @@index([auditPackId])
  @@index([auditPackShareId])
  @@index([auditPackItemId])
}

model AuditorAccount {
  id         String              @id @default(cuid())
  tenantId   String
  // GAP-21: stored encrypted at rest. Lookup uniqueness is enforced
  // on (tenantId, emailHash) — the random-IV ciphertext column
  // cannot anchor uniqueness on its own.
  // `emailHash` is nullable in TS (middleware populates) / NOT NULL
  // in DB (migration enforced). Same drift pattern as User.emailHash
  // — see that comment for rationale.
  email      String              @map("emailEncrypted")
  emailHash  String?
  name       String?             @map("nameEncrypted")
  status     AuditorStatus       @default(INVITED)
  createdAt  DateTime            @default(now())
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  packAccess AuditorPackAccess[]

  @@unique([id, tenantId])
  @@unique([tenantId, emailHash])
}

model AuditorPackAccess {
  // denorm-tenantId — Phase 2: junction with two composite parent
  // FKs. See FindingEvidence for the rationale.
  id          String         @id @default(cuid())
  tenantId    String
  auditorId   String
  auditPackId String
  grantedAt   DateTime       @default(now())
  pack        AuditPack      @relation(fields: [auditPackId, tenantId], references: [id, tenantId])
  auditor     AuditorAccount @relation(fields: [auditorId, tenantId], references: [id, tenantId])
  tenant      Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([auditorId, auditPackId])
  @@index([tenantId])
  @@index([tenantId, auditPackId])
  @@index([tenantId, auditorId])
}

/// Persisted time-series snapshot of a readiness computation
/// (Audit Coherence S5, 2026-05-22). Every `computeReadiness` call
/// writes one row so auditors can see the trend over time
/// ("readiness improved from 62% → 84% over 6 months").
///
/// Pre-this-model, readiness was a point-in-time computation only;
/// historic scores existed only inside audit packs (a heavy
/// artefact, not a chartable time series). This model gives the
/// dashboard a cheap source for the readiness-over-time chart.

model ReadinessSnapshot {
  id               String   @id @default(cuid())
  tenantId         String
  /// Which framework was scored. Free string so custom frameworks
  /// (handled by the GENERIC fallback in `audit-readiness-scoring.ts`)
  /// can persist their key here too.
  frameworkKey     String
  /// Audit cycle the snapshot was computed for. NULL when computed
  /// outside a cycle (a tenant-admin "current state" pull).
  auditCycleId     String?
  /// 0-100 weighted score (rounded to integer to match the API).
  score            Int
  /// Count of gaps at snapshot time — the trend chart's per-point tooltip.
  ///
  /// This model used to carry a `breakdownJson Json` column too, whose comment
  /// claimed "Read-side joins this for the trend chart's tooltips". No such
  /// reader ever existed: both read paths (`getReadinessHistory` and
  /// `listNis2ReadinessSnapshots`) use an explicit `select` that omitted it.
  /// Meanwhile two engines wrote it in INCOMPATIBLE shapes — the ISO/generic
  /// scorer wrote a full ReadinessBreakdown, the NIS2 scorer wrote
  /// `{ byDomain, fineExposureGaps }` — with no discriminator but
  /// `frameworkKey`, so nothing could have read it safely anyway. It was the
  /// heaviest column on the model, written on every score change. Dropped
  /// 2026-08-10; `score` + `gapCount` are what the tooltip actually shows.
  gapCount         Int      @default(0)
  computedAt       DateTime @default(now())
  /// Caller — NULL for cron-driven sweeps (none today; reserved).
  computedByUserId String?

  /// NoAction on delete: 20260524130000_audit_s5_readiness_snapshot_and_weights
  /// wrote `ON DELETE NO ACTION ON UPDATE CASCADE` explicitly. With zero
  /// deferrable FKs in this DB, NO ACTION and RESTRICT reject the same deletes
  /// at the same instant, so this is reality declared, not a policy change.
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  auditCycle AuditCycle? @relation(fields: [auditCycleId, tenantId], references: [id, tenantId])

  @@index([tenantId])
  @@index([tenantId, frameworkKey, computedAt])
  @@index([tenantId, auditCycleId])
}

// ─────────────────────────────────────────────────────────────────
// Step 3a (#3674) — agent recertification: the reviewer pack, the
// narrowings it proposes, and the retrospective sample of decisions.
//
// An AGENT access review reuses `AccessReview` and
// `AccessReviewConnectedDecision` (one row per registered agent, as
// LEGACY_APP reuses them). What the campaign adds is evidence about each
// agent and the narrowing that evidence supports, and both are records an
// auditor relies on: every model below is a REGULATORY ARTEFACT, kept with
// its campaign and retained by the tenant purge. None of them carries a
// foreign key to `RegisteredAgent`, which the purge deletes — the agent id
// is stored as a plain string, frozen, like `ExternalWriteJournal.agentId`.
//
// Every one is a ONE-WAY record, held by triggers in the migration, not by
// the usecase alone: a pack is never edited after it is written; a
// narrowing's outcome leaves PENDING once and its grant delete is stamped
// once; a sample's outcome leaves PENDING once.
// ─────────────────────────────────────────────────────────────────

/// The reviewer pack for one agent in one AGENT campaign.
///
/// Assembled by the `agent-recertification-pack` workflow, which uses read
/// tools only, from stored rows only: grants, observed use, proposals, card
/// versions, time-bounded grants, guard flags, breaker trips, kill
/// engagements and the harness level. Written once, by
/// `prepareAgentReviewPacks`, and never updated (trigger).
model AccessReviewAgentPack {
  id                      String   @id @default(cuid())
  tenantId                String
  accessReviewId          String
  decisionId              String
  /// The registered agent described. No FK — see the header.
  agentId                 String
  /// The workflow run whose READ step produced the sections. No FK: a run is
  /// operational and may be pruned; the pack is the record that outlives it.
  preparedByRunId         String
  /// The registered agent whose run prepared it — the campaign's preparer,
  /// or for the preparer's own pack its cross-preparer — or NULL when a
  /// person prepared the preparer's own pack on the static path. A CHECK
  /// refuses it equal to `agentId`: no agent prepares the pack it is reviewed
  /// by.
  preparedByAgentId       String?
  /// How the pack was prepared: `AGENT_RUN` (a registered agent's run) or
  /// `PERSON_STATIC_SELF_PACK` (the preparer's own pack, prepared by a person
  /// on the static path because the campaign names no cross-preparer). A
  /// CHECK pairs it with `preparedByAgentId`.
  preparationBasis        String
  /// The campaign's preparer, bound to `AccessReview.preparerAgentId` by FK,
  /// so a CHECK can hold the one exception: a pack no agent prepared must be
  /// the preparer's own.
  campaignPreparerAgentId String
  /// Who STARTED the preparation; the run is the agent's, or (for a
  /// `PERSON_STATIC_SELF_PACK`) this person's. No FK, matching
  /// `grantedByUserId`: the record must survive the account.
  preparedByUserId        String
  /// The observation window: the 90 days before the campaign froze its
  /// population. `windowEnd` is `AccessReview.createdAt`, so every page of
  /// one campaign reads the same window.
  windowStart             DateTime
  windowEnd               DateTime
  /// The pack sections, exactly as the read tool returned them.
  sectionsJson            Json
  /// `sha256:<hex>` over the canonical JSON of `sectionsJson`. Enters the
  /// campaign's closing evidence, which is how the evidence hash covers the
  /// packs without inlining them.
  contentHash             String
  preparedAt              DateTime @default(now())

  tenant           Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accessReview     AccessReview                  @relation("AgentPackCampaign", fields: [accessReviewId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// RESTRICT on update: a campaign's preparer cannot move once a pack names it.
  preparerCampaign AccessReview                  @relation("AgentPackCampaignPreparer", fields: [accessReviewId, campaignPreparerAgentId], references: [id, preparerAgentId], onDelete: Cascade, onUpdate: Restrict)
  decision         AccessReviewConnectedDecision @relation(fields: [decisionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  narrowings       AccessReviewAgentNarrowing[]

  /// One pack per subject, ever — preparation is one-shot. Composite because
  /// Prisma types a composite relation as 1:1 only over its exact field list;
  /// a decision id is globally unique, so this is the same invariant.
  @@unique([decisionId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, accessReviewId])
  @@index([tenantId, campaignPreparerAgentId])
}

/// One narrowing a pack proposed: delete a grant the agent did not use.
///
/// The ONLY change a campaign can make to an agent's authority, and it only
/// narrows: accepting it deletes the one `RegisteredAgentTool` row it names
/// (by id AND tool name, so a grant re-issued after the pack is not the one
/// deleted); rejecting it changes nothing. No campaign path adds a grant or
/// raises a card.
model AccessReviewAgentNarrowing {
  id                 String                @id @default(cuid())
  tenantId           String
  accessReviewId     String
  decisionId         String
  packId             String
  /// No FK — see the header.
  agentId            String
  /// The grant the narrowing deletes. No FK: accepting it deletes the row.
  grantId            String
  toolName           String
  grantedByUserId    String
  grantedAt          DateTime
  /// Why it was proposed. `NO_RECORDED_CALL_IN_WINDOW` is the one basis: the
  /// grant was held for the whole window and no behaviour window recorded a
  /// call to it.
  basis              String
  /// The agent's owner when the campaign froze it. A CHECK refuses a
  /// `decidedByUserId` equal to it.
  subjectOwnerUserId String
  outcome            AgentNarrowingOutcome @default(PENDING)
  decidedAt          DateTime?
  decidedByUserId    String?
  /// Set once, when an ACCEPTED narrowing's grant delete ran.
  executedAt         DateTime?
  /// `GRANT_DELETED`, or `GRANT_ALREADY_ABSENT` when the grant was gone (or
  /// re-issued under a new id) before the narrowing was accepted.
  executionResult    String?
  createdAt          DateTime              @default(now())

  tenant       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accessReview AccessReview                  @relation(fields: [accessReviewId, tenantId], references: [id, tenantId], onDelete: Cascade)
  decision     AccessReviewConnectedDecision @relation(fields: [decisionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  pack         AccessReviewAgentPack         @relation(fields: [packId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([packId, grantId])
  @@index([tenantId, accessReviewId, outcome])
  @@index([tenantId, decisionId])
}

/// The retrospective review of one sampled decision of a closed AGENT
/// campaign, by a second human (OWASP ASI09 applied to recertification).
///
/// `AgentProposalSampleAudit` is the pattern and cannot be reused: every row
/// of it requires a proposal, and a recertification decision is not one. The
/// draw is the existing keyed sampler (`selectSample`) over the campaign's
/// decisions, made once, at close, by `closeAgentAccessReview` — the only
/// writer. No free-text column: dissent is stable codes.
model AccessReviewDecisionSampleAudit {
  id               String                  @id @default(cuid())
  tenantId         String
  accessReviewId   String
  decisionId       String
  /// `<accessReviewId>@<YYYY-MM-DD>` — the draw re-derives from the epoch,
  /// the per-tenant seed and the decision ids. The seed is never stored.
  samplingEpoch    String
  sampledAt        DateTime                @default(now())
  /// Who was asked. NULL: the draw names nobody, and an answer is refused
  /// from the decider and from the agent's owner.
  assignedToUserId String?
  outcome          AgentSampleAuditOutcome @default(PENDING)
  dissentCodes     String[]                @default([])
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  tenant       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accessReview AccessReview                  @relation(fields: [accessReviewId, tenantId], references: [id, tenantId], onDelete: Cascade)
  decision     AccessReviewConnectedDecision @relation(fields: [decisionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One sample per decision, ever — the draw's idempotency key.
  @@unique([tenantId, decisionId])
  @@index([tenantId, accessReviewId])
  @@index([tenantId, outcome, sampledAt])
}

/// Step 3b (#3675) — ONE AUDIT WORKPAPER: the auditor agent's re-performance of
/// one audit procedure for one period, as `docs/agentic-audit-procedures.md`
/// ("What a workpaper records") defines it. Step 3c's handlers write these;
/// step 3d samples them; step 4d hands them to the external auditor.
///
/// ## A one-way record
///
/// Every column is fixed at insert. The ONLY later write is the review stamp —
/// `reviewedAt` + `reviewedByUserId`, set together, once, NULL to a value — and
/// the trigger `audit_workpaper_one_way` refuses every other UPDATE from every
/// role, including the table owner. `app_user` holds no DELETE: a workpaper
/// leaves only with its tenant. An audit relies on it, so nothing prunes it by
/// age (Regulatory artefact, `docs/data-retention.md`).
///
/// ## Codes, identifiers and counts — never prose
///
/// The catalogue binds every fact on a workpaper to a code, an identifier or a
/// count: no names, no e-mail addresses, no tool arguments, no proposal
/// payloads. So the CONCLUSION is `TestResult` plus a basis code pinned by a
/// CHECK, and there is no free-text conclusion column to encrypt — that is the
/// encryption decision (`src/lib/security/encrypted-fields.ts` records it). The
/// one text column, `populationDefinition`, is the catalogue's own definition,
/// bounded and sanitised at the write seam.
///
/// ## The first sample is binding
///
/// The first workpaper that draws a sample for a (procedure, period) fixes it;
/// a later run reuses that sample, and the trigger
/// `audit_workpaper_insert_guard` refuses a different one. So a re-run cannot
/// look for a more favourable sample.
///
/// ## Findings
///
/// Linked through `AuditWorkpaperFinding`, insert-only. No workpaper path
/// writes a finding's status: a workpaper links findings and never closes one.
model AuditWorkpaper {
  id       String @id @default(cuid())
  tenantId String

  /// The catalogue's stable procedure id (`iam.leaver_timeliness`, …) and the
  /// catalogue version it was run under. A procedure id is never renamed and
  /// never reused, so the pair names the definition for good.
  procedureId      String
  catalogueVersion Int

  /// `YYYY-MM` or `YYYY-Qn`, UTC, CHECK-pinned. No start/end columns: the label
  /// is the period, and a second encoding of it could disagree.
  periodLabel String

  /// The population as the catalogue defines it, its frozen count, and the
  /// SHA-256 over the procedure id, the period label and the sorted unit ids.
  populationDefinition String
  populationCount      Int
  populationDigest     String

  /// The sample — all NULL/empty when a precondition stopped the run before
  /// one was drawn, all set otherwise (a CHECK). `sampleEpoch` is
  /// `<procedureId>@<periodLabel>`; `seedFingerprint` tells a verifier whether
  /// the seed they hold drew it, and is not the seed.
  sampleEpoch     String?
  seedFingerprint String?
  sampleSize      Int?
  sampledUnitIds  String[] @default([])

  /// The parameters the second line set (`leaverWindowHours`, …), as codes and
  /// numbers.
  parametersJson   Json?
  /// The attribute ids tested (`L1`, `L2`, …).
  attributesTested String[] @default([])
  /// One `{ unitId, outcome, code }` per sampled unit.
  itemOutcomesJson Json
  /// One `{ unitId, code }` per exception; `exceptionCount` is its length (a
  /// CHECK).
  exceptionsJson   Json
  exceptionCount   Int

  /// PASS, FAIL or INCONCLUSIVE, and the basis code. A PASS needs a non-empty
  /// population, a drawn sample and no exception; a FAIL needs an exception
  /// (CHECKs): an empty population can never pass.
  conclusion      TestResult
  conclusionBasis String

  /// Evidence ids and finding-proposal (`AgentProposal`) ids the run produced.
  /// Plain identifiers: evidence and proposals are soft-deleted and purged on
  /// their own schedules, and a regulatory record must not vanish with them.
  evidenceRefs String[] @default([])
  proposalIds  String[] @default([])

  /// The auditor agent that wrote it. A plain id with NO foreign key, as
  /// `AgentKillSwitch.agentId` and `AgentActionReceipt.agentId` are: the tenant
  /// purge keeps this Regulatory artefact and deletes the register, so a
  /// foreign key would either fail every purge (NO ACTION) or take the
  /// workpaper with the agent (CASCADE). The insert trigger refuses an id that
  /// is not an auditor agent of the same tenant, so it is tenant-bound and
  /// true when written. Never moved: unmarking an auditor does not
  /// re-attribute its workpapers.
  auditorAgentId   String
  /// The control-test run that produced it. A plain id, no FK: runs are
  /// hard-purged with their soft-deleted test plan, and the workpaper outlives
  /// them.
  controlTestRunId String

  /// THE ONE-WAY REVIEW STAMP. Set together, once (CHECK + trigger). The
  /// reviewer is a plain user id with no FK, as `AgentProposalApproval`'s
  /// signer is: the signature must survive the account's deletion.
  reviewedAt       DateTime?
  reviewedByUserId String?

  createdAt DateTime @default(now())

  // No `updatedAt`: the row is append-only apart from the stamp.

  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  findingLinks  AuditWorkpaperFinding[]
  /// Internal audit's re-performance of this workpaper, when it was drawn
  /// (3d). At most one: `@@unique([tenantId, workpaperId])` on the review.
  sampleReviews AuditWorkpaperSampleReview[]
  /// The auditor agent's narrative of this workpaper (#3749). At most one:
  /// `@@unique([tenantId, workpaperId])` on the narrative.
  narratives    AuditWorkpaperNarrative[]

  @@unique([id, tenantId])
  @@index([tenantId, procedureId, periodLabel])
  @@index([tenantId, auditorAgentId])
  @@index([tenantId, createdAt])
}

/// A finding a workpaper links (#3675). INSERT-ONLY: `app_user` holds neither
/// UPDATE nor DELETE, and a trigger refuses an UPDATE from any role. A link is
/// a reference, never an act on the finding — nothing that writes this table
/// writes `Finding.status`.
///
/// `findingId` is a plain id with NO foreign key. This table is a Regulatory
/// artefact the tenant purge retains, and `Finding` is a Business record it
/// deletes (as does the 90-day purge of a soft-deleted finding): a CASCADE key
/// would delete the record that a workpaper raised the finding, and a NO ACTION
/// one would fail the purge. The insert trigger
/// `audit_workpaper_finding_insert_guard` refuses an id that is not a finding
/// of the same tenant, so the reference is tenant-bound and true when written.
/// The only foreign keys are to the tenant and the workpaper, which the purge
/// both retains.
model AuditWorkpaperFinding {
  id          String   @id @default(cuid())
  tenantId    String
  workpaperId String
  findingId   String
  createdAt   DateTime @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workpaper AuditWorkpaper @relation(fields: [workpaperId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([workpaperId, findingId])
  @@index([tenantId, workpaperId])
  @@index([tenantId, findingId])
}

/// Step 3d (#3677) — INTERNAL AUDIT'S RE-PERFORMANCE OF ONE SAMPLED WORKPAPER.
///
/// The auditor agent writes workpapers (3b, 3c); this is the check on the
/// auditor. A scheduled sweep (`jobs/audit-workpaper-sample-review.ts`) draws
/// workpapers with the ASI09 sampler's keyed score against the tenant's rate
/// (`TenantSecuritySettings.workpaperReviewSamplePercent`, 100 in the pilot) and
/// assigns each, by a keyed draw from the same epoch, to an ACTIVE member whose
/// line of defence is THIRD and who does not own the auditor agent. The
/// assigned reviewer answers CONCURRED, DISSENTED or INDETERMINATE, once.
///
/// `AgentProposalSampleAudit` is the pattern and cannot be reused: every row of
/// it requires a proposal, and a workpaper is not one.
///
/// ## One row per sampled workpaper, and every row has a state
///
/// `@@unique([tenantId, workpaperId])` is the sweep's durable idempotency key.
/// A row is ASSIGNED (`assignedToUserId`) or UNASSIGNED with a named reason
/// (`unassignedReason`), never neither (a CHECK): an item with nobody eligible
/// to ask is recorded, not dropped, and never handed to somebody ineligible.
/// While a row is PENDING a later sweep may re-draw its reviewer — an
/// UNASSIGNED item once somebody is eligible, or an assignee who no longer is —
/// and nothing else may change it.
///
/// ## Write-once answer, codes not prose
///
/// The answer is a one-way stamp: PENDING to an answer, once, by the assigned
/// reviewer (a CHECK pins `reviewedByUserId = assignedToUserId`), and the
/// trigger `audit_workpaper_sample_review_one_way` refuses every other UPDATE
/// from every role. Dissent is stable codes (`WORKPAPER_REVIEW_DISSENT_CODES`),
/// CHECK-pinned to the vocabulary; there is NO free-text column, which is the
/// encryption decision (`src/lib/security/encrypted-fields.ts`).
///
/// ## A dissent queues a finding proposal
///
/// `findingProposalId` names the FINDING proposal a DISSENTED review raised
/// through the ordinary queue (`createAgentProposal`). Set once, only on a
/// DISSENTED row. A plain id, no foreign key: proposals are Business records the
/// tenant purge deletes, and this row is a Regulatory artefact it keeps.
///
/// Reviewers and assignees are plain user ids with no foreign key, as
/// `AuditWorkpaper.reviewedByUserId` is: the record outlives the account.
model AuditWorkpaperSampleReview {
  id          String @id @default(cuid())
  tenantId    String
  workpaperId String

  /// `audit-workpaper-review@<periodLabel>` — fixed by the workpaper's period,
  /// never the run date. With the seed, the workpaper id and `samplePercent`
  /// the draw re-derives; the seed is never stored.
  samplingEpoch   String
  /// Which seed drew it; not the seed.
  seedFingerprint String
  /// The rate in force when it was drawn, 1..100.
  samplePercent   Int
  sampledAt       DateTime @default(now())

  /// Who was asked, or why nobody was. Exactly one of the two is set.
  assignedToUserId     String?
  unassignedReason     String?
  /// The eligible pool the reviewer was drawn from: its size and the SHA-256
  /// over its sorted user ids, so the draw re-derives.
  assignmentPoolSize   Int
  assignmentPoolDigest String
  assignedAt           DateTime @default(now())

  /// PENDING until the assigned reviewer answers — a drawn but unreviewed
  /// workpaper never reads as agreement.
  outcome          AgentSampleAuditOutcome @default(PENDING)
  dissentCodes     String[]                @default([])
  reviewedByUserId String?
  reviewedAt       DateTime?

  /// The finding proposal a DISSENTED review raised. Set once.
  findingProposalId String?

  createdAt DateTime @default(now())

  // No `updatedAt`: every later write is one of three named, trigger-checked moves.

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workpaper AuditWorkpaper @relation(fields: [workpaperId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One review per workpaper, ever — the sweep's idempotency key, and the
  /// tenant-leading construct that indexes the `workpaperId` FK.
  @@unique([tenantId, workpaperId])
  /// The reviewer's queue: this tenant, this assignee, oldest first.
  @@index([tenantId, assignedToUserId, sampledAt])
  /// The rate: this tenant, drawn inside the window.
  @@index([tenantId, sampledAt])
}

/// THE AUDITOR AGENT'S NARRATIVE OF ONE WORKPAPER (#3749): a few sentences a
/// reviewer reads beside it — what the procedure tested, what the sample
/// showed, and the conclusion the workpaper records. Drafted by an
/// `audit-narrative` run on the Flue engine, and stored only after the
/// output contract (`checkNarrativesAgainstRecord`) has held it to the
/// record: the conclusion is the workpaper's, and every code it lists or
/// cites is one the workpaper records.
///
/// WRITE-ONCE: `app_user` holds neither UPDATE nor DELETE, and a trigger
/// refuses an UPDATE from every role. One per workpaper. Model text, so
/// sanitised at its one writer (`audit-workpaper-narrative.ts`) and encrypted
/// at rest (Epic B). Kept as long as its workpaper, which the tenant purge
/// keeps.
model AuditWorkpaperNarrative {
  id          String @id @default(cuid())
  tenantId    String
  workpaperId String

  /// The run that drafted it. A plain id with no foreign key: workflow runs
  /// are purged on their own schedule, and the narrative outlives them.
  runId String

  /// The exception codes the narrative discusses, each one its workpaper
  /// records (the insert trigger checks it against `exceptionsJson`).
  exceptionCodes String[] @default([])

  /// The narrative, at most 400 characters before encryption.
  text String

  createdAt DateTime @default(now())

  // No `updatedAt`: the row never changes.

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workpaper AuditWorkpaper @relation(fields: [workpaperId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One narrative per workpaper, ever — the capture's idempotency key, and
  /// the tenant-leading construct that indexes the `workpaperId` FK.
  @@unique([tenantId, workpaperId])
}
