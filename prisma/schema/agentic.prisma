// agentic.prisma — Propose-not-commit agent queue + the durable workflow engine.
// Split from compliance.prisma (2026-07-10) — pure reorg, no datamodel change.
// Enums live in enums.prisma; relations resolve across the schema folder.

/// Epic MCP Phase 3 — the propose-not-commit queue. An external agent (via the
/// MCP server, `mcp:propose` scope) can PROPOSE a risk/control/policy/finding;
/// the proposal lands here as PENDING and a human approves it before the REAL
/// create-usecase runs. An agent never mutates a record directly. `payloadJson`
/// (the proposed content, validated + Epic-D sanitised at the propose boundary)
/// and `rationale` are encrypted at rest (Epic B — see encrypted-fields.ts).
model AgentProposal {
  id                   String               @id @default(cuid())
  tenantId             String
  kind                 AgentProposalKind
  /// CREATE (queue a new record) or UPDATE (change one that already exists).
  /// Defaulted rather than nullable: every pre-existing row is a create, and a
  /// NULL here would be a third state the diff builder would have to guess at —
  /// see `AgentProposalOperation` in enums.prisma.
  operation            AgentProposalOperation @default(CREATE)
  status               SuggestionItemStatus @default(PENDING)
  payloadJson          String
  /// The id of the record an UPDATE proposal would change. NULL for a CREATE,
  /// and a database CHECK (`AgentProposal_update_requires_target`) refuses an
  /// UPDATE row without one — an update naming no target is not a proposal a
  /// reviewer can be shown a diff for, so it must not be storable.
  ///
  /// A plain String with NO foreign key, and that is not laziness: the target
  /// is polymorphic over four tables (`kind` says which), so there is no single
  /// column to point at. The consequence is that the target can be deleted out
  /// from under a pending proposal, which the review path handles explicitly —
  /// the diff resolves to TARGET_MISSING and approval is refused. A dangling
  /// pointer that the reader is REQUIRED to check is safer here than a
  /// RESTRICT that would block deleting a risk because an agent once proposed
  /// an edit to it.
  targetEntityId       String?
  rationale            String?
  proposedViaKeyId     String?
  proposedBySessionRef String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  createdEntityId      String?
  /// Which registered agent proposed this.
  ///
  /// NULLABLE IN THE SCHEMA, REQUIRED AT THE USECASE — and the split is
  /// deliberate. The column has to be nullable for the migration that adds it:
  /// the backfill below runs in the same transaction as the ALTER, so there is a
  /// moment where existing rows have no value, and a NOT NULL column with no
  /// sensible default cannot be added to a populated table without inventing
  /// one. Making it optional in Prisma is what lets the backfill be honest
  /// rather than fabricating an agent for rows that never had one.
  ///
  /// New writes go through `agent-registry`-aware usecases, which require it.
  /// So a NULL here means "written before the register existed", and nothing
  /// else — treat it as unattributed, never as "any agent".
  agentId              String?
  /// WHICH VERSION OF THE AGENT'S POLICY CARD WAS IN FORCE when this proposal
  /// was made. Write-once: a DB trigger refuses any UPDATE that changes a value
  /// already set, because a pin that can be rewritten reconstructs today's rules
  /// wearing an old version number, which is worse evidence than none.
  ///
  /// THREE STATES, AND THEY ARE THREE DIFFERENT FACTS:
  ///   NULL — this row predates version pinning. We do not know.
  ///   0    — the card was evaluated and NO card was in force (the agent has
  ///          none, or a human/assistant made the proposal). `NO_POLICY_CARD` in
  ///          `src/lib/agentic/policy-card.ts`; 0 can never collide with a real
  ///          version, which the version table CHECKs at >= 1.
  ///   >= 1 — the version that authorized the call which produced this row.
  ///
  /// Written from the invocation that was actually authorized, not re-read
  /// afterwards: "the version that allowed this" and "the version in force a
  /// moment later" are different claims, and only the first is evidence.
  policyCardVersion    Int?

  /// ─── The agentic OUTPUT GUARD verdict (see ai/guard/proposal-guard.ts) ───
  ///
  /// Written on EVERY proposal, not only refused ones, because "the guard ran
  /// and found nothing" and "the guard never ran" are otherwise the same row.
  /// The default is CLEAN so pre-guard rows read as unscanned-but-permitted
  /// rather than as scanned-and-clean — which they were, since the queue they
  /// entered had no guard.
  guardVerdict         AgentGuardVerdict    @default(CLEAN)
  /// The stable rule ids that fired. Ids ONLY — never the matched text, so this
  /// column can be read by an operator surface without leaking the payload.
  guardRuleIds         String[]
  /// `sha256:<hex>` over (kind, payload, rationale). The join key that proves
  /// "the same content was guarded" without persisting the content. Same
  /// construction as `AiDecisionLog.inputDigest`.
  guardInputDigest     String?
  /// The trust label the guarded content carried. Defaults to the untrusted
  /// value: an agent proposal is third-party content by construction, and a row
  /// that somehow arrives without a label must not read as tenant-authored.
  guardProvenance      AgentContentProvenance @default(THIRD_PARTY_INGESTED)

  /// HOW MANY DISTINCT HUMANS must approve this proposal — resolved ONCE, at
  /// the propose seam, by `resolveApprovalRequirement` in
  /// `src/lib/agentic/approval-tiering.ts`, and never recomputed.
  ///
  /// PINNED for the same reason `policyCardVersion` above is pinned: the
  /// requirement is composed from the card version in force, the agent's scored
  /// tier and its registered autonomy, and all three can move between the
  /// proposal and the review. "What was required when this was proposed" is the
  /// question an incident review asks; "what would be required if it were
  /// proposed now" is a different one, and only the first is evidence.
  ///
  /// It is also what makes the four-eyes rule enforceable IN THE DATABASE: the
  /// trigger on `AgentProposalApproval` reads this integer instead of
  /// re-deriving the ladder in plpgsql. A second copy of that composition, in
  /// another language, is the four-verbatim-copies failure this subsystem
  /// already paid for once.
  ///
  /// NULLABLE because the column is added to a populated table. NULL means the
  /// requirement was never computed, and it reads as
  /// `UNKNOWN_REQUIREMENT_APPROVALS` (2) at EVERY consumer including the
  /// trigger — an uncomputed requirement must not be the cheapest one.
  requiredApprovals    Int?
  /// WHEN THE REVIEW WINDOW CLOSES. Past this instant the proposal cannot be
  /// approved, and the `agent-proposal-expiry` sweep moves it to `EXPIRED`.
  ///
  /// Queue depth is a driver of rubber-stamping, so an unbounded queue is part
  /// of the ASI09 threat model rather than a housekeeping matter — the deadline
  /// is the bound. `src/lib/agentic/proposal-expiry.ts` owns the arithmetic and
  /// the reasoning, including why the clock does NOT restart when a first
  /// approver signs a proposal whose card requires a second.
  ///
  /// PINNED AT CREATION, not derived at read time, for the same reason
  /// `policyCardVersion` is pinned: the window's LENGTH comes from the approval
  /// rung of the card version in force, and a card edit must not silently move
  /// the deadline of a proposal already in flight — in either direction.
  ///
  /// NULLABLE, and NULL means NO DEADLINE RECORDED rather than "expired". The
  /// column was added to a populated table, and during a rolling deploy a
  /// container running the previous build writes rows without it. Reading the
  /// absence as "window closed" would retire every in-flight proposal at the
  /// moment of deploy — an outage wearing the costume of a control. The sweep
  /// stamps a deadline onto those rows instead.
  expiresAt            DateTime?

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent                RegisteredAgent?     @relation(fields: [agentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  approvals            AgentProposalApproval[]

  /// Composite parent key, so an approval can never point cross-tenant. Same
  /// shape `AgentPolicyCard` carries for its versions.
  sampleAudits         AgentProposalSampleAudit[]

  /// Composite parent key, so a sample-audit row can never point at another
  /// tenant's proposal — the same shape `AgentPolicyCard` carries for its
  /// versions.
  @@unique([id, tenantId])
  /// Two reads, one index. The reviewer's queue filters (tenantId, status IN
  /// reviewable) and the QUARANTINE TRIAGE listing filters (tenantId, status =
  /// QUARANTINED); both sort by createdAt desc and both are bounded.
  ///
  /// The triage surface got NO INDEX OF ITS OWN, deliberately. The obvious one
  /// to reach for is `[tenantId, guardVerdict, createdAt]` — `guardVerdict` is
  /// the column a reader assumes a "quarantine" page filters on, and nothing
  /// covers it. But the query the surface actually issues filters on `status`,
  /// not on `guardVerdict` (and does not even render it: on a
  /// status='QUARANTINED' population the verdict is a constant), and this
  /// composite already covers that query exactly — two equality columns then
  /// the sort column. Measured on 200k rows over 20 tenants with QUARANTINED at
  /// 0.5%, adding the guardVerdict composite left the plan unchanged — the
  /// planner kept using this index and never touched the new one. It would have
  /// been a second B-tree on a table written once per agent proposal, paid for
  /// on every insert, to serve nothing. Same reasoning
  /// `AgentProposalSampleAudit` records for the FK index it does not carry.
  ///
  /// The query that WOULD justify a `guardVerdict` index is real, and it is
  /// deliberately NOT written here. `guardAgentProposal` returns FLAGGED when a
  /// rule fired but nothing was malicious, and `createAgentProposal` writes
  /// those rows `status = 'PENDING'` — so "FLAGGED but queued anyway" is a
  /// population, not a hypothetical. Those rows are not invisible: the
  /// reviewer's queue at /t/:slug/agent-proposals lists status PENDING and
  /// therefore lists them. What is invisible is the SIGNAL — that page's
  /// projection forwards no guard column at all, so a reviewer approves a
  /// guard-flagged proposal without being told the guard fired.
  ///
  /// Closing that is a change to the REVIEWER'S QUEUE, not a second population
  /// on the quarantine page: a FLAGGED row is approvable and the quarantine
  /// page has no approve control by design. Whoever writes that query picks the
  /// index in the same diff — the column order follows the filter they write,
  /// so do not pre-commit to one here.
  @@index([tenantId, status, createdAt])
  @@index([tenantId, agentId])
  /// The expiry sweep's query, and the ONE index here that is deliberately not
  /// tenant-leading: the sweep runs system-wide over every tenant at once
  /// (`status = PENDING AND expiresAt <= now`), so a tenantId-leading composite
  /// would be a prefix it never supplies. The tenant-leading index above still
  /// exists and still serves every per-tenant read.
  @@index([status, expiresAt])
}

/// OWASP ASI09 — the RETROSPECTIVE SAMPLE AUDIT of an approved proposal.
///
/// The propose-not-commit queue's safety claim is that a human approved every
/// agent-authored write. Every signal the product emits about that queue
/// measures its SHAPE — counts, latency, who clicked. None of them measures
/// whether the approvals were RIGHT, and a queue rubber-stamped under volume is
/// worse than no queue at all: it manufactures an auditable record of consent
/// nobody actually gave, while every shape metric stays green.
///
/// This table is the only instrument that sees that. A sweep periodically draws
/// a keyed random sample of ALREADY-APPROVED proposals and asks a second human
/// whether they would have approved it too. The rate at which they would not is
/// the number the whole subsystem is judged on.
///
/// One row per sampled proposal, ever — `@@unique([tenantId, proposalId])` is
/// the durable idempotency key `schedules.ts` demands of any job that must not
/// double-fire, and it also means a proposal cannot be re-drawn until somebody
/// disagrees with the first answer.
///
/// NO FREE-TEXT COLUMN, deliberately. The subject under review is agent-
/// authored content that lives in an ENCRYPTED column; a note field is the
/// obvious place to quote it, and a quote in a plaintext operator surface is
/// that content leaving the store it was put in. Dissent is recorded as stable
/// CODES (`SAMPLE_AUDIT_DISSENT_CODES`), which carry no content and — unlike
/// prose — aggregate into "which KIND of wrong", the question that actually
/// changes an agent's policy card.
model AgentProposalSampleAudit {
  id       String @id @default(cuid())
  tenantId String

  /// The approved proposal under retrospective review.
  proposalId String

  /// When the sampler drew it, and under which epoch.
  sampledAt     DateTime @default(now())
  /// The sampling run's epoch — the UTC calendar day of the sweep. Stored so a
  /// selection can be RE-DERIVED and checked later: with the epoch, the seed
  /// and the candidate set, `selectSample` is deterministic. The seed itself is
  /// never stored and never rendered; without it the epoch reveals nothing.
  samplingEpoch String

  /// Who was asked. NULLABLE: the sweep records the agent's registered owner
  /// where there is one, and leaves it null otherwise rather than inventing an
  /// assignee. Whoever actually answers is recorded separately below, because
  /// "who was asked" and "who replied" are different facts and only the second
  /// one is evidence.
  assignedToUserId String?

  /// The verdict. Defaults to PENDING — a drawn-but-unreviewed row must never
  /// read as agreement, or the disagreement rate would improve every time the
  /// sampler ran and nobody did the work.
  outcome AgentSampleAuditOutcome @default(PENDING)

  /// Why the reviewer did not concur, as stable codes from
  /// `SAMPLE_AUDIT_DISSENT_CODES`. Empty on every non-DISSENTED outcome.
  dissentCodes String[]

  reviewedByUserId String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposal AgentProposal @relation(fields: [proposalId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One audit per proposal — the sweep's durable idempotency key, AND the
  /// tenant-leading uniqueness construct that indexes the `proposalId` FK as
  /// its second column. No separate `@@index([tenantId, proposalId])`: it would
  /// be the same b-tree twice, i.e. write amplification on every audit row.
  @@unique([tenantId, proposalId])
  /// The reviewer's queue: open audits for this tenant, oldest first.
  @@index([tenantId, outcome, sampledAt])
}

/// Tenant-scoped: ONE HUMAN'S SIGNATURE on one agent proposal.
///
/// The propose-not-commit queue's whole safety claim is "a human approved it".
/// Until this table there was no record of WHO, only a `reviewedByUserId` on the
/// proposal that the next writer overwrote — so "two people signed" was not a
/// question the database could answer, and therefore not one the product could
/// enforce.
///
/// ## The four-eyes rule lives HERE, not in the usecase
///
/// A usecase that counts approvals and then writes one is a read-then-write, and
/// two concurrent requests both read "one so far" and both write the second. So
/// both halves of the rule are constraints on this table:
///
///   • THE SECOND APPROVER CANNOT BE THE FIRST — `@@unique([tenantId,
///     proposalId, approverUserId])`. One row per human per proposal, arbitrated
///     by the index, with no window between the read and the write. This is the
///     classic four-eyes bypass and the unique index is the only place it can be
///     closed without one.
///   • THE APPROVERS CANNOT INCLUDE THE AGENT'S REGISTERED OWNER, whenever the
///     proposal needs two — a `BEFORE INSERT OR UPDATE` trigger joining through
///     `AgentProposal.agentId` to `RegisteredAgent.ownerUserId`. A CHECK
///     constraint cannot read another table; a trigger can, and it needs no
///     count, so it too has no window.
///
/// ## `outcome` is a ONE-WAY stamp, and the row is otherwise frozen
///
/// Mirrors `AiDecisionLog` exactly: a trigger refuses any UPDATE that changes
/// any other column, and refuses to move `outcome` once it has left `PENDING`.
/// An approval that can be edited afterwards is not evidence — it is a claim
/// about the past that the present can rewrite (EU AI Act Art 14).
///
/// The `PENDING` default is load-bearing rather than decorative: ONLY a terminal
/// approving outcome counts toward the requirement, so a row written by anything
/// that forgot to state an outcome grants nothing. `AiHumanOutcome` is reused
/// rather than a new enum minted — PENDING / ACCEPTED / EDITED / REJECTED is the
/// same Art 14 human-oversight vocabulary, it already exists, and a new Postgres
/// enum type is one more `ALTER TYPE` hazard in a rolling deploy for no new
/// meaning.
model AgentProposalApproval {
  id         String @id @default(cuid())
  tenantId   String
  proposalId String

  /// The human who signed. A plain String with NO foreign key, matching
  /// `RegisteredAgentTool.grantedByUserId`: the signature must survive the
  /// signer's account being deleted, and a `RESTRICT` FK would block that
  /// deletion while a `SET NULL` one would erase the accountability the row
  /// exists for.
  approverUserId String

  /// PENDING until stamped, then terminal forever. Only `ACCEPTED` and `EDITED`
  /// count toward the requirement.
  outcome AiHumanOutcome @default(PENDING)

  /// The requirement in force when this signature was recorded, copied from the
  /// proposal's pin. Denormalised deliberately: a signature that cannot say what
  /// it was signing up to is not self-describing evidence, and the proposal's
  /// own pin is write-once but sits on a table with a dozen other columns.
  requiredApprovals Int

  createdAt DateTime @default(now())

  /// No `updatedAt`. The row is append-only apart from the one-way stamp, and a
  /// column promising to record an update on a table that refuses them is a
  /// promise the table does not make.

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposal AgentProposal @relation(fields: [proposalId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// ONE signature per human per proposal. The four-eyes constraint itself.
  @@unique([tenantId, proposalId, approverUserId])
  @@index([tenantId, proposalId])
}

/// Epic Agentic 1A — a durable, audited, human-gated agentic workflow run. The
/// engine composes the existing MCP read/propose tools under this run model; it
/// adds orchestration + checkpoints, NOT new authority. Every write a workflow
/// makes routes through the propose-not-commit approval queue (AgentProposal) —
/// the engine can commit nothing a single MCP tool couldn't. `contextJson`
/// (accumulated state) and `summary` (the output artifact) are encrypted at rest
/// (Epic B — see encrypted-fields.ts).
model WorkflowRun {
  id                String            @id @default(cuid())
  tenantId          String
  workflowKey       String
  status            WorkflowRunStatus @default(RUNNING)
  startedByUserId   String?
  triggeredViaKeyId String?
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  contextJson       String?
  /// Chain head over `contextJson` — the SHA-256 link computed by
  /// `sealContext` in `src/lib/agentic/context-integrity.ts` (OWASP ASI06).
  ///
  /// A COLUMN rather than a field inside the envelope, and that is the whole
  /// point: `contextJson` is encrypted at rest, which protects confidentiality
  /// and says nothing about whether the blob is the one the previous step
  /// wrote. A head stored inside the blob it protects could be recomputed by
  /// whoever rewrote the blob. `AuditLog.entryHash` is a column for the same
  /// reason.
  ///
  /// NOT in the Epic B encryption manifest, deliberately: it is a digest, it
  /// carries no content, and it is compared for equality on every step — an
  /// encrypted column would compare ciphertext.
  ///
  /// NULLABLE because the column was added to a populated table. NULL means
  /// UNSEALED, and unsealed FAILS CLOSED: the run halts with
  /// `CONTEXT_UNSEALED` at its next step rather than adopting a blob nobody
  /// sealed. Any run in flight across the deploy that adds this column is
  /// therefore halted, on purpose — trust-on-first-use here would let anyone
  /// who can clear the head bypass the chain entirely.
  contextHash       String?
  summary           String?
  stepCount         Int               @default(0)
  costTokens        Int               @default(0)
  errorMessage      String?
  /// Which registered agent this run belongs to. Same nullable-in-schema,
  /// required-at-the-usecase split as `AgentProposal.agentId` above, and for the
  /// same reason: the column is added to a populated table in the migration that
  /// backfills it, so it cannot be NOT NULL at ALTER time. A NULL means
  /// "pre-register", not "any agent".
  agentId           String?
  /// WHICH VERSION OF THE AGENT'S POLICY CARD WAS IN FORCE when this run was
  /// admitted. Same three states and the same write-once trigger as
  /// `AgentProposal.policyCardVersion` above — see that comment.
  ///
  /// It is the version at the run's START, and that is a deliberate narrowing
  /// rather than the whole story: a run re-resolves its invocation after every
  /// human checkpoint, so a run spanning a card edit is authorized under the
  /// NEWER card for its later segments. Each individual call's audit row
  /// (`MCP_TOOL_INVOKED` / `AUTHZ_DENIED`) carries the version that decided it.
  /// This column answers "what did this run open under", which is the question
  /// that stops being answerable once the card has moved on.
  policyCardVersion Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent             RegisteredAgent?  @relation(fields: [agentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  steps             WorkflowStep[]

  @@index([tenantId, status, startedAt])
  @@index([tenantId, agentId])
}

/// An append-only record of one workflow step — the run's audit narrative.
model WorkflowStep {
  id          String             @id @default(cuid())
  runId       String
  tenantId    String
  seq         Int
  /// The CONTEXT-CHAIN position in force when this step was recorded.
  ///
  /// The replay anchor, and it lives HERE rather than on `WorkflowRun` for one
  /// reason: restoring an earlier `(contextJson, contextHash)` pair onto the run
  /// row rolls the run's memory back, and the chain verifies, because the link
  /// is recomputed from the very envelope being replayed. This ledger is
  /// append-only and a different table, so the same restore does not move it —
  /// which is what lets the next step notice that the memory went backwards.
  ///
  /// Nullable: added to a populated table, and a step recorded before this
  /// column existed genuinely does not know its position.
  contextSeq  Int?
  kind        WorkflowStepKind
  toolCalled  String?
  inputJson   String?
  outputJson  String?
  status      WorkflowStepStatus @default(PENDING)
  at          DateTime           @default(now())
  actorUserId String?
  run         WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, seq])
  @@index([tenantId, runId])
}

/// Epic Agentic — the agent REGISTER: one row per autonomous agent a tenant
/// runs, with the four properties that decide how much authority it may hold.
///
/// ## Why a sibling of AiSystem rather than a discriminator on it
///
/// `AiSystem` is the EU AI Act register (Regulation (EU) 2024/1689). Every one
/// of its columns is Act vocabulary — `riskTier` is the Act's tier,
/// `classificationClauseId` is the clause that produced it, `deploymentRole` is
/// provider-vs-deployer. An agent's governing questions (how autonomous, how far
/// into tenant data, how reversible, whose code) are not Act questions and do
/// not fit those columns. Three specifics settled it:
///
///   • `ownerUserId`. On a shared table it could only be a partial CHECK
///     (required for agent rows, optional for the rest), so Prisma would type it
///     `string | null` forever — and every "the approver must not be the owner"
///     check downstream would then read `owner && owner === ctx.userId`, which
///     passes when the owner is unknown. Here it is `String` with a real FK and
///     the null is unrepresentable.
///   • House precedent: discriminators sit on OPERATIONAL tables (`Asset.type`,
///     `Task.type`); principals get their own table (`AuditorAccount`,
///     `TenantDeviceToken`). An agent is a principal with a kill switch, and a
///     kill switch on a row in a regulatory register is a category error.
///   • `POST /api/t/:slug/ai-systems` carries no `requirePermission` (only
///     `assertCanWrite`), so extending that table would have made a surface any
///     write-capable member can insert into the authorization subject for tool
///     exposure.
///
/// ## Why the link to AiSystem is REQUIRED
///
/// Every agent IS an AI system in the Act's sense, so the register must contain
/// it: that keeps `ai-system-conformity`'s `riskTier === 'HIGH'` path reachable
/// for agents and gives per-agent framework coverage somewhere to hang
/// (`AiSystemRequirementLink`). `onDelete: Restrict` because deleting the AI
/// system must not silently delete the agent that governs it — the delete has to
/// be refused and the operator has to retire the agent explicitly.
///
/// OPEN: whether an agent must be registrable WITHOUT an EU AI Act
/// classification. If it must, this link becomes optional and the model degrades
/// to a plain sibling. Built NOT NULL because relaxing later is cheap (there are
/// zero production rows) and tightening later is not.
model RegisteredAgent {
  id       String @id @default(cuid())
  tenantId String

  /// REQUIRED 1:1 to the EU AI Act register entry that covers this agent.
  /// Composite FK to (id, tenantId) so an agent can never point at another
  /// tenant's system, matching AiSystemRequirementLink.
  aiSystemId String

  name String

  /// Free-text — what the agent does and what it is allowed to touch, in the
  /// operator's words. ENCRYPTED at rest (Epic B manifest) and sanitised on
  /// write (`sanitizePlainText`); it is read back by an operator surface and by
  /// the agent-registry export, so the sanitising happens at the write seam.
  description String?

  /// 0-6 on the agent-autonomy ladder (0 = suggests only, 6 = acts unattended
  /// across systems). An Int, and NEVER a boolean: the whole point of the
  /// register is that "autonomous" is a spectrum, and a two-state column would
  /// force the scorer to collapse four distinct rungs into one. A CHECK
  /// constraint in the migration pins the range — the enum-shaped alternative
  /// was rejected because the scorer does arithmetic on this value.
  autonomyLevel Int

  /// The three exposure axes. NONE of them carries a Prisma default, on
  /// purpose: the least-exposing value is also the lowest-scoring one, so a
  /// default here would silently UNDER-state risk for any writer that forgot the
  /// field. An omitted axis must fail, not score zero.
  dataAccessScope AgentDataAccessScope
  reversibility   AgentReversibility
  provenance      AgentProvenance

  status AgentStatus @default(DRAFT)

  /// The underlying model this agent runs on, as the operator declares it
  /// (e.g. a model id, or an internal build tag). Free-form and NULLABLE: the
  /// platform cannot observe it, so a value here is a declaration, and an
  /// invented default would be a declaration nobody made.
  ///
  /// It exists so "the underlying model changed" is a COMPARISON rather than a
  /// notion — it is one of the agent-risk-assessment staleness triggers, and a
  /// trigger with nothing to compare against never fires. NULL on both sides
  /// (never declared, still not declared) is NOT a change.
  modelRef String?

  /// The scored operational tier, and when it was scored.
  ///
  /// NULL means UNSCORED — the state between insert and the first scoring run.
  /// Every consumer must treat NULL as "deny", never as a low tier: an agent
  /// nobody has assessed is the one that should not be running. The two columns
  /// move together (a CHECK constraint pins `riskTier IS NULL` ⇔
  /// `riskTierScoredAt IS NULL`), so a tier can never be read without knowing
  /// how stale it is.
  riskTier         AgentRiskTier?
  riskTierScoredAt DateTime?

  /// The accountable human. NOT NULL with a real FK — see the header. Used by
  /// the two-person rule downstream, which needs a value it can compare rather
  /// than a maybe-null it has to guess about.
  ownerUserId String

  /// The supplier, for THIRD_PARTY agents. A CHECK constraint in the migration
  /// refuses `provenance = 'THIRD_PARTY'` with no vendor — third-party risk you
  /// cannot attribute to a named supplier is not third-party risk, it is an
  /// unattributed binary.
  vendorId String?

  /// TRUE only for the synthetic row the agent-registry migration creates to
  /// adopt pre-registry AgentProposal / WorkflowRun rows. It lands SUSPENDED and
  /// is never a real agent — surfaces that count or score agents should exclude
  /// it, and an operator's job is to replace it with real registrations.
  isLegacyPlaceholder Boolean @default(false)

  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiSystem  AiSystem        @relation(fields: [aiSystemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  owner     User            @relation("RegisteredAgentOwner", fields: [ownerUserId], references: [id])
  vendor    Vendor?         @relation("RegisteredAgentVendor", fields: [vendorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  proposals AgentProposal[]
  runs      WorkflowRun[]
  /// The credentials that speak for this agent. Many, not one: rotation issues
  /// a new key before revoking the old, and an agent must not become
  /// unregistered for the width of that window.
  apiKeys   TenantApiKey[]
  /// The tools this agent is allowed to reach. EMPTY MEANS NONE — the list is
  /// an allowlist, and an agent nobody has granted anything to can call nothing.
  tools     RegisteredAgentTool[]
  /// The agent-risk-assessment runs against this agent (Epic Agentic 3). Many,
  /// not one: a re-score after a staleness trigger is a NEW run, so the
  /// previous judgement and the basis it was true of stay legible.
  assessments AgentRiskAssessment[]
  /// The agent's policy card (Epic Agentic 5) — at most one, holding many
  /// versions. Optional because an agent registered before the card existed has
  /// none, and an absent card contributes NO term at the tool boundary: the
  /// register's own governance artefact must never be the thing that takes a
  /// working agent dark.
  policyCard  AgentPolicyCard?
  /// The agent's own behavioural history, and the latch it can throw. The
  /// breaker is optional for the same reason the card is: an agent registered
  /// before it existed has none, and an absent breaker refuses nothing.
  behaviourWindows AgentBehaviourWindow[]
  circuitBreaker   AgentCircuitBreaker?

  /// Composite parent key so the child tables that attribute work to an agent
  /// can never point cross-tenant. Mirrors AiSystem's own shape.
  @@unique([id, tenantId])
  /// One agent per AI-system register entry — the 1:1 half of the required link.
  /// Two declarations, and both earn their place: the single-column unique IS
  /// the invariant ("an AI-system row is claimed by at most one agent"), while
  /// Prisma requires a unique over the exact relation field list before it will
  /// type a composite relation as 1:1. The composite is implied by the
  /// single-column one, so the extra index is redundant at the DB — kept anyway
  /// so neither half can be deleted as "obviously unnecessary" without the other
  /// being noticed.
  @@unique([aiSystemId])
  @@unique([aiSystemId, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, riskTier])
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, vendorId])
}

/// Epic Agentic 2 — DENY-BY-DEFAULT tool exposure. One row per (agent, MCP
/// tool) the tenant has deliberately granted. An agent reaches a tool only if a
/// row here names it; the server offering the tool is not permission to call it.
///
/// ## Why a join table rather than a column on RegisteredAgent
///
/// A `grantedTools String[]` (or a JSON blob) would have been shorter and is
/// wrong for three reasons that all cost something later:
///
///   • WHO granted it and WHEN are the questions an incident review asks first,
///     and an array has nowhere to put them. Granting a tool is a privileged
///     act; the record of it belongs beside the grant, not only in the audit
///     trail, because the trail answers "what happened" and the register has to
///     answer "what is true now".
///   • Revoking one tool from an array is a read-modify-write of the whole set,
///     so two concurrent revokes silently lose one. A row delete is a row
///     delete.
///   • The composite FK below cannot be expressed from inside an array, and it
///     is what makes a cross-tenant grant unrepresentable rather than merely
///     unlikely.
///
/// ## `toolName` is a plain String, deliberately
///
/// The tool catalogue lives in `src/lib/mcp/tools/registry.ts` and moves with
/// the code; an enum would put a deploy-ordering hazard between adding a tool
/// and being able to grant it (the same `ALTER TYPE` mid-rolling-deploy problem
/// the `@@map("WorkItem*")` pins record). The usecase validates the name against
/// the live catalogue on write, so an unknown tool is refused at the seam
/// instead — and a grant for a tool that is later REMOVED from the catalogue is
/// inert rather than a foreign-key error, which is the right direction: the
/// tool is gone, so nothing can call it.
model RegisteredAgentTool {
  id       String @id @default(cuid())
  tenantId String
  agentId  String

  /// The MCP tool name exactly as `tools/list` advertises it, e.g. `list_risks`.
  toolName String

  /// The human who granted it. A plain String with no FK, matching
  /// `RegisteredAgent.createdByUserId`: the grant record must survive the
  /// grantor's account being deleted, and a `RESTRICT` FK would block that
  /// deletion while a `SET NULL` one would erase the accountability this column
  /// exists for.
  grantedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Composite FK to the agent's (id, tenantId) parent key — a grant can never
  /// point at another tenant's agent. CASCADE, unlike the RESTRICT on
  /// AgentProposal: a grant is authority, not history, and authority for an
  /// agent that no longer exists must not outlive it.
  agent  RegisteredAgent @relation(fields: [agentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One grant per (agent, tool). Tenant-leading so it doubles as the
  /// tenant-scoped lookup index.
  @@unique([tenantId, agentId, toolName])
  @@index([tenantId, agentId])
}

// ═════════════════════════════════════════════════════════════════════
// Epic Agentic 3 — the AGENT RISK ASSESSMENT.
//
// Singapore IMDA's Model AI Governance Framework for Agentic AI makes
// "assess and bound the risks upfront" its first dimension, scored on
// AUTONOMY × DATA ACCESS × ACTION REVERSIBILITY. NIST AI RMF, ISO/IEC 42001
// and the EU AI Act contain no instrument for it, so a customer running agents
// has nothing to fill in. These four tables are that instrument.
//
// The split is copied DELIBERATELY and EXACTLY from the AI-governance
// self-assessment (`ai-governance.prisma`), because getting it backwards is the
// expensive mistake in both directions:
//
//   • `AgentAssessmentDomain` / `AgentAssessmentQuestion` are GLOBAL REFERENCE
//     CONTENT — no `tenantId`, no RLS, seeded from a fixture. Putting them
//     behind RLS would mean every tenant needs its own copy of a question set
//     that is identical for all of them, and an assessor citing "ara-1-03"
//     would resolve to a different row per customer.
//   • `AgentRiskAssessment` / `AgentRiskAssessmentAnswer` are TENANT-SCOPED
//     RUNS with the canonical policy triple. They hold what one customer said
//     about one of its agents; leaving them global would publish it.
//
// The answer's `note` is BOTH encrypted at rest (Epic B manifest) AND sanitised
// on write (Epic D) — same as `AiGovSelfAssessmentAnswer.note`, for the same
// reason: encryption protects confidentiality, sanitisation protects every
// downstream renderer that decrypts and prints the field verbatim.
// ═════════════════════════════════════════════════════════════════════

/// Global reference: one dimension of the agent risk assessment.
/// Not tenant-scoped (shared library content, no RLS).
model AgentAssessmentDomain {
  /// Stable domain id (1-4) from the fixture — the four IMDA dimensions.
  id          Int    @id
  /// Short stable code, e.g. "RISK_BOUNDING".
  code        String @unique
  name        String
  /// What this dimension is asking about, in one sentence.
  description String
  sortOrder   Int    @default(0)

  questions AgentAssessmentQuestion[]
}

/// Global reference: one agent-risk-assessment question.
/// Not tenant-scoped (shared library content, no RLS).
///
/// `id` is the STABLE EXTERNAL KEY. An assessor citing a question in a report
/// has to land on the same row forever, so these are authored ids from the
/// fixture (`ara-<domain>-<nn>`) and never regenerated — which is also why the
/// seed is an upsert keyed on `id` rather than a truncate-and-reload.
model AgentAssessmentQuestion {
  id       String @id
  domainId Int

  /// Paraphrased question text. References the OWASP Agentic Security
  /// Initiative threat classes and the IMDA dimensions BY ID only, never
  /// verbatim source prose — the same licensing posture as `AiGovQuestion`.
  text     String
  /// One line of "what a YES looks like", so the answer means the same thing to
  /// two different assessors.
  guidance String?

  /// `{ asi: string[], imda: string[] }` — the external taxonomies this
  /// question projects onto. JSON rather than a `String[]` because a second
  /// taxonomy (an ISO 42001 agentic annex, a NIST profile) is a fixture edit
  /// here and a migration there.
  mappingsJson Json

  /// String enum: CRITICAL | HIGH | MEDIUM (validated at the usecase). Drives
  /// the answer weight in the scorer — see `agent-risk-scoring.ts`.
  criticality String

  domain  AgentAssessmentDomain      @relation(fields: [domainId], references: [id])
  answers AgentRiskAssessmentAnswer[]

  @@index([domainId])
}

/// Tenant-scoped: one run of the agent risk assessment against ONE agent.
///
/// ## Why the basis snapshot columns exist
///
/// A completed assessment writes a tier back to `RegisteredAgent.riskTier`, and
/// that tier then CAPS how much authority the agent may hold. So the tier has to
/// carry the state it was true of. The `basis*` columns are the four scorer
/// inputs plus the tool count and the model reference, frozen at the moment of
/// scoring — staleness is then a COMPARISON against the live agent rather than
/// a flag somebody remembered to set. A flag can be forgotten; a comparison
/// cannot, and it also survives a write path nobody thought to instrument.
///
/// They are nullable because a DRAFT run has not been scored yet, and a basis
/// invented at insert time would be a snapshot of a state nobody assessed.
model AgentRiskAssessment {
  id       String @id @default(cuid())
  tenantId String
  /// The agent this run assesses. Composite FK to (id, tenantId) so an
  /// assessment can never point at another tenant's agent.
  agentId  String

  /// Lifecycle: DRAFT | IN_PROGRESS | COMPLETED (String enum, validated at the
  /// usecase). A String rather than a Postgres enum for the
  /// same reason `RegisteredAgentTool.toolName` is: `ALTER TYPE` mid-rolling-
  /// deploy makes still-running old containers fail with SQLSTATE 42704.
  status String @default("DRAFT")

  /// Pins the question-set version this run was started against, so a later
  /// fixture revision does not silently rescore a completed assessment.
  questionSetVersion Int @default(1)

  /// The tier this run produced, kept HERE as well as on the agent. The agent
  /// row holds the current answer; this column holds the history, so a re-score
  /// that changes the tier leaves the previous judgement legible.
  scoredTier         AgentRiskTier?
  /// The raw additive score behind the tier, and the per-axis breakdown that
  /// explains it. A tier nobody can explain is a tier nobody acts on.
  score              Int?
  scoreBreakdownJson Json?

  // ── The basis: what the agent looked like when it was scored ──
  basisAutonomyLevel   Int?
  basisDataAccessScope AgentDataAccessScope?
  basisReversibility   AgentReversibility?
  basisProvenance      AgentProvenance?
  /// How many tools were granted at scoring time. A grant added afterwards is
  /// one of the four staleness triggers.
  basisToolCount       Int?
  /// Which underlying model the agent ran on at scoring time (see
  /// `RegisteredAgent.modelRef`). NULL means never declared.
  basisModelRef        String?

  // ── Staleness ──
  /// When the assessment was first observed to be stale. NULL means fresh.
  /// Stale WARNS, it does not block — see the implementation note; "never
  /// scored" (agent.riskTier IS NULL) is a DIFFERENT state and that one denies.
  staleAt       DateTime?
  /// Which triggers fired, as stable codes (AUTONOMY_RAISED, TOOL_GRANTED,
  /// DATA_SCOPE_WIDENED, REVERSIBILITY_WORSENED, MODEL_CHANGED). Named
  /// `staleTriggers` and not `staleReasons` on purpose: `reason` is in the
  /// encryption-manifest sensitivity heuristic, and a column of enum codes
  /// tripping a free-text detector teaches people to add exemptions.
  staleTriggers String[]

  createdById String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent   RegisteredAgent             @relation(fields: [agentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  answers AgentRiskAssessmentAnswer[]

  /// Composite parent key so answers can never point cross-tenant.
  @@unique([id, tenantId])
  @@index([tenantId, agentId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, status])
}

/// Tenant-scoped: one answer within an agent risk assessment.
/// `note` is encrypted at rest (Epic B manifest) + sanitised on write (Epic D).
model AgentRiskAssessmentAnswer {
  id           String @id @default(cuid())
  tenantId     String
  assessmentId String
  questionId   String

  /// String enum: NA | NO | PARTIALLY | YES (validated at the usecase).
  answer String
  /// Free-text rationale — ENCRYPTED at rest (see encrypted-fields.ts) and
  /// sanitised at the single `saveAgentAssessmentAnswer` write seam.
  note   String?

  answeredById String?
  answeredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment AgentRiskAssessment     @relation(fields: [assessmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  question   AgentAssessmentQuestion @relation(fields: [questionId], references: [id])

  @@unique([assessmentId, questionId])
  @@index([tenantId, assessmentId])
  @@index([questionId])
}

// ═════════════════════════════════════════════════════════════════════
// Epic Agentic 5 — the POLICY CARD.
//
// A machine-readable, VERSIONED runtime policy for one registered agent,
// evaluated at the MCP tool boundary before anything executes (arXiv 2510.24383,
// "Policy Cards: Machine-Readable Runtime Governance for Autonomous AI Agents").
// 1/10 recorded what an agent is, 2/10 bounded what its credential may reach,
// 3/10 scored how much authority it has earned — all three are RECORDS. This is
// where they become a refusal.
//
// TWO TABLES, AND THE SPLIT IS THE POINT:
//
//   • AgentPolicyCard is the MUTABLE HEAD — which version is in force, and the
//     agent's rolling per-day action window. It is one row per agent and it is
//     written on every tool call (the budget reservation).
//   • AgentPolicyCardVersion is APPEND-ONLY POLICY. Every edit writes a NEW row;
//     no row is ever updated. `app_user` holds no UPDATE privilege on the table
//     and a trigger refuses one from any role.
//
// A version has to be immutable because the next prompt PINS it: a WorkflowRun
// and an AgentProposal each record the version in force when they executed, so
// that an audit reconstructs what the rules WERE. A pinned version that can
// still be edited reconstructs nothing — it reconstructs today's rules wearing
// last quarter's version number, which is worse than recording nothing at all.
// ═════════════════════════════════════════════════════════════════════

/// Tenant-scoped: one agent's policy card — the mutable head.
///
/// The per-day usage columns live HERE rather than on a counter table of their
/// own, because this row already has exactly the counter's key (one row per
/// agent, tenant-scoped) and a separate table would be a second thing to keep in
/// step. They are HEAD STATE, not policy: nothing about how many calls an agent
/// has made today belongs in the immutable record of what it was allowed to do.
model AgentPolicyCard {
  id       String @id @default(cuid())
  tenantId String
  agentId  String

  /// The version number in force. Versions are append-only and this pointer
  /// moves; an Int rather than an FK to the version row so the two tables do not
  /// point at each other, which would make either one impossible to insert first.
  currentVersion Int @default(1)

  /// The UTC day the counter below is counting. NULL until the first call.
  /// A `@db.Date` and not a DateTime: the window is a calendar day, and storing
  /// a timestamp would invite a comparison that is right in one timezone.
  usageWindowDate DateTime? @db.Date
  /// Tool calls made in that window. Reserved (incremented) BEFORE the call is
  /// allowed to proceed, so two concurrent calls cannot both read the same
  /// number and both be admitted.
  actionsInWindow Int       @default(0)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Composite FK to the agent's (id, tenantId) parent key — a card can never
  /// point at another tenant's agent. CASCADE, like RegisteredAgentTool: a card
  /// is authority, and authority for an agent that no longer exists must not
  /// outlive it.
  agent    RegisteredAgent          @relation(fields: [agentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  versions AgentPolicyCardVersion[]

  /// Composite parent key so versions can never point cross-tenant.
  @@unique([id, tenantId])
  /// One card per agent, declared twice, and both earn their place — the same
  /// pair `RegisteredAgent` carries for its AiSystem link. `[tenantId, agentId]`
  /// is the tenant-leading lookup index every tenant-scoped model must have;
  /// `[agentId, tenantId]` is the unique over the exact relation field list that
  /// Prisma requires before it will type the composite relation as 1:1. Either
  /// one implies the other at the database, so the pair is redundant there —
  /// kept anyway so neither half can be deleted as obviously unnecessary
  /// without the other being noticed.
  @@unique([tenantId, agentId])
  @@unique([agentId, tenantId])
}

/// Tenant-scoped: ONE IMMUTABLE VERSION of a policy card.
///
/// Every column is a declaration the boundary reads. None is derived at read
/// time, because a version has to mean the same thing when it is read back as
/// evidence years later as it did when it was written.
///
/// The two set-valued columns are `String[]` rather than join tables: unlike
/// `RegisteredAgentTool` — where "who granted it and when" is the question an
/// incident review asks first — a version row IS the answer to when and by whom,
/// for every field at once, and it is never mutated, so the read-modify-write
/// hazard that rules an array out for a live allowlist does not exist here.
///
/// `approvalRung` is a String and not a Postgres enum, for the reason
/// `RegisteredAgentTool.toolName` is: an `ALTER TYPE` mid-rolling-deploy makes
/// still-running old containers fail with SQLSTATE 42704. Validated against
/// `APPROVAL_LADDER` at the usecase.
model AgentPolicyCardVersion {
  id       String @id @default(cuid())
  tenantId String
  cardId   String

  /// 1, 2, 3 … within one card. Unique per card, and never reused.
  version Int

  /// The MCP tools this agent may call. INTERSECTED with the 2/10 grant list at
  /// the boundary, never unioned — a card cannot widen, only narrow.
  permittedTools String[]

  /// The highest data-access rung any call may reach. The permitted SET is the
  /// prefix of the enum up to this rung, derived rather than stored, because the
  /// enum's own doc comment says each rung is strictly more exposing than the
  /// one above it.
  maxDataScope AgentDataAccessScope

  /// The highest autonomy rung any call may require (0-6).
  maxAutonomyLevel Int

  /// Action budgets. Rungs of `ACTION_CAP_LADDER`; validated at the usecase.
  maxActionsPerRun Int
  maxActionsPerDay Int

  /// Which refusal rules are worth waking somebody for, as the stable codes in
  /// `POLICY_CARD_RULES`. A refusal always audits; a refusal on a declared
  /// trigger additionally carries `escalate: true` into the audit row.
  escalationTriggers String[]

  /// How many humans must sign a proposal from this agent — a rung of
  /// `APPROVAL_LADDER`. Not read at the tool boundary (a tool call is not an
  /// approval); declared and pinned so 8/10's review queue reads the version
  /// that was in force when the proposal was made.
  approvalRung String

  /// TRUE for the version a card was CREATED with, false for every edit. Kept
  /// because "what did this open at" and "what did somebody change it to" are
  /// different questions, and the first one stops being answerable once the
  /// version numbers are all that is left.
  seeded         Boolean        @default(false)
  /// The tier the seeding was derived from. NULL on an edit, and NULL is not
  /// "unscored" here — a card is refused for an unscored agent, so no version
  /// row can carry that state.
  seededFromTier AgentRiskTier?

  createdByUserId String?
  createdAt       DateTime @default(now())

  /// No `updatedAt`. The row is append-only, and a column that promises to
  /// record an update on a table that refuses updates is a promise the table
  /// does not make.

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   AgentPolicyCard @relation(fields: [cardId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, cardId, version])
  @@index([tenantId, cardId])
}

// ═════════════════════════════════════════════════════════════════════
// Tool-manifest pinning — the supply-chain control over tool DEFINITIONS
// (OWASP ASI04, "tool poisoning").
//
// A tool definition is three fields the model reads — name, DESCRIPTION and
// parameter schema — and only the first is ever visible in a normal session.
// The description is instruction text delivered straight into the agent's
// context by `tools/list`, which makes it the field an attacker edits and
// expects nobody to look at. One row here is the tenant's statement that it has
// SEEN a particular definition of one tool; the boundary refuses the tool when
// the build no longer matches, until a named human re-approves.
//
// See src/lib/mcp/tool-manifest.ts for why the description is hashed verbatim
// while the schema is canonicalised first.
// ═════════════════════════════════════════════════════════════════════

/// Tenant-scoped: the tool DEFINITION a tenant has on file for one MCP tool.
model McpToolManifestPin {
  id       String @id @default(cuid())
  tenantId String

  /// The MCP tool name exactly as `tools/list` advertises it, e.g. `list_risks`.
  /// A plain String and not an enum, for the reason `RegisteredAgentTool.toolName`
  /// is one: a tool ships with a deploy, and an `ALTER TYPE` mid-rolling-deploy
  /// makes still-running old containers fail with SQLSTATE 42704.
  toolName String

  /// SHA-256 of the description's EXACT bytes — no trimming, no whitespace
  /// collapsing, no Unicode normalisation. Every one of those would create a
  /// class of edits that changes what the model reads while leaving the hash
  /// alone, and zero-width characters are how instruction text hides.
  descriptionHash String
  /// SHA-256 of the canonicalised (sorted-key, no-whitespace) input schema. Key
  /// order is not semantic in JSON Schema, so a formatter must not alarm.
  schemaHash      String
  /// SHA-256 over the domain-separated triple. What the boundary compares.
  manifestHash    String

  /// `BASELINE` — the first definition the boundary ever observed for this tool
  /// (trust-on-first-use, no human involved). `APPROVED` — a named human
  /// accepted a definition that had CHANGED. The two must stay distinguishable
  /// forever: an auditor asking "did a person accept this description" must get
  /// a straight answer rather than one inferred from a timestamp. A String
  /// rather than a Postgres enum, same rolling-deploy argument as `toolName`.
  approvalSource String

  /// The human who approved. NULL on, and ONLY on, a `BASELINE` row — a plain
  /// String with no FK, matching `RegisteredAgentTool.grantedByUserId`: the
  /// approval must survive the approver's account being deleted, and a
  /// `RESTRICT` FK would block that deletion while a `SET NULL` one would erase
  /// the accountability this column exists for.
  approvedByUserId String?
  approvedAt       DateTime @default(now())

  /// 1 for the baseline, +1 on every re-approval. The count an operator reads
  /// as "how many times has this tool's definition moved under us".
  revision Int @default(1)

  /// The manifest hash this row REPLACED. NULL on a baseline row. Kept so an
  /// incident review can tell which definition was displaced without
  /// reconstructing it from the audit trail.
  previousManifestHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// One pin per (tenant, tool). Tenant-leading, so it doubles as the
  /// tenant-scoped lookup index and no separate `@@index([tenantId])` is needed:
  /// every query this table serves is `tenantId` alone or `tenantId + toolName`.
  @@unique([tenantId, toolName])
}

// ═════════════════════════════════════════════════════════════════════
// Epic Agentic 9 — THE KILL SWITCH (OWASP ASI08 cascading failure,
// ASI10 rogue agent).
//
// ## Why this is not `RegisteredAgent.status = SUSPENDED`
//
// Suspension already exists and it is a DISPATCH control. `evaluateAgentRegistration`
// reads the agent's status once, inside `resolveMcpInvocation`, and the workflow
// engine resolves ONE invocation per execution and then drives every step on it.
// So suspending an agent refuses the next REQUEST and does nothing at all to a
// run already in flight — which is the case a stop control exists for. It is
// also inert for a tenant with `requireRegisteredAgent` off, and it has no
// tenant-wide or platform-wide form: an incident affecting a fleet would be
// answered one row at a time.
//
// These tables are read at the TOOL BOUNDARY instead, uncached, once per tool
// call, beside the credential-liveness re-read that closed the same gap for
// revocation. See `src/lib/agentic/kill-switch.ts`.
//
// ## Why TWO tables rather than one with a nullable tenantId
//
// A platform-wide kill has no tenant, and a nullable `tenantId` on a
// tenant-scoped table forces the asymmetric single-policy RLS shape `UserSession`
// needs (`USING (tenantId IS NULL OR own) WITH CHECK (own)`) — a form this
// subsystem would then have to justify per reader. The split is the one
// `ai-governance.prisma` and this file's own assessment tables already make:
// tenant-scoped rows behind the canonical policy triple, global rows in their
// own table with no RLS and no `app_user` write grant.
//
// ## Why no Postgres enums
//
// Same reason `McpToolManifestPin.approvalSource` and
// `AgentPolicyCardVersion.approvalRung` are TEXT with CHECK constraints: an
// `ALTER TYPE` mid-rolling-deploy makes still-running old containers fail with
// SQLSTATE 42704 (the lesson the `@@map("WorkItem*")` pins record). A kill scope
// and a drill outcome are both vocabularies that could plausibly grow, so
// neither becomes a type somebody has to recreate the table to widen. The
// vocabularies are pinned in `src/lib/agentic/kill-switch.ts` and by CHECK
// constraints in the migration.
// ═════════════════════════════════════════════════════════════════════

/// Tenant-scoped: a kill in force for ONE agent, or for the WHOLE tenant.
///
/// ## The scope is DERIVED, never stored
///
/// `agentId IS NULL` ⇔ TENANT scope; `agentId IS NOT NULL` ⇔ AGENT scope. A
/// stored `scope` column beside a nullable `agentId` would be two encodings of
/// one fact, and two encodings can disagree — at which point the boundary has to
/// pick one and whichever it picks is wrong half the time. There is nothing to
/// keep in step because there is only one field.
///
/// ## `agentId` carries NO foreign key, and that is deliberate
///
/// Three reasons, each of which would be enough on its own:
///
///   • A kill must be recordable for an agent the register cannot resolve. The
///     whole point of an emergency stop is that it works when the register is in
///     a bad state; an FK makes a healthy register a PRECONDITION for stopping.
///   • A kill row is HISTORY — the record that somebody stopped something at a
///     time, for a reason. `RegisteredAgentTool` argues the opposite way for its
///     grants ("a grant is authority, not history") and CASCADEs; the same
///     argument run the other direction says a kill must OUTLIVE its agent,
///     because deleting the agent is exactly when the record matters most.
///   • It lets the scheduled drill (`agent-kill-switch-drill`) engage and lift a
///     real, committed kill against a canary id that no credential can ever
///     resolve to — so the drill exercises the whole write → enforce → lift
///     lifecycle without ever stopping a production agent.
///
/// A row naming an agent id that does not exist is INERT: the boundary reads
/// `(tenantId, agentId)`, so an unmatched id simply never matches.
model AgentKillSwitch {
  id       String  @id @default(cuid())
  tenantId String
  /// NULL = every agent in this tenant. Non-NULL = that one agent.
  agentId  String?

  /// Why somebody pulled it. Sanitised on write (`sanitizePlainText`) — it is
  /// read back by an operator surface and by the drill's evidence record.
  /// REQUIRED: a kill with no stated reason is an outage nobody can review.
  reason          String
  engagedByUserId String
  engagedAt       DateTime @default(now())

  /// NULL while the kill is IN FORCE. Lifting is an UPDATE, not a DELETE: the
  /// row is the evidence that agents were stopped between two timestamps, and
  /// an incident review that cannot see the window cannot review the incident.
  liftedAt       DateTime?
  liftedByUserId String?
  liftReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// THE HOT-PATH INDEX. Every tool call asks
  /// `(tenantId = ?, liftedAt IS NULL, agentId IN (?, NULL))`, and this composite
  /// serves it leftmost-first. Tenant-leading, so it also satisfies the
  /// tenant-scoped lookup every model must have.
  @@index([tenantId, agentId, liftedAt])
  /// The operator surface: "what has been killed here, most recent first".
  @@index([tenantId, engagedAt])
}

/// GLOBAL: the platform-wide stop. Not tenant-scoped, and therefore no RLS.
///
/// ## Why it is global content rather than a tenant row
///
/// There is no tenant to scope it to. The authority to stop every agent in the
/// deployment is not a tenant role — no tenant admin may hold it, and no
/// `PermissionSet` key can express it, because `requirePermission` resolves a
/// TENANT role. It is gated by `PLATFORM_ADMIN_API_KEY` through
/// `verifyPlatformApiKey`, the same credential that creates tenants and
/// transfers their ownership.
///
/// `app_user` gets SELECT and nothing else in the migration. The boundary reads
/// this table on the superuser session (the base Prisma client, like
/// `policy-card-store.ts`); the grant exists so a read from inside a tenant
/// transaction cannot silently return zero rows and report "not killed".
///
/// ## `engagedByRef` is a free-text operator reference, not a user id
///
/// The platform-admin key is not a person. Storing a `User` id would invent an
/// actor; storing NULL would make the row unattributable. A ref the operator
/// supplies (a change ticket, an incident id, a pager handle) is the honest
/// record, and it is REQUIRED for the same reason `reason` is.
model PlatformAgentKillSwitch {
  id String @id @default(cuid())

  reason       String
  engagedByRef String
  engagedAt    DateTime @default(now())

  liftedAt   DateTime?
  liftedByRef String?
  liftReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The boundary's only question: is there an unlifted row? A partial unique
  /// index in the migration additionally holds "at most one".
  @@index([liftedAt])
}

/// Tenant-scoped: ONE RUN of the scheduled kill-switch drill.
///
/// An untested stop control is an assumption. This row is the record that the
/// assumption was checked, when, against which scopes, and what happened — and
/// it is shaped to be read as EVIDENCE rather than as a log line: every column
/// is a fact an auditor asks for, and none of it has to be reconstructed from
/// free text.
///
/// `evidenceId` and `findingId` are plain Strings with NO foreign key, matching
/// `RegisteredAgentTool.grantedByUserId`'s reasoning: the drill record must
/// survive the Finding being resolved and purged, a RESTRICT FK would block that
/// purge, and a SET NULL one would erase the very link the record exists for.
model AgentKillSwitchDrill {
  id       String @id @default(cuid())
  tenantId String

  /// The BullMQ job-run id, so a drill row joins back to the tick that produced
  /// it the way `control-test-runner` threads its `jobRunId`.
  jobRunId String

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// `PASSED` | `FAILED` | `ERROR`. TEXT + CHECK, not an enum — see the header.
  /// `ERROR` is NOT `FAILED`: a drill that could not run has proved nothing, and
  /// collapsing it into "the control is broken" would raise a Finding about the
  /// wrong thing. Both are non-PASSED and both are visible; only FAILED raises.
  outcome String

  /// Which scopes were exercised and honoured, and which were not. Arrays rather
  /// than three boolean columns because the scope vocabulary is code, not schema
  /// — a fourth scope must not need a migration to be drillable.
  scopesHonoured String[] @default([])
  scopesFailed   String[] @default([])

  /// THE MEASUREMENT. How many tool calls the boundary let through AFTER the
  /// kill was in force. Anything other than 0 is the control failing, and it is
  /// stored as the number rather than as a verdict so a partial failure ("one
  /// call slipped through") is distinguishable from a total one.
  toolCallsAfterKill Int @default(0)

  /// The refusal reason the boundary actually gave, e.g. `agent_killed`. Stored
  /// because a refusal for the WRONG reason is a failure that a pass/fail column
  /// cannot show: if the kill check is moved below the credential check, the
  /// call is still refused — by something else — and the stop control is dead
  /// while every status code looks right.
  boundaryRefusalReason String?

  /// Operator-readable summary. Sanitised on write. Digest-level only — it never
  /// carries tool arguments, prompts or proposal payloads.
  detail String

  /// The `Evidence` row this drill produced, and the `Finding` a FAILED drill
  /// raised. Both nullable: a PASSED drill raises nothing, and an ERROR drill
  /// may not get as far as either.
  evidenceId String?
  findingId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// "The most recent drills for this tenant" — the operator surface and the
  /// evidence query are the same shape.
  @@index([tenantId, startedAt])
  /// "Has any drill failed?" — the alert query.
  @@index([tenantId, outcome])
}

// ═════════════════════════════════════════════════════════════════════
// The behavioural CIRCUIT BREAKER — anomaly, not volume (OWASP ASI08/ASI10).
//
// The action caps on a policy card answer "is this agent doing too MUCH". They
// cannot answer "is this agent doing something DIFFERENT", which is the
// rogue-agent question: an agent that has read framework status every night for
// a month and starts calling propose tools has exceeded no budget and never
// will. These two tables are the agent's own history and the latch that history
// can throw.
//
// The judgement itself lives in `src/lib/agentic/circuit-breaker.ts`, which is a
// pure function of its argument — no clock, no I/O — so a trip can be re-derived
// from these rows during the review that follows it.
// ═════════════════════════════════════════════════════════════════════

/// Tenant-scoped: ONE HOUR of one agent's observed behaviour.
///
/// Written at the MCP tool boundary, on the call that was authorized, in one
/// statement. The counters are by capability CLASS rather than by tool name
/// because the class is the bounded dimension — three columns, whatever the
/// catalogue grows to — and because "started proposing" is the fact worth
/// stopping an agent for, while "called a different read tool" is not.
///
/// A row exists only for an hour in which the agent was OBSERVED. An hour with
/// no row is ambiguous — idle agent, stopped worker, sleeping tenant — and a
/// baseline that reads every such hour as a hard zero drifts to zero and then
/// trips on the first ordinary hour. So the rate this feeds is "calls per ACTIVE
/// window", which is a claim these rows can actually support.
model AgentBehaviourWindow {
  id       String @id @default(cuid())
  tenantId String
  agentId  String

  /// The hour this row counts, truncated to the hour in UTC. UTC stated once,
  /// for the reason `AgentPolicyCard.usageWindowDate` is a `@db.Date`: a window
  /// whose boundary depends on the reader's timezone yields two different
  /// histories from the same rows.
  windowStart DateTime

  readCalls        Int @default(0)
  proposeCalls     Int @default(0)
  orchestrateCalls Int @default(0)

  /// The distinct tool names seen this hour. EVIDENCE, never a trip condition:
  /// a tool name the agent has not used before is the most tempting signal here
  /// and the worst one, because every routine grant produces it. It is carried
  /// so a trip is legible to whoever reads it.
  ///
  /// A `String[]` and not a join table, and the write is `array_append` guarded
  /// by `= ANY(...)` inside the same UPDATE — never a read-modify-write, which
  /// on a per-call path is a lost update per concurrent call.
  toolNames String[]

  /// TRUE when this window's own verdict fired a signal.
  ///
  /// A DETECTOR MUST NOT LEARN FROM THE ANOMALY. Left in the history, the first
  /// propose call from a read-only agent makes `propose` a class that agent has
  /// used — so the strongest signal in the subsystem would extinguish itself one
  /// window after firing, and the two-window persistence rule could never be
  /// satisfied by it. `evaluateCircuitBreaker` drops these rows.
  anomalous Boolean @default(false)

  /// The verdict code recorded for this window. NULL means NOT YET JUDGED —
  /// the window is still open, or the agent has not acted since it closed.
  /// Distinct from `STEADY`: "nothing was found" and "nothing was looked at"
  /// are different facts and a column that stores them identically stores the
  /// second one as the first.
  verdict String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  RegisteredAgent @relation(fields: [agentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One row per (tenant, agent, hour). Tenant-leading, so it is also the
  /// tenant-scoped lookup index and the `agentId` foreign-key index — every
  /// query this table serves is a prefix of it.
  @@unique([tenantId, agentId, windowStart])
}

/// Tenant-scoped: the LATCH, and the baseline it judges against.
///
/// One row per agent, created on first observation. `state = OPEN` is the
/// electrical sense — the circuit is broken and nothing flows — and it is read
/// at `authorizeToolCall` on every call, so an OPEN breaker stops a run already
/// in flight rather than only the next dispatch.
///
/// NOTHING HERE CLOSES ITSELF. No half-open probe and no timeout, because both
/// are auto-recovery and an agent that has gone rogue can wait one out. The
/// close is `closeAgentCircuitBreaker`, gated by `admin.agent_registry`, audited,
/// and it carries a reason that decides what happens to the baseline.
model AgentCircuitBreaker {
  id       String @id @default(cuid())
  tenantId String
  agentId  String

  /// `CLOSED` | `OPEN` — `BREAKER_STATES` in `circuit-breaker.ts`.
  ///
  /// A String and NOT a Postgres enum, for the reason `RegisteredAgentTool.toolName`
  /// and `AgentPolicyCardVersion.approvalRung` are: an `ALTER TYPE` mid-rolling-deploy
  /// makes still-running old containers fail with SQLSTATE 42704. A CHECK
  /// constraint pins the vocabulary instead, which can be widened by a plain
  /// `ALTER TABLE`.
  state String @default("CLOSED")

  /// The window key (`YYYY-MM-DDTHH`) the last evaluation judged. The lazy
  /// trigger: the boundary evaluates when the agent's current window is not
  /// this one, so judgement happens once per active window per agent and is
  /// driven by the agent's own traffic. An agent that stops calling is never
  /// re-judged, which is correct — a silent agent needs no breaker.
  lastEvaluatedWindow String?

  /// Consecutive anomalous windows, and the signals that carried them.
  /// Persistence is per SIGNAL: two windows firing DIFFERENT signals are two
  /// unrelated oddities, and the claim worth stopping an agent for is that the
  /// same thing is still true.
  anomalousStreak Int      @default(0)
  streakSignals   String[]

  /// The last verdict recorded, so an operator surface can distinguish "steady"
  /// from "refused to judge". `NO_BASELINE` is a verdict, not a silence.
  lastVerdict   String?
  lastVerdictAt DateTime?

  trippedAt      DateTime?
  trippedWindow  String?
  trippedSignals String[]

  /// Samples from before this instant are DISCARDED.
  ///
  /// The false-positive escape hatch that keeps the breaker survivable: an
  /// operator who deliberately changes what an agent does advances the epoch and
  /// the agent re-learns, rather than tripping and then being explained. Without
  /// it, the only way to stop being paged for a change you made is to disable
  /// the control.
  baselineEpoch DateTime @default(now())

  closedAt       DateTime?
  closedByUserId String?
  /// `ACCEPTED_NEW_BASELINE` | `RESOLVED` — `BREAKER_CLOSE_REASONS`. The two are
  /// not interchangeable: the first says the anomaly WAS the new normal and
  /// advances the epoch, the second says the agent was fixed and KEEPS the old
  /// baseline. Collapsing them would silently adopt rogue behaviour as normal.
  closeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  RegisteredAgent @relation(fields: [agentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  closedBy User?         @relation("AgentCircuitBreakerClosedBy", fields: [closedByUserId], references: [id])

  /// The pair `AgentPolicyCard` carries, and for the same two reasons: the
  /// tenant-leading unique is the tenant-scoped lookup index every tenant model
  /// must have, and Prisma needs a unique over the exact relation field list
  /// before it will type the composite relation as 1:1.
  @@unique([tenantId, agentId])
  @@unique([agentId, tenantId])
  @@index([closedByUserId])
}

// ═════════════════════════════════════════════════════════════════════
// The EVIDENCE LEDGER — receipts and decision records become audit artefacts.
//
// Everything upstream of this file produces RECORDS: mediator-signed action
// receipts, hash-chained audit entries, one `AiDecisionLog` row per AI
// invocation. None of that is EVIDENCE until it is attached to the control it
// discharges, and until this file existed that attachment was a person with a
// spreadsheet in the week before an audit.
//
// This table is the identity of an emitted artefact, and the identity is the
// whole design. It is `(tenant, control, kind, period)` — NOT a receipt id and
// NOT a content digest:
//
//   • A RECEIPT ID would make one evidence row per agent action. That is not an
//     artefact, it is a second copy of the receipt ledger with a wider read
//     surface, and it puts an unbounded row count in front of an assessor.
//   • A CONTENT DIGEST re-runs safely only while nothing changes. The moment one
//     more receipt lands inside the period the digest moves and the same period
//     acquires a SECOND artefact — duplication by construction, and two
//     artefacts for one quarter that nobody can rank.
//   • `(control, kind, period)` is the unit the question is actually asked in:
//     "show me your ASI02 evidence for August". Re-running recomputes the same
//     identity and UPDATES in place, which is what makes an emitter safe to
//     schedule. The content digest is kept as a FIELD so "did the population
//     change" is still answerable — it just does not multiply rows.
//
// The artefact itself carries COUNTS, VOCABULARY AND POINTERS. It never inlines
// `scannedSummary`, `outputSummary` or `inputDigest`: `AiDecisionLog` holds a
// digest instead of the prompt on purpose and `AgentActionReceipt.scannedSummary`
// is bounded and scrubbed on purpose, and `Evidence.content` is a WIDER surface
// than either (unencrypted at rest, PDF-exported, reachable through an audit-pack
// share link). Copying into it what those two were careful to exclude would undo
// both decisions at once. `src/lib/agentic/evidence-artefact.ts` builds the body.
// ═════════════════════════════════════════════════════════════════════

/// Tenant-scoped: ONE emitted evidence artefact — the join between a period of
/// agentic records and the control they discharge.
///
/// A row is never deleted when its basis stops holding. Two failure modes, and
/// they are opposite mistakes: DELETING the evidence destroys something an audit
/// pack may already cite, which is the shape of evidence tampering; LEAVING IT
/// STALE lets a control go on claiming coverage it no longer has. So the row is
/// kept and told the truth — `status = 'WITHDRAWN'` with a reason, and its
/// `Evidence` archived with a withdrawal notice in place of the counts.
model AgenticEvidenceArtefact {
  id       String @id @default(cuid())
  tenantId String

  /// The agentic control this artefact discharges. Resolved from the control's
  /// `ControlRequirementLink` to an OWASP-ASI (or EU AI Act) requirement — see
  /// `EVIDENCE_TARGETS` in `src/lib/agentic/evidence-artefact.ts`.
  controlId String

  /// `AGENT_ACTION_RECEIPTS` | `AI_DECISION_RECORDS`. TEXT + CHECK rather than a
  /// Postgres enum, for the reason the `@@map("WorkItem*")` pins record: an
  /// `ALTER TYPE` mid-rolling-deploy makes still-running old containers fail
  /// with SQLSTATE 42704, and this vocabulary is one a follow-up will widen.
  kind String

  /// UTC month boundaries — `periodStart` inclusive, `periodEnd` exclusive.
  /// Part of the identity; `periodEnd` is derived from it and stored so a reader
  /// never has to know the period arithmetic to interpret a row.
  periodStart DateTime
  periodEnd   DateTime

  /// The `Evidence` row this artefact IS. Composite FK to `Evidence(id,
  /// tenantId)` so RLS chains through the parent, matching `EvidenceControlLink`.
  evidenceId String

  /// SHA-256 over the sorted ids of the records this artefact counted. NOT part
  /// of the identity — it is how a re-run knows whether anything moved, and how a
  /// reader knows two renderings of "August" describe the same population.
  sourceDigest String

  /// How many source records the artefact counted. Zero is a real value and is
  /// emitted: "this control produced no agentic activity in August" is a finding
  /// an assessor wants, and an absent row would be indistinguishable from a
  /// worker that never ran.
  recordCount Int @default(0)

  /// `CURRENT` | `WITHDRAWN`. See the model header for why nothing is deleted.
  status String @default("CURRENT")

  /// `CONTROL_REMOVED` | `SOURCE_UNVERIFIABLE`. Both NULL iff `CURRENT`, and the
  /// pairing is a CHECK rather than a convention: a withdrawn artefact that does
  /// not say why is indistinguishable from an emitter that stopped running.
  withdrawnAt     DateTime?
  withdrawnReason String?

  /// The last run that recomputed this artefact — distinct from `updatedAt`,
  /// which does not move when a run finds the population unchanged. An operator
  /// asking "is the emitter alive" reads this one.
  lastEmittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  control  Control  @relation(fields: [controlId, tenantId], references: [id, tenantId], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// THE IDENTITY. A unique index rather than a read-then-write in the usecase,
  /// because two ticks that overlap (a retry racing a schedule) would otherwise
  /// both read "absent" and both insert — the exact duplication the identity
  /// exists to prevent. Tenant-leading, so it doubles as the tenant-scoped index
  /// and as `controlId`'s foreign-key index.
  @@unique([tenantId, controlId, kind, periodStart])
  /// "The artefacts for this period" — the assessor-facing query.
  @@index([tenantId, periodStart])
  /// `evidenceId`'s foreign-key index, and the reverse lookup an evidence detail
  /// page needs to say "this row was emitted, it was not uploaded".
  @@index([tenantId, evidenceId])
}
