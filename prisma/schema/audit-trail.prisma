// ─────────────────────────────────────────────────────────────────
//  AUDIT TRAIL — the platform's hash-chained immutable event log.
//
//  Owns:
//    • AuditLog     — per-tenant hash-chained trail (Epic A.1)
//    • OrgAuditLog  — org-scoped equivalent (Epic B)
//
//  THIS IS NOT THE COMPLIANCE-AUDIT DOMAIN. Everything an auditor
//  touches — cycles, packs, share links, readiness scores — lives in
//  `audit-workflow.prisma`. The two were one file, and the collision
//  cost comprehension rather than correctness: no wrong import or
//  misdirected repository call was ever found, but any question about
//  "audit" returned a mixed answer, because half the answer was about
//  a tamper-evident log and half was about an ISO 27001 engagement.
//  Split 2026-08-10 — a pure reorg, same shape as the 2026-07-10
//  compliance.prisma split. Models are deliberately NOT renamed; the
//  churn would exceed the benefit.
//
//  AuditLog policy:
//    • Append-only at the application layer (`logEvent`). Direct
//      writes are blocked by guard tests and DB triggers.
//    • Hash-chained (each row's hash includes the previous row's
//      hash). Schema changes here MUST preserve the chain layout.
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id                  String               @id @default(cuid())
  tenantId            String
  userId              String?
  entity              String
  entityId            String
  action              String
  details             String?
  createdAt           DateTime             @default(now())
  metadataJson        Json?
  recordIds           Json?
  requestId           String?
  diffJson            Json?
  actorType           String               @default("USER")
  detailsJson         Json?
  entryHash           String?
  previousHash        String?
  version             Int                  @default(1)
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
  /// Verified agent-action receipts linked to this hash-chained entry (Epic:
  /// agent-action-receipts). Back-relation only — adds no column to AuditLog.
  agentActionReceipts AgentActionReceipt[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
  @@index([tenantId, action])
  @@index([tenantId, entryHash])

  /// #2356 batch 3 — the composite an FK from a tenant-scoped child
  /// references. `id` alone is already unique; this exists so Postgres
  /// will accept ([childFk, tenantId]) -> ([id, tenantId]), which is what
  /// makes a cross-tenant reference unrepresentable rather than merely
  /// filtered.
  @@unique([id, tenantId])
}

// ─────────────────────────────────────────────────────────────────
// Epic B — Org Audit Trail & Compliance Integrity (SOC 2 CC6.1)
//
// Immutable, hash-chained ledger for org-level privilege changes.
// Distinct from AuditLog because:
//   • org events are NOT tenant-scoped — AuditLog requires tenantId
//     and uses a per-tenant chain anchored on
//     pg_advisory_xact_lock(hashtext(tenantId)). Forcing tenantId
//     nullable to host org events would break the load-bearing
//     chain semantics, the audit-stream batching, and the tenant
//     RLS policies on AuditLog.
//   • org chain is per-organization (one chain per org), keyed
//     independently from tenant chains.
//
// Append-only:
//   • DB trigger forbids UPDATE/DELETE (mirrors AuditLog).
//   • REVOKE UPDATE,DELETE FROM app_user; GRANT SELECT,INSERT.
//
// Hash chain:
//   • SHA-256(canonical(actorType, actorUserId, action, detailsJson,
//     occurredAt, organizationId, previousHash, targetUserId, version))
//   • previousHash links to entryHash of the prior row in this org's
//     chain. First entry per org has previousHash = null.
//
// Action taxonomy (OrgAuditAction enum):
//   ORG_MEMBER_ADDED                   — addOrgMember
//   ORG_MEMBER_REMOVED                 — removeOrgMember
//   ORG_MEMBER_ROLE_CHANGED            — changeOrgMemberRole
//   ORG_ADMIN_PROVISIONED_TO_TENANTS   — fan-out summary (one row,
//                                        not per tenant noise)
//   ORG_ADMIN_DEPROVISIONED_FROM_TENANTS — fan-in summary
//
// Provisioning fan-out is summarized as ONE org audit row carrying
// `{ tenantCount, tenantIds[], role: 'AUDITOR' }` in detailsJson.
// Per-tenant rows still land in AuditLog (existing behaviour) so
// each tenant's own ledger remains complete.

model OrgAuditLog {
  id             String         @id @default(cuid())
  organizationId String
  actorUserId    String?
  actorType      String         @default("USER")
  action         OrgAuditAction
  targetUserId   String?
  detailsJson    Json?
  requestId      String?
  occurredAt     DateTime       @default(now())
  entryHash      String
  previousHash   String?
  version        Int            @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("OrgAuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?        @relation("OrgAuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, action])
  @@index([organizationId, entryHash])
}

// ─────────────────────────────────────────────────────────────────
// #2657 — the audit trail's durable fallback
//
// A denial can be refused, the user told, and the AUTHZ_DENIED row
// silently lost, because the write was wrapped in a catch that logged
// and returned. A missing security audit row is worse than a failed
// request: a failed request is visible to the user and to error
// monitoring, a missing row is visible to nobody.
//
// This table is the "durable before the response" half. A caller that
// cannot reach the hash chain writes HERE instead, and the row is
// drained onto the chain out-of-band by `audit-outbox-flush`. The
// caller only fails closed if BOTH writes fail, which is a database
// outage rather than the lock contention #2653 describes.
//
// WHY THIS IS MORE AVAILABLE THAN THE THING IT BACKS UP: appendAuditEntry
// takes a per-tenant pg_advisory_xact_lock INSIDE its transaction, so
// concurrent appends for one tenant serialise and the last can fail to
// START. This insert takes no lock and contends with nothing, so the
// failure modes are genuinely different rather than merely retried.
// ─────────────────────────────────────────────────────────────────
model AuditOutbox {
  id       String @id @default(cuid())
  tenantId String

  /// The `AppendAuditInput` exactly as the caller built it. Stored whole
  /// rather than as columns: the drain must reproduce the caller's intent,
  /// and a column set would silently drop any field added to the input
  /// type later.
  payloadJson Json

  /// When the EVENT happened — not when the row was written, and not when
  /// it was drained.
  ///
  /// This is the field that makes a drained entry honest.
  /// `appendAuditEntry` stamps `createdAt` itself, AFTER taking the lock,
  /// because strictly-monotonic ordering per tenant is what the lock buys.
  /// A drained entry therefore lands on the chain stamped at DRAIN time.
  /// That is correct for the chain and wrong for the reader, so the drain
  /// carries this value into the entry's `detailsJson.occurredAt`. The
  /// chain says when it was recorded; the payload says when it happened.
  occurredAt DateTime

  /// Denormalised from `payloadJson` so an operator can ask "how many
  /// AUTHZ_DENIED are stuck?" without parsing every payload.
  action String

  status        AuditOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?
  nextAttemptAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  appliedAt     DateTime?

  /// The `AuditLog.id` this became, once drained. Present only when
  /// status is APPLIED — the link that lets an auditor confirm a queued
  /// denial actually reached the chain.
  appliedAuditId String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// NO `dedupeKey`, deliberately — the one place this model departs from
  /// `NotificationOutbox`, which has a unique one.
  ///
  /// Two identical denials a second apart are two real security events.
  /// Email dedupes because sending twice is worse than sending once; the
  /// audit trail is the opposite, because failing to record one is worse
  /// than recording both. A unique key here would silently drop the
  /// second — the exact defect #2657 exists to remove, reintroduced in a
  /// constraint.
  @@index([status, nextAttemptAt])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, action, status])
}
