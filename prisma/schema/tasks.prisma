// tasks.prisma — Generic work-item aggregate (Task) + its owned children.
// Split from compliance.prisma (2026-07-10) — pure reorg, no datamodel change.
// Enums live in enums.prisma; relations resolve across the schema folder.

model Task {
  id                        String               @id @default(cuid())
  tenantId                  String
  type                      TaskType             @default(TASK)
  title                     String
  description               String?
  severity                  TaskSeverity         @default(MEDIUM)
  priority                  TaskPriority         @default(P2)
  status                    TaskStatus           @default(OPEN)
  source                    TaskSource?          @default(MANUAL)
  /// The template task this was installed from, when it was.
  ///
  /// Null for a hand-written task and for every task installed BEFORE this
  /// column existed — those are permanently unidentifiable, because no
  /// install path ever set `source` either, so they are indistinguishable
  /// from user-written work. That is why this ships now rather than being
  /// inferred later.
  templateTaskId            String?
  /// Authored steps, per-item done state. See TaskChecklistSchema.
  checklistJson             Json?
  key                       String?
  resolution                String?
  dueAt                     DateTime?
  completedAt               DateTime?
  createdByUserId           String
  assigneeUserId            String?
  reviewerUserId            String?
  controlId                 String?
  // TP-3 — first-class relation to the Finding a remediation task
  // reflects (replaces the prior `metadataJson.findingId` string).
  // SetNull on finding delete so closing/deleting a finding never
  // orphans the task row. Materializers (audit checklist, NIS2 gap)
  // set this on create; `reconcileTaskSource` reads it to close the
  // finding when the task reaches a terminal RESOLVED/CLOSED state.
  findingId                 String?
  metadataJson              Json?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deletedAt                 DateTime?
  deletedByUserId           String?
  retentionUntil            DateTime?
  assignee                  User?                @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  control                   Control?             @relation(fields: [controlId], references: [id])
  finding                   Finding?             @relation("FindingTasks", fields: [findingId], references: [id], onDelete: SetNull)
  createdBy                 User                 @relation("TaskCreator", fields: [createdByUserId], references: [id])
  reviewer                  User?                @relation("TaskReviewer", fields: [reviewerUserId], references: [id])
  tenant                    Tenant               @relation(fields: [tenantId], references: [id])
  comments                  TaskComment[]
  links                     TaskLink[]
  watchers                  TaskWatcher[]
  // Vulnerabilities whose remediation this task drives (triage flow).
  // `AssetVulnerability.remediationTaskId` → SetNull on task delete.
  remediatedVulnerabilities AssetVulnerability[] @relation("VulnerabilityRemediation")
  // Evidence attached directly to this task — the task Evidence tab
  // mirrors the control Evidence tab. `Evidence.taskId` is the source
  // pointer that also powers the "uploaded from" back-reference on the
  // evidence detail surface.
  evidence                  Evidence[]

  @@unique([tenantId, key])
  // B3-5 — the bare `@@index([tenantId])` was dropped: it is a strict
  // prefix of `@@unique([tenantId, key])` and of all eleven composites
  // below, so the planner can always serve a `tenantId`-only predicate
  // from one of those leading columns. Same reasoning as the
  // `[tenantId, dueAt]` drop recorded further down.
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, severity])
  @@index([tenantId, assigneeUserId])
  @@index([tenantId, controlId])
  // TP-3 — FK-index for the Finding relation (Layer B) + the
  // "tasks for this finding" lookup used by reconciliation.
  @@index([tenantId, findingId])
  /// tenantId-leading like all ten of its neighbours — Layer B accepts a
  /// `[tenantId, fk]` composite, and a bare `[templateTaskId]` would be the
  /// only non-tenant-leading index on this model.
  @@index([tenantId, templateTaskId])
  // #102 item 4 — the control-detail Tasks tab filters by both
  // controlId AND status; this composite serves that hot path.
  @@index([tenantId, controlId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, priority, createdAt])
  // #102 item 4 — `[tenantId, dueAt]` dropped: it is a strict
  // prefix of `[tenantId, dueAt, status]` below, so the planner
  // never needs both.
  @@index([tenantId, dueAt, status])
}

/// Per-tenant monotonic counter for minting `TSK-N` work-item keys.
///
/// #102 item 2 — replaces the `db.task.count()` derivation in
/// `WorkItemRepository.create`, which raced against the unique
/// `[tenantId, key]` index under concurrent imports and scaled
/// linearly with tenant size. `upsert` with an atomic `increment`
/// (native `INSERT … ON CONFLICT DO UPDATE`) is race-free.
///
/// RLS: tenant-scoped (Class A — `tenant_isolation` USING +
/// `tenant_isolation_insert` WITH CHECK + `superuser_bypass`,
/// `FORCE ROW LEVEL SECURITY`). See the companion migration.
model TaskKeySequence {
  tenantId  String @id
  lastValue Int    @default(0)
}

model TaskLink {
  id         String             @id @default(cuid())
  tenantId   String
  taskId     String
  entityType TaskLinkEntityType
  entityId   String
  relation   TaskLinkRelation   @default(RELATES_TO)
  createdAt  DateTime           @default(now())
  task       Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant     Tenant             @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, taskId, entityType, entityId])
  @@index([tenantId, taskId])
  @@index([tenantId, entityType, entityId])
}

model TaskComment {
  id              String   @id @default(cuid())
  tenantId        String
  taskId          String
  body            String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User     @relation("TaskCommentCreator", fields: [createdByUserId], references: [id])
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, taskId])
}

model TaskWatcher {
  id       String @id @default(cuid())
  tenantId String
  taskId   String
  userId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([tenantId, taskId])
}
