// Hub-and-spoke organization layer (Epic O-1).
//
// An Organization is the parent of N tenants (typical: 100 solution-
// owner tenants per CISO portfolio). Org-level members come in two
// roles: ORG_ADMIN (CISO-class — gets auto-provisioned AUDITOR
// membership in every child tenant via the Epic O-2 service) and
// ORG_READER (portfolio-only, no per-tenant access).
//
// Slug is unique across the whole system, parallel to Tenant.slug.
// URL paths are `/org/{slug}` and `/t/{slug}` — the namespaces don't
// collide because the prefixes differ.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants                      Tenant[]
  memberships                  OrgMembership[]
  invites                      OrgInvite[]
  provisionedTenantMemberships TenantMembership[]      @relation("OrgProvisionedTenantMemberships")
  auditLogs                    OrgAuditLog[]
  dashboardWidgets             OrgDashboardWidget[]
  threatLevels                 OrgThreatLevel[]
  maturityRatings              OrgMaturityRating[]
  securityInitiatives          OrgSecurityInitiative[]
  initiativeLinks              OrgInitiativeLink[]
}

// Per-user, per-org role assignment.
//
// Two roles in the OrgRole enum: ORG_ADMIN, ORG_READER. ADMIN
// becoming a member triggers the Epic O-2 auto-provisioning service
// which creates an AUDITOR `TenantMembership` in every child tenant
// (idempotent — skips users who already have a manual membership).
//
// Removing an ORG_ADMIN triggers the deprovisioning service which
// deletes only auto-created memberships (the ones with
// `provisionedByOrgId` matching this org); manually-granted
// memberships are preserved.
model OrgMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(ORG_READER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// Epic D — invitation-gated org onboarding.
//
// Mirrors the TenantInvite model exactly (same field set, same
// lifecycle semantics) so admins can issue an invite to an email,
// the recipient lands on /invite/org/<token>, signs in via OAuth,
// and the auth callback redeems the invite to create their
// OrgMembership atomically.
//
// Lifecycle:
//   • createOrgInviteToken upserts on (organizationId, email),
//     refreshing the token + expiresAt and clearing acceptedAt /
//     revokedAt on re-invite.
//   • redeemOrgInvite uses an updateMany test-and-set on
//     {token, acceptedAt: null, revokedAt: null, expiresAt: { gt: now }}
//     so concurrent redemptions can't double-claim; email-mismatch
//     burns the token (acceptedAt is set in the same atomic claim).
//   • revokeOrgInvite sets revokedAt = now(); the row stays in place
//     for audit history.
//
// Token: 32 random bytes, base64url-encoded, stored raw with
// @unique. No HMAC — the entropy (256 bits) is the security
// boundary. A 7-day TTL is enforced on creation.
model OrgInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole   @default(ORG_READER)
  token          String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrgInviteInviter", fields: [invitedById], references: [id])

  @@unique([organizationId, email])
  @@index([token])
  @@index([organizationId])
}

// Epic 41 — Configurable Dashboard Widget Engine.
//
// Persists the widget composition of the org-level dashboard at
// `/org/[orgSlug]`. Each row is one widget rendered on the portfolio
// overview: a KPI tile, RAG donut, risk-trend chart, tenant-coverage
// list, or drill-down CTA group. The frontend renders strictly from
// these rows — the backend enforces shape via Zod at the API layer.
//
// Org-scoped (NOT tenant-scoped). Same shape as OrgInvite /
// OrgMembership / OrgAuditLog: `organizationId` is the foreign key,
// the global postgres role serves the queries, isolation is enforced
// by `getOrgCtx` resolving the user's OrgMembership before the
// usecase runs. Not in TENANT_SCOPED_MODELS.
//
// Position + size + config are stored as JSON. The DB enforces
// nothing about their internal shape — that's deliberate so a new
// widget type doesn't require a migration. The Zod schemas in
// `src/app-layer/schemas/org-dashboard-widget.schemas.ts` lock the
// shape per (type, chartType) and the API layer rejects payloads
// that don't fit.
model OrgDashboardWidget {
  id             String                 @id @default(cuid())
  organizationId String
  type           OrgDashboardWidgetType
  /// Sub-variant within a `type` (e.g. for KPI: 'coverage' /
  /// 'critical-risks' / 'overdue-evidence' / 'tenants'). Free-form
  /// at the schema layer; the Zod map narrows valid values per type.
  chartType      String
  /// Optional human-readable title. When null the frontend uses
  /// the widget's default title for the (type, chartType) pair.
  title          String?
  /// Per-(type, chartType) config. Locked by Zod at the API
  /// boundary; storing as JSON keeps the model open to new widget
  /// types without migrations.
  config         Json
  /// Grid position { x: int, y: int } — top-left in the
  /// react-grid-layout coordinate system.
  position       Json
  /// Grid size { w: int, h: int } — width and height in grid cells.
  size           Json
  /// True (default) renders the widget; false hides it without
  /// deleting the row, preserving position so re-enabling is
  /// non-destructive.
  enabled        Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Org-wide, human-curated threat posture (concept ported from
/// Cybether, MIT — the idea, not the code). ORG-SCOPED like the other
/// org-* models: global prisma, organizationId filter, NOT in
/// TENANT_SCOPED_MODELS, so no per-tenant RLS / Epic-B tenant-DEK
/// applies (that machinery is tenant-keyed). One org → one current
/// posture; rows are append-only history. Current = most recent by
/// setAt. `summary`/`detail` are org-internal curated text, sanitised
/// at the usecase layer (org models have no per-tenant DEK).
model OrgThreatLevel {
  id             String        @id @default(cuid())
  organizationId String
  level          OrgThreatTier
  /// Curated headline (sanitised).
  summary        String
  /// Optional longer context (sanitised).
  detail         String?
  /// Opaque actor id (no User FK — keeps this append-only org log
  /// independent of user-lifecycle cascades; the display name is
  /// resolved in the usecase).
  setByUserId    String
  setAt          DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Current = ORDER BY setAt DESC LIMIT 1; history = the full set.
  @@index([organizationId, setAt])
}

/// Org-wide, self-assessed SECURITY MATURITY rating per NIST CSF 2.0
/// function (concept ported from Cybether, MIT). A judgment-based CMM
/// level (1..5) per capability domain — DISTINCT from derived control
/// coverage % (coverage = "how many controls have evidence"; maturity =
/// "how good are we, by professional judgment"). ORG-scoped like the
/// other org-* models (global prisma, organizationId, NOT
/// TENANT_SCOPED_MODELS → no per-tenant RLS / tenant-DEK). Append-only:
/// current per domain = most-recent by ratedAt; the series IS the trend.
/// Modelled per-(org, domain) so a future per-tenant overlay is additive.
model OrgMaturityRating {
  id             String         @id @default(cuid())
  organizationId String
  domain         MaturityDomain
  level          MaturityLevel
  /// Judgment context (sanitised at the usecase layer).
  rationale      String?
  /// Opaque actor id (no User FK — keeps the append-only log
  /// independent of user-lifecycle cascades; name resolved in usecase).
  ratedByUserId  String
  ratedAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Current per domain = ORDER BY ratedAt DESC LIMIT 1; trend = the series.
  @@index([organizationId, domain, ratedAt])
}

/// Portfolio-level SECURITY INITIATIVE / programme (concept ported from
/// Cybether, MIT). A discrete, named improvement effort the org tracks
/// across its tenants ("Roll out MFA org-wide", "Achieve SOC 2") with its
/// own lifecycle + progress — DISTINCT from atomic tenant remediation
/// (the unified Task). ORG-scoped (global prisma, NOT TENANT_SCOPED_MODELS,
/// no per-tenant RLS / DEK). `description` sanitised at the usecase.
model OrgSecurityInitiative {
  id                    String           @id @default(cuid())
  organizationId        String
  title                 String
  description           String?
  status                InitiativeStatus @default(PLANNED)
  ownerUserId           String?
  targetDate            DateTime?
  /// When set, overrides the derived (linked-work) progress. Null = derive.
  manualProgressPercent Int?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  links        OrgInitiativeLink[]

  @@index([organizationId, status])
  @@index([organizationId, targetDate])
}

/// Link from an initiative to a piece of tenant-level work. CROSS-TENANT:
/// an initiative can link work in ANY tenant the org owns. Stores both the
/// tenantId and the entity ref so the progress rollup can resolve
/// completion through the sanctioned cross-tenant read path (withTenantDb
/// per tenant — never bypassing tenant isolation).
model OrgInitiativeLink {
  id             String @id @default(cuid())
  initiativeId   String
  organizationId String
  /// Which tenant the linked work lives in (a REFERENCE, not a
  /// tenant-isolation column — this model is org-scoped, not
  /// tenant-scoped; named linkedTenantId so it isn't auto-detected as
  /// RLS-isolated tenant data).
  linkedTenantId String
  /// 'CONTROL' | 'RISK' | 'TASK' | 'FINDING'.
  entityType     String
  entityId       String

  initiative   OrgSecurityInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, linkedTenantId, entityType, entityId])
  @@index([organizationId, initiativeId])
}

model TenantOnboarding {
  id             String           @id @default(cuid())
  tenantId       String           @unique
  status         OnboardingStatus @default(NOT_STARTED)
  currentStep    String           @default("COMPANY_PROFILE")
  completedSteps String[]         @default([])
  stepData       Json             @default("{}")
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
}

/// Tenant-scoped custom role with granular permission overrides.
/// Coexists with the built-in Role enum (ADMIN/EDITOR/READER/AUDITOR).
/// When a TenantMembership has a customRoleId, the permissionsJson from
/// this model takes precedence over the enum-based defaults for UI gating.
/// Backend authorization should merge/override accordingly.
model TenantCustomRole {
  id              String             @id @default(cuid())
  tenantId        String
  name            String /// Display name, e.g. "Compliance Lead"
  description     String? /// Optional description of the role's purpose
  baseRole        Role               @default(READER) /// Fallback enum role for coarse checks
  permissionsJson Json /// Typed PermissionSet — see src/lib/permissions.ts
  isActive        Boolean            @default(true) /// Soft-disable without deleting assignments
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  memberships     TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

/// Tenant-scoped API keys for machine-to-machine authentication.
/// Keys are stored as SHA-256 hashes — the plaintext is shown only once at creation.
/// Supports expiry, revocation, scope restrictions, and last-used tracking.
model TenantApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String /// Human-friendly label, e.g. "CI/CD Pipeline"
  keyPrefix   String /// First 8 chars of the plaintext key (for identification)
  keyHash     String /// SHA-256 hash of the full plaintext key
  scopes      Json      @default("[]") /// JSON array of scope strings, e.g. ["controls:read","evidence:write"]
  expiresAt   DateTime? /// Optional expiry — null = no expiry
  revokedAt   DateTime? /// Non-null = revoked
  lastUsedAt  DateTime? /// Updated on each successful auth
  lastUsedIp  String? /// IP of last auth request
  createdById String /// User who created this key
  /// The registered agent this credential speaks for, when it speaks for one.
  ///
  /// NULLABLE, and the null is the whole point: most keys are integrations, not
  /// agents, and binding every key to an agent would make the register a lie.
  /// What a null MEANS depends on the traffic — for `/api/mcp` it means
  /// UNREGISTERED, and `TenantSecuritySettings.requireRegisteredAgent` decides
  /// whether that is refused.
  ///
  /// The binding lives on the KEY, not on the agent, because rotation is the
  /// normal case: an agent needs a new credential while the old one is still
  /// alive, so the relation has to be many-keys-to-one-agent. A single
  /// `apiKeyId` on `RegisteredAgent` would make every rotation a window in
  /// which the agent is unregistered.
  ///
  /// Composite FK to (id, tenantId) so a key can never name another tenant's
  /// agent. `onDelete: Restrict` — a registered agent with live credentials
  /// cannot be deleted out from under them; retire it instead.
  agentId     String?
  /// The HIGHEST rung on the 0-6 agent-autonomy ladder this credential may
  /// exercise — the same ladder as `RegisteredAgent.autonomyLevel`.
  ///
  /// The effective ceiling for a call is `min(this, the agent's own level)`, so
  /// a key can only ever NARROW what its agent may do. That direction is the
  /// point: without it, authority belonged to whoever held the key, and a
  /// credential minted for a read-only integration could drive an agent's full
  /// autonomy simply by carrying the right scopes.
  ///
  /// NULL means NO KEY-LEVEL NARROWING, not "deny" — the agent term is always
  /// present for an agent-bound key, so the ceiling is still bounded. That is
  /// the OPPOSITE of `RegisteredAgent.riskTier`, where NULL means UNSCORED and
  /// must be read as deny: an absent narrowing is not an absent assessment.
  ///
  /// A CHECK constraint pins the range AND refuses a value on a key bound to no
  /// agent: a ceiling with no agent term to min against is exactly the state
  /// this column exists to end, so it is unrepresentable rather than merely
  /// discouraged.
  maxAutonomyLevel Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdBy   User      @relation("ApiKeyCreator", fields: [createdById], references: [id])
  agent       RegisteredAgent? @relation(fields: [agentId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([keyHash])
  @@index([tenantId])
  @@index([tenantId, revokedAt])
  @@index([tenantId, agentId])
}

/// A per-tenant device-agent token (PR-5). Authenticates POST /devices/report
/// so an endpoint agent can push its posture without a user session. Cloned
/// from TenantApiKey — SHA-256 token hash at rest, single-use lookup by hash.
model TenantDeviceToken {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  tokenPrefix String
  tokenHash   String
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdBy   User      @relation("DeviceTokenCreator", fields: [createdById], references: [id])

  @@unique([tokenHash])
  @@index([tenantId])
  @@index([tenantId, revokedAt])
}

/// PR-7 — a decision row for an access review whose scope is CONNECTED_APP.
/// Parallel to AccessReviewDecision but the subject is a ConnectedIdentityAccount
/// (Okta / Google Workspace), not a TenantMembership. Kept separate so the
/// mature membership-review model is untouched. The entitlement is frozen into
/// snapshotJson at creation; REVOKE emits a remediation task on close.
model AccessReviewConnectedDecision {
  id                 String  @id @default(cuid())
  tenantId           String
  accessReviewId     String
  /// FK to the connected account under review (SetNull so a deprovision
  /// mid-review doesn't shred the audit row — snapshotJson preserves it).
  connectedAccountId String?
  /// Frozen identity for the evidence record: provider + email + admin/mfa.
  subjectRef         String
  snapshotJson       Json

  decision        AccessReviewDecisionType?
  decidedAt       DateTime?
  decidedByUserId String?
  notes           String?

  executedAt       DateTime?
  executedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  accessReview AccessReview              @relation(fields: [accessReviewId, tenantId], references: [id, tenantId], onDelete: Cascade)
  account      ConnectedIdentityAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  decidedBy    User?                     @relation("ConnectedDecisionDecider", fields: [decidedByUserId], references: [id])

  @@unique([accessReviewId, subjectRef])
  @@index([tenantId])
  @@index([tenantId, accessReviewId])
}

model TenantMembership {
  id                    String                 @id @default(cuid())
  tenantId              String
  userId                String
  role                  Role                   @default(READER)
  customRoleId          String? /// Optional FK to TenantCustomRole for granular overrides
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deactivatedAt         DateTime?
  invitedAt             DateTime?
  invitedByUserId       String?
  status                MembershipStatus       @default(ACTIVE)
  /// Hub-and-spoke (Epic O-1). When non-NULL, this membership was
  /// auto-created by the org auto-provisioning service in response to
  /// the user gaining ORG_ADMIN on the named Organization. The
  /// deprovisioning service deletes ONLY rows with this column set,
  /// so manually-granted ADMIN/EDITOR/READER/AUDITOR memberships
  /// survive an ORG_ADMIN removal.
  ///
  /// NULL = manually created (the historical default, preserved for
  /// every membership that existed before the org layer landed).
  ///
  /// ON DELETE SET NULL on the Organization FK so deleting the parent
  /// org doesn't delete the auto-provisioned memberships — they
  /// transition to "manually created" semantics and are kept.
  /// (The deprovision usecase is the canonical cleanup path; the FK
  /// rule is referential-integrity defence-in-depth.)
  provisionedByOrgId    String?
  customRole            TenantCustomRole?      @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  invitedBy             User?                  @relation("MembershipInviter", fields: [invitedByUserId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  provisionedByOrg      Organization?          @relation("OrgProvisionedTenantMemberships", fields: [provisionedByOrgId], references: [id], onDelete: SetNull)
  // Epic G-4 — historical decisions reviewing this membership.
  // SetNull on cascade so a membership delete doesn't erase the
  // audit trail; the decision row keeps its frozen subjectUserId +
  // snapshotRole fields and stays evidence-quality.
  accessReviewDecisions AccessReviewDecision[] @relation("AccessReviewDecisionMembership")

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  /// Answers "which tenants does THIS user belong to" without a scan.
  /// `@@unique([tenantId, userId])` cannot: `userId` is its second
  /// column, so a user-first lookup falls back to a sequential scan of
  /// every membership in the deployment. The avatar serve route
  /// (#2104) asks that question on a per-image hot path, and
  /// `getDefaultTenantForUser`, the security-events reader and the
  /// SCIM membership lookups all asked it already.
  @@index([userId, status])
  @@index([customRoleId])
  @@index([provisionedByOrgId])
}

// ─────────────────────────────────────────────────────────────────
// Epic G-4 — Access Review Campaigns (SOC 2 CC6.2).
//
// Periodic certification that the right humans have the right access
// to the right tenants. An auditor's first ask in any SOC 2 Type II
// cycle is: "show me the most recent user access review and the
// signed-off decisions". The shape is deliberately campaign-flavored
// (ramp from AuditCycle), not a checklist:
//
//   • AccessReview is the campaign root. It carries the scope, the
//     review window, the reviewer identity, the deadline, and the
//     final closure timestamp.
//   • AccessReviewDecision is one row per subject user, snapshotted
//     at campaign creation (see scope semantics on AccessReviewScope).
//     It records the role/status the user had AT SNAPSHOT, the
//     reviewer's CONFIRM/REVOKE/MODIFY decision, and the eventual
//     execution timestamp when the decision is applied to the
//     underlying TenantMembership.
//
// Snapshotting is what makes the schema audit-ready: a row's
// `snapshotRole` is frozen at creation. If the membership is later
// modified or deleted (e.g. user offboarded mid-review), the
// decision row remains a faithful record of what the reviewer
// considered.
//
// Tenant isolation: both tables are Class-A direct-scoped (own
// `tenantId` column). RLS migration adds the canonical
// tenant_isolation + tenant_isolation_insert + superuser_bypass
// policies and FORCE ROW LEVEL SECURITY.
// ─────────────────────────────────────────────────────────────────

model AccessReview {
  id                   String             @id @default(cuid())
  tenantId             String
  name                 String
  description          String?
  /// Decides which memberships seed the AccessReviewDecision rows
  /// at creation. CUSTOM means the creator passes an explicit list
  /// of subject memberships; the resulting decision rows are still
  /// the authoritative scope record regardless of source.
  scope                AccessReviewScope  @default(ALL_USERS)
  /// Window the campaign covers. Used in evidence headers — auditors
  /// want "the access review for Q1 2026" not "the access review
  /// created on 2026-04-30".
  periodStartAt        DateTime?
  periodEndAt          DateTime?
  /// Single primary reviewer per campaign. Multi-reviewer campaigns
  /// are a future extension; today the API restricts decision-write
  /// to this user.
  reviewerUserId       String
  status               AccessReviewStatus @default(OPEN)
  dueAt                DateTime?
  closedAt             DateTime?
  closedByUserId       String?
  /// Set at closeout to the FileRecord holding the signed PDF
  /// evidence artifact for this campaign. Nullable because:
  ///   • OPEN / IN_REVIEW campaigns have no evidence yet.
  ///   • Closeout PDF generation can fail after decisions execute
  ///     (partial-failure path); the campaign stays CLOSED with
  ///     this null and an operator-triggered regenerate path will
  ///     populate it.
  /// SetNull on FileRecord delete so a stray evidence delete
  /// doesn't shred the campaign row.
  evidenceFileRecordId String?
  createdByUserId      String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  deletedByUserId      String?

  tenant             Tenant                          @relation(fields: [tenantId], references: [id])
  reviewer           User                            @relation("AccessReviewReviewer", fields: [reviewerUserId], references: [id])
  createdBy          User                            @relation("AccessReviewCreator", fields: [createdByUserId], references: [id])
  closedBy           User?                           @relation("AccessReviewCloser", fields: [closedByUserId], references: [id])
  deletedBy          User?                           @relation("AccessReviewDeleter", fields: [deletedByUserId], references: [id])
  evidenceFile       FileRecord?                     @relation("AccessReviewEvidence", fields: [evidenceFileRecordId], references: [id], onDelete: SetNull)
  decisions          AccessReviewDecision[]
  connectedDecisions AccessReviewConnectedDecision[]

  /// Composite parent key used by AccessReviewDecision's compound FK
  /// (the same denorm-tenantId pattern Phase 2 introduced for
  /// AuditChecklistItem → Audit).
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, reviewerUserId, status])
  @@index([tenantId, dueAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId, createdAt])
}

model AccessReviewDecision {
  id                       String           @id @default(cuid())
  tenantId                 String
  accessReviewId           String
  /// Live FK to TenantMembership. SetNull on delete so an offboard
  /// during the review window doesn't shred the audit row — the
  /// snapshot fields below preserve the evidentiary record.
  membershipId             String?
  /// Frozen subject identity. Even if the membership row vanishes,
  /// the decision still names a real user.
  subjectUserId            String
  /// Snapshot of the membership's role + status at the moment the
  /// decision row was written. Reviewers decide against the snapshot,
  /// not against whatever the live membership currently looks like.
  snapshotRole             Role
  snapshotCustomRoleId     String?
  snapshotMembershipStatus MembershipStatus
  snapshotAt               DateTime         @default(now())

  /// Null = reviewer has not yet decided.
  decision        AccessReviewDecisionType?
  decidedAt       DateTime?
  decidedByUserId String?
  /// Free-text reviewer rationale. SOC 2 evidence — recommended for
  /// REVOKE / MODIFY, optional for CONFIRM.
  notes           String?

  /// MODIFY decisions specify a target role. Null on CONFIRM/REVOKE.
  modifiedToRole         Role?
  modifiedToCustomRoleId String?

  /// Set when the decision has been applied to the live
  /// TenantMembership (REVOKE → deactivate, MODIFY → role change,
  /// CONFIRM → no-op marker). Phase 1 leaves these null; the
  /// follow-up usecase populates them.
  executedAt       DateTime?
  executedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  accessReview AccessReview      @relation(fields: [accessReviewId, tenantId], references: [id, tenantId], onDelete: Cascade)
  membership   TenantMembership? @relation("AccessReviewDecisionMembership", fields: [membershipId], references: [id], onDelete: SetNull)
  subjectUser  User              @relation("AccessReviewDecisionSubject", fields: [subjectUserId], references: [id])
  decidedBy    User?             @relation("AccessReviewDecisionDecider", fields: [decidedByUserId], references: [id])
  executedBy   User?             @relation("AccessReviewDecisionExecutor", fields: [executedByUserId], references: [id])

  /// One decision row per (campaign, subject user). Anchored on
  /// subjectUserId rather than membershipId so a membership that's
  /// deleted-and-recreated mid-campaign still has exactly one
  /// logical decision record.
  @@unique([accessReviewId, subjectUserId])
  @@index([tenantId, accessReviewId])
  @@index([tenantId, accessReviewId, decision])
  @@index([tenantId, subjectUserId])
  @@index([tenantId, membershipId])
}

model User {
  id                            String                          @id @default(cuid())
  // GAP-21: `email` and `name` are stored encrypted at rest. The
  // schema field names map to the encrypted DB columns; the
  // pii-middleware encrypts on write and decrypts on read so
  // callers continue to pass plaintext at the API boundary.
  // `emailHash` carries the deterministic lookup hash and is the
  // sole uniqueness anchor.
  //
  // emailHash is declared optional at the schema/TS level so callers
  // who don't pass it explicitly type-check (the middleware
  // populates it from `email` on every write). The DB column is
  // NOT NULL — enforced by migration
  // 20260429000000_gap21_drop_pii_plaintext_columns + the
  // structural ratchet at
  // tests/guardrails/pii-hash-not-null.test.ts. The schema-DB
  // drift on this single field is intentional and documented.
  email                         String                          @map("emailEncrypted")
  emailHash                     String?                         @unique
  passwordHash                  String?
  name                          String?                         @map("nameEncrypted")
  emailVerified                 DateTime?
  image                         String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  sessionVersion                Int                             @default(0)
  accounts                      Account[]
  ownedKris                     KeyRiskIndicator[]              @relation("KriOwner")
  ownedAssets                   Asset[]                         @relation("AssetOwner")
  ownedAssetVulnerabilities     AssetVulnerability[]            @relation("AssetVulnerabilityOwner")
  assetRiskLinksCreated         AssetRiskLink[]                 @relation("AssetRiskCreator")
  findingAssetsCreated          FindingAsset[]                  @relation("FindingAssetCreator")
  auditCyclesCreated            AuditCycle[]
  auditLogs                     AuditLog[]
  auditPacksFrozen              AuditPack[]                     @relation("AuditPackFrozenBy")
  auditSharesCreated            AuditPackShare[]
  auditShareCommentsResolved    AuditPackShareComment[]         @relation("AuditPackShareCommentResolvedBy")
  controlApplicabilityDecisions Control[]                       @relation("ControlApplicabilityDecider")
  createdControls               Control[]                       @relation("ControlCreator")
  ownedControls                 Control[]                       @relation("ControlOwner")
  assignedFindings              Finding[]                       @relation("FindingAssignee")
  controlAssetsCreated          ControlAsset[]                  @relation("ControlAssetCreator")
  controlContributions          ControlContributor[]
  controlEvidenceLinksCreated   ControlEvidenceLink[]           @relation("ControlEvidenceCreator")
  evidenceControlLinksCreated   EvidenceControlLink[]           @relation("EvidenceControlLinkCreator")
  evidenceRiskLinksCreated      EvidenceRiskLink[]              @relation("EvidenceRiskLinkCreator")
  evidenceAssetLinksCreated     EvidenceAssetLink[]             @relation("EvidenceAssetLinkCreator")
  testEvidenceLinksCreated      ControlTestEvidenceLink[]       @relation("TestEvidenceCreator")
  createdTestPlans              ControlTestPlan[]               @relation("TestPlanCreator")
  ownedTestPlans                ControlTestPlan[]               @relation("TestPlanOwner")
  createdTestRuns               ControlTestRun[]                @relation("TestRunCreator")
  executedTestRuns              ControlTestRun[]                @relation("TestRunExecutor")
  evidenceReviews               EvidenceReview[]
  ownedEvidence                 Evidence[]                      @relation("EvidenceOwner")
  ownedBias                     BusinessImpactAnalysis[]        @relation("BiaOwner")
  vendorDocExtractionsCreated   VendorDocExtraction[]           @relation("VendorDocExtractionCreator")
  uploadedFiles                 FileRecord[]                    @relation("FileUploader")
  notifications                 Notification[]
  ownedPolicies                 Policy[]                        @relation("PolicyOwner")
  policyAcknowledgements        PolicyAcknowledgement[]
  policyApprovals               PolicyApproval[]                @relation("PolicyApprover")
  policyApprovalRequests        PolicyApproval[]                @relation("PolicyApprovalRequester")
  policyVersionsCreated         PolicyVersion[]                 @relation("PolicyVersionCreator")
  riskControlsCreated           RiskControl[]                   @relation("RiskControlCreator")
  riskSuggestionSessions        RiskSuggestionSession[]         @relation("SuggestionSessionCreator")
  sessions                      AuthSession[]
  assignedTasks                 Task[]                          @relation("TaskAssignee")
  createdTasks                  Task[]                          @relation("TaskCreator")
  reviewingTasks                Task[]                          @relation("TaskReviewer")
  taskCommentsCreated           TaskComment[]                   @relation("TaskCommentCreator")
  taskWatches                   TaskWatcher[]
  invitesSent                   TenantInvite[]
  invitedMemberships            TenantMembership[]              @relation("MembershipInviter")
  tenantMemberships             TenantMembership[]
  identityLinks                 UserIdentityLink[]
  mfaEnrollments                UserMfaEnrollment[]
  notificationPreferences       UserNotificationPreference[]
  ownedVendors                  Vendor[]                        @relation("VendorOwner")
  assessmentsDecided            VendorAssessment[]              @relation("AssessmentDecider")
  assessmentsRequested          VendorAssessment[]              @relation("AssessmentRequester")
  // Epic G-3 — assessment lifecycle actors.
  assessmentsSent               VendorAssessment[]              @relation("AssessmentSender")
  assessmentsReviewed           VendorAssessment[]              @relation("AssessmentReviewer")
  assessmentsClosed             VendorAssessment[]              @relation("AssessmentCloser")
  assessmentTemplatesCreated    VendorAssessmentTemplate[]      @relation("AssessmentTemplateCreator")
  vendorDocsUploaded            VendorDocument[]                @relation("VendorDocUploader")
  vendorBundlesCreated          VendorEvidenceBundle[]          @relation("EvidenceBundleCreator")
  apiKeysCreated                TenantApiKey[]                  @relation("ApiKeyCreator")
  deviceTokensCreated           TenantDeviceToken[]             @relation("DeviceTokenCreator")
  userSessions                  UserSession[]                   @relation("UserSessionOwner")
  passwordResetTokens           PasswordResetToken[]            @relation("UserPasswordResetTokens")
  orgMemberships                OrgMembership[]
  orgAuditLogActions            OrgAuditLog[]                   @relation("OrgAuditLogActor")
  orgAuditLogTargets            OrgAuditLog[]                   @relation("OrgAuditLogTarget")
  orgInvitesIssued              OrgInvite[]                     @relation("OrgInviteInviter")
  // Epic G-4 — Access Review Campaigns. The User shows up in both
  // sides (running campaigns AND being reviewed) so the relations
  // need explicit, distinct names.
  accessReviewsAsReviewer       AccessReview[]                  @relation("AccessReviewReviewer")
  accessReviewsCreated          AccessReview[]                  @relation("AccessReviewCreator")
  accessReviewsClosed           AccessReview[]                  @relation("AccessReviewCloser")
  accessReviewsDeleted          AccessReview[]                  @relation("AccessReviewDeleter")
  accessReviewDecisionsSubject  AccessReviewDecision[]          @relation("AccessReviewDecisionSubject")
  accessReviewDecisionsDecided  AccessReviewDecision[]          @relation("AccessReviewDecisionDecider")
  connectedReviewDecisions      AccessReviewConnectedDecision[] @relation("ConnectedDecisionDecider")
  accessReviewDecisionsExecuted AccessReviewDecision[]          @relation("AccessReviewDecisionExecutor")
  // Epic G-5 — control exceptions involve up to five distinct
  // user-roles per row (creator, risk-acceptor, approver, rejecter,
  // deleter). Distinct relation names so Prisma can disambiguate.
  controlExceptionsCreated      ControlException[]              @relation("ControlExceptionCreatedBy")
  controlExceptionsRiskAccepted ControlException[]              @relation("ControlExceptionRiskAcceptedBy")
  controlExceptionsApproved     ControlException[]              @relation("ControlExceptionApprovedBy")
  controlExceptionsRejected     ControlException[]              @relation("ControlExceptionRejectedBy")
  controlExceptionsDeleted      ControlException[]              @relation("ControlExceptionDeletedBy")
  // Epic G-7 — risk treatment plans. Up to four distinct user-roles
  // per plan (owner, creator, completer, deleter) plus the
  // milestone completer. Distinct relation names so Prisma can
  // disambiguate.
  riskTreatmentPlansOwned       RiskTreatmentPlan[]             @relation("RiskTreatmentPlanOwner")
  riskTreatmentPlansCreated     RiskTreatmentPlan[]             @relation("RiskTreatmentPlanCreator")
  riskTreatmentPlansCompleted   RiskTreatmentPlan[]             @relation("RiskTreatmentPlanCompleter")
  riskTreatmentPlansDeleted     RiskTreatmentPlan[]             @relation("RiskTreatmentPlanDeleter")
  treatmentMilestonesCompleted  TreatmentMilestone[]            @relation("TreatmentMilestoneCompleter")
  // Roadmap-26 PR-A — persisted process maps.
  processMapsCreated            ProcessMap[]                    @relation("ProcessMapCreatedBy")
  processMapsDeleted            ProcessMap[]                    @relation("ProcessMapDeletedBy")
  // Epic P5-PR-A — process map snapshots.
  processMapSnapshotsCreated    ProcessMapSnapshot[]            @relation("ProcessMapSnapshotCreatedBy")
  // DSAR (GDPR Art. 15/17) — data-subject export/erasure requests.
  dataSubjectRequests           DataSubjectRequest[]
  /// DSARs this user has handled as staff (distinct from ones they filed).
  dsarRequestsHandled           DataSubjectRequest[]            @relation("DsarHandler")
  calendarConnections           UserCalendarConnection[]
  calendarEventMappings         UserCalendarEventMapping[]
  calendarConsentsGranted       TenantCalendarConsent[]         @relation("CalendarConsentGrantedBy")
  /// Epic Agentic — agents this user is the accountable owner of. The FK is
  /// NOT NULL on the agent side, so every registered agent appears here.
  registeredAgentsOwned         RegisteredAgent[]               @relation("RegisteredAgentOwner")
}

model Account {
  id                    String  @id @default(cuid())
  userId                String
  type                  String
  provider              String
  providerAccountId     String
  refresh_token         String?
  access_token          String?
  expires_at            Int?
  token_type            String?
  scope                 String?
  id_token              String?
  session_state         String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
}

// Epic C.3 — operational session tracking (separate from the
// NextAuth-adapter `AuthSession` table, which we leave untouched to
// avoid churning the adapter contract). One row per JWT minted by the
// `jwt` callback. Subsequent passes look this row up by `sessionId`,
// honour `revokedAt`, and update `lastActiveAt` (throttled).
//
// Privacy notes:
//   - `ipAddress` is captured from the incoming request at sign-in;
//     stored as a string (IPv4 / IPv6) so geo-IP correlation can
//     happen out-of-band. Acceptable under the existing PII model
//     because it's tied to the user's own auth event.
//   - `userAgent` is truncated to 512 chars to bound row size.
//   - Neither field is encrypted; both are operational telemetry,
//     not business content. If your threat model demands it, route
//     them through the encrypted-fields manifest later.
model UserSession {
  id            String    @id @default(cuid())
  /// Stable identifier embedded in the JWT so subsequent requests can
  /// find this row without trusting any other token claim. Min-entropy
  /// of cuid is acceptable; the token itself is signed by AUTH_SECRET
  /// so a guessed sessionId on its own does nothing.
  sessionId     String    @unique
  userId        String
  /// Tenant the user signed in against. Nullable because the very
  /// first JWT mint may precede tenant resolution (rare but possible).
  tenantId      String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastActiveAt  DateTime  @default(now())
  revokedAt     DateTime?
  /// Free-form attribution for the revocation (e.g. "admin:abc123" or
  /// "user:self"). Not displayed to end users; surfaced in the audit
  /// log entry.
  revokedReason String?

  user User @relation("UserSessionOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([userId, revokedAt])
  @@index([tenantId, revokedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Password-reset tokens (forgot-password / reset-password flow).
///
/// Distinct from `VerificationToken` on purpose: a single-purpose token
/// table means a verify-email link can never be replayed as a
/// password reset (and vice versa). `tokenHash` stores the SHA-256 of
/// the raw token — the raw value lives only in the emailed link and in
/// memory on the confirm path, so a leaked DB dump cannot be replayed.
/// `usedAt` makes the token single-use; the confirm path claims it with
/// a conditional `updateMany` so concurrent submits race to one winner.
/// Not tenant-scoped (identity-level, like User / VerificationToken) so
/// it carries no `tenantId` and needs no RLS policy.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BillingAccount {
  id                   String        @id @default(cuid())
  tenantId             String        @unique
  stripeCustomerId     String        @unique
  stripeSubscriptionId String?
  plan                 BillingPlan   @default(FREE)
  status               BillingStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
}

model BillingEvent {
  id            String   @id @default(cuid())
  tenantId      String
  type          String
  stripeEventId String   @unique
  payloadJson   Json
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model TenantIdentityProvider {
  id            String               @id @default(cuid())
  tenantId      String
  type          IdentityProviderType
  name          String
  isEnabled     Boolean              @default(false)
  isEnforced    Boolean              @default(false)
  emailDomains  String[]             @default([])
  configJson    Json                 @default("{}")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  identityLinks UserIdentityLink[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// EI-2 — maps an Entra ID security-group object id to an IC role. At sign-in
/// (EI-3) a user's resolved `aadGroups` are matched against these rows to sync
/// their tenant-membership role. `priority` breaks ties when a user is in
/// several mapped groups (higher wins). OWNER is intentionally not a permitted
/// target — ownership stays manually granted (see the Zod schema).
model TenantEntraGroupMapping {
  id              String   @id @default(cuid())
  tenantId        String
  /// Entra security-group object id (GUID).
  aadGroupId      String
  /// Cached Graph display name, for the admin UI only (never load-bearing).
  aadGroupName    String?
  role            Role
  /// Higher wins when a user matches multiple mappings.
  priority        Int      @default(0)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, aadGroupId])
  @@index([tenantId])
}

/// EI-3 — SCIM 2.0 Group registry. Entra pushes group lifecycle + membership
/// here; member changes reconcile each user's role via the EI-2 engine.
model ScimGroup {
  id          String   @id @default(cuid())
  tenantId    String
  /// SCIM externalId (the Entra group object id).
  externalId  String
  displayName String
  /// Resolved IC User ids for the group's members (via UserIdentityLink).
  memberIds   String[] @default([])
  /// Raw SCIM members array as pushed (audit / round-trip fidelity).
  membersJson Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, externalId])
  @@index([tenantId])
}

model UserIdentityLink {
  id                  String                 @id @default(cuid())
  userId              String
  tenantId            String
  providerId          String
  externalSubject     String
  // GAP-21: stored encrypted at rest, mapped to the encrypted column.
  // `emailAtLinkTimeHash` is nullable in TS (middleware populates) /
  // NOT NULL in DB (migration enforced). Same drift pattern as
  // User.emailHash — see that comment for rationale.
  emailAtLinkTime     String                 @map("emailAtLinkTimeEncrypted")
  emailAtLinkTimeHash String?
  lastLoginAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  provider            TenantIdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalSubject])
  @@unique([userId, providerId])
  @@index([tenantId])
  @@index([userId])
}

model TenantSecuritySettings {
  id                           String            @id @default(cuid())
  tenantId                     String            @unique
  mfaPolicy                    MfaPolicy         @default(DISABLED)
  /// Hard cap on JWT lifetime in minutes. When set, every newly minted
  /// session row's `expiresAt` is min(NextAuth max-age, now + this).
  sessionMaxAgeMinutes         Int?
  /// Maximum number of concurrent active sessions allowed per user
  /// in this tenant. When reached, the oldest session (by
  /// `lastActiveAt` ASC) is revoked to make room for the new sign-in.
  /// Null = unlimited (legacy behaviour).
  maxConcurrentSessions        Int?
  /// Epic C.4 — outbound audit-event streaming.
  /// `auditStreamUrl`: HTTPS endpoint the audit streamer POSTs batched
  /// audit events to. Null disables streaming.
  /// `auditStreamSecretEncrypted`: HMAC-SHA256 secret used to sign
  /// each batch. Stored encrypted via the field-encryption manifest
  /// (added to `ENCRYPTED_FIELDS.TenantSecuritySettings`).
  auditStreamUrl               String?
  auditStreamSecretEncrypted   String?
  /// NIS2 Article 23 — the CSIRT / competent authority this tenant
  /// notifies for significant incidents. Jurisdiction-specific (e.g.
  /// "CCB (Belgium)", "NCSC-NL (Netherlands)", "BSI (Germany)"). Free
  /// text so any EU member-state authority can be configured; the
  /// incident view surfaces this as "notify: <authority>". Null = the
  /// tenant has not configured an authority yet.
  incidentAuthority            String?
  /// AI Guard enforcement posture for this tenant (prompt-injection +
  /// secret/exfil egress guard). Default BALANCED = allow-but-flag; STRICT
  /// blocks malicious input / secret egress; AUDIT logs only.
  /// JML identity-write authority, PER DIRECTION. Both default to DISABLED —
  /// this product has never written to a customer directory, and turning that
  /// on is a deliberate act, not a migration side effect.
  ///
  /// Separate fields rather than one setting because the two directions carry
  /// different risk: a wrongful disable locks an employee out of their job for
  /// as long as it takes someone to notice; a wrongful create spends money on a
  /// licence and leaves an unowned account in the directory. A tenant may
  /// rationally accept one unattended and not the other.
  identityLeaverMode           IdentityWriteMode @default(DISABLED)
  identityJoinerMode           IdentityWriteMode @default(DISABLED)
  /// When the current DRY_RUN period began, per direction. The gate to
  /// AUTOMATIC reads this: dry-run is time-boxed and mandatory, so a tenant
  /// cannot enable unattended writes the same afternoon it enables the feature.
  /// Reset whenever a direction returns to DRY_RUN, so the clock measures the
  /// CURRENT observation window rather than the first one ever started.
  identityLeaverDryRunSince    DateTime?
  identityJoinerDryRunSince    DateTime?
  aiGuardMode                  AiGuardMode       @default(BALANCED)
  /// AI sovereignty (DS-1). EXTERNAL (default) allows the configured external
  /// provider; LOCAL_ONLY forces inference onto the tenant's own local gateway
  /// and refuses external providers. Optional per-tenant local-gateway override
  /// (else the AI_LOCAL_* env defaults). aiLocalBaseUrl is an internal URL, not
  /// a secret — not encrypted.
  aiResidency                  AiResidency       @default(EXTERNAL)
  aiLocalBaseUrl               String?
  aiLocalModel                 String?
  /// Recipients outside the tenant's own membership that scheduled reports may
  /// be delivered to. A JSON array of exact addresses ("auditor@kpmg.com")
  /// and/or domain suffixes ("@kpmg.com").
  ///
  /// Why an allowlist at all: `recipients` on a ReportSchedule was validated for
  /// RFC email SHAPE only, so any writer could point a recurring board-risk PDF
  /// at an arbitrary address forever. Membership alone is too strict — external
  /// auditors are a real use case — so non-members must be pre-approved HERE
  /// (an admin surface) rather than at schedule-creation time.
  ///
  /// Null or empty = no external recipients permitted; schedules may only be
  /// delivered to ACTIVE members of this tenant.
  reportRecipientAllowlistJson Json?
  /// Epic Agentic — refuse MCP traffic from a credential that is not bound to
  /// an ACTIVE registered agent.
  ///
  /// The default is TRUE and the ABSENCE of a settings row reads as TRUE as
  /// well (`getAgentRegistrationPolicy` defaults it), so a tenant created after
  /// this shipped is fail-closed whether or not anyone has ever opened the
  /// security-settings page. Existing tenants were explicitly opted OUT by the
  /// migration — which had to INSERT a row for every tenant that had none,
  /// because otherwise "no row" would have silently turned enforcement on for
  /// them at deploy time.
  ///
  /// Positively named on purpose. The inverted spelling
  /// (`allowUnregisteredAgents`) gives the same absence semantics for free, but
  /// every read site then has to negate it, and a negated flag read under
  /// pressure is how a kill switch gets inverted.
  requireRegisteredAgent       Boolean           @default(true)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  mfaFailClosed                Boolean           @default(false)
  tenant                       Tenant            @relation(fields: [tenantId], references: [id])
}

model UserMfaEnrollment {
  id                  String    @id @default(cuid())
  userId              String
  tenantId            String
  type                MfaType   @default(TOTP)
  secretEncrypted     String
  isVerified          Boolean   @default(false)
  verifiedAt          DateTime?
  lastChallengeAt     DateTime?
  backupCodesHashJson String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, type])
  @@index([userId])
  @@index([tenantId])
}

/// A single user's consent to push THEIR compliance deadlines into THEIR
/// personal Google or Outlook calendar.
///
/// PER-USER AND TENANT-SCOPED, which is the whole reason this is a new model
/// rather than a reuse. The obvious candidates both fail on that pair:
///   - `Account` holds per-user OAuth tokens but has NO tenantId — it is
///     per-user-GLOBAL, while one user holds memberships in several tenants,
///     so it cannot carry a tenant RLS policy and cannot distinguish "connected
///     for Acme" from "connected for Globex".
///   - `UserNotificationPreference` looks like the slot and is a DEAD model
///     with zero src/ references; building on it would tie new token storage to
///     something nothing else maintains.
/// `UserMfaEnrollment` is the structural precedent that DOES fit, and this
/// mirrors it deliberately: per-user + tenant-scoped, an explicit encrypted
/// secret column, and a three-part unique.
///
/// `tokenEncrypted` is written with an EXPLICIT encryptField at the usecase,
/// following IntegrationConnection rather than the Epic B manifest — see the
/// note on `ENCRYPTED_FIELDS`. It holds the whole OAuth payload (access token,
/// refresh token, expiry) as one ciphertext blob, so a partial write cannot
/// leave a refresh token stranded without its expiry.
///
/// `tenantId` is NOT NULL on purpose. A nullable tenantId forces the D.1
/// asymmetric single-policy RLS form plus a SINGLE_POLICY_EXCEPTIONS entry, and
/// the split-policy shape on a nullable column is what once let `app_user` NULL
/// a row's tenantId and promote a private record into every tenant's view.
/// A TENANT ADMIN's authorisation for a calendar provider, granted once for the
/// whole tenant.
///
/// Microsoft only, in practice. Google's model is per-user consent and needs no
/// tenant-level record; Microsoft's is `/adminconsent`, after which users
/// connect without ever seeing a consent screen. The asymmetry is deliberate
/// and lives in the provider column rather than in two tables.
///
/// ═══ WHY A RECORD AT ALL, RATHER THAN PROBING ═══
///
/// The settings UI has to know whether to offer a user "Connect" or "ask your
/// administrator". The alternative is to attempt a connect and read the error —
/// but that means every user in an unauthorised tenant runs a failed OAuth
/// round trip to discover a fact the tenant already knows, and it makes the
/// answer depend on a third party being reachable.
///
/// ═══ WHAT IT DOES NOT MEAN ═══
///
/// Not "these users may connect". Microsoft's tenant-wide grant admits ALL
/// users unless the app requires assignment, so this row records that the door
/// is open, not who walked through it. Per-user opt-in is `UserCalendarConnection`.
///
/// `revokedAt` is kept rather than deleting the row: an admin who withdraws
/// consent should see that state, and every user's connection is invalidated at
/// once — a fact the push path needs to distinguish from one user revoking.
model TenantCalendarConsent {
  id               String    @id @default(cuid())
  tenantId         String
  /// 'outlook-calendar'. Google is per-user and has no row here.
  provider         String
  /// The Entra tenant we were actually consented in, as returned by the
  /// callback. May differ from anything we guessed, and is what subsequent
  /// authorize URLs must use — guessing again would send users to the wrong
  /// authority.
  externalTenantId String?
  grantedAt        DateTime  @default(now())
  /// The admin who granted it. NOT NULL: a tenant-wide authorisation with no
  /// recorded author is exactly the row an access review cannot act on.
  grantedByUserId  String
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  grantedBy        User      @relation("CalendarConsentGrantedBy", fields: [grantedByUserId], references: [id])

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([grantedByUserId])
}

model UserCalendarConnection {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  /// 'google-calendar' | 'outlook-calendar'.
  provider       String
  /// encryptField(JSON.stringify({ accessToken, refreshToken, expiresAt })).
  tokenEncrypted String
  /// The scopes actually GRANTED, which may be narrower than those requested —
  /// a user can decline individual scopes on the Google consent screen, and a
  /// push that assumes it got what it asked for fails per-event at write time
  /// instead of once at connect time.
  scopesGranted  String[]
  connectedAt    DateTime  @default(now())
  /// Set when consent is withdrawn or a refresh returns invalid_grant. The row
  /// is KEPT rather than deleted so the settings UI can say "reconnect" instead
  /// of silently showing a disconnected state, and so C4's cleanup still knows
  /// which events were pushed under it.
  revokedAt      DateTime?
  /// Why it was revoked, for the settings surface. Never a raw provider body.
  revokedReason  String?
  lastPushedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, provider])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, provider, revokedAt])
}

/// One pushed calendar event: (user, provider, deadline) -> remote event id.
///
/// ═══ WHY A NEW TABLE ═══
///
/// `IntegrationSyncMapping` has NO user dimension, and its two uniques make
/// reuse impossible rather than merely awkward:
/// `@@unique([tenantId, provider, localEntityType, localEntityId])` means two
/// users' calendar copies of the same Task both key on
/// (tenant, 'google-calendar', 'task', taskId) and collide.
///
/// ═══ THE ROW IS THE ONLY RECORD THE EVENT EXISTS ═══
///
/// Nothing else in this system knows an event was written into someone's
/// personal calendar. So a remote delete that FAILS must not delete this row —
/// the event would be orphaned in the user's calendar forever with nothing left
/// to name it. It goes to PENDING_DELETE and the next sweep retries.
///
/// That is also why the DELETE direction must be driven from this table rather
/// than by diffing regenerated output: a source the user has LOST is skipped
/// entirely by the aggregation and never appears in a new generation, so
/// "push the new set" leaves orphans nothing ever mentions again.
model UserCalendarEventMapping {
  id             String                 @id @default(cuid())
  tenantId       String
  userId         String
  provider       String
  /// Which of the calendar's sources this came from (e.g. 'task', 'incident').
  sourceKey      String
  /// The source row's id.
  sourceEntityId String
  /// The provider's id for the event. Empty until the first push succeeds.
  remoteEventId  String
  /// DETERMINISTIC id we supply at creation, derived from the identity columns.
  /// It is what makes a retry a PATCH rather than a second event in someone's
  /// personal calendar — the most visible way this feature can fail, because
  /// the user sees it and we do not.
  clientEventId  String
  /// Hash of the event's pushed content, so a change is detected without
  /// reading the remote back. Cheap, and the read would need a scope we do not
  /// request.
  contentHash    String
  state          CalendarEventSyncState @default(PUSHED)
  /// Truncated, operator-facing. Never a raw provider body.
  lastError      String?
  lastPushedAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, provider, sourceKey, sourceEntityId])
  @@index([tenantId])
  @@index([userId])
  /// Backs the sweep: "everything this user still has pushed", and
  /// "everything awaiting deletion".
  @@index([tenantId, userId, provider, state])
}

model TenantInvite {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  role        Role      @default(READER)
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([token])
  @@index([tenantId])
}

model TenantScimToken {
  id         String    @id @default(cuid())
  tenantId   String
  label      String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// DSAR — a GDPR Art. 15 (export) / Art. 17 (erasure) data-subject
/// request and its workflow state.
///
/// USER-SCOPED, deliberately NOT tenant-scoped: a DSAR concerns a
/// person's data across the whole platform, so it carries no `tenantId`
/// (the relevant tenants are derived from the user's memberships at
/// execution time). Retained indefinitely — the record documents the
/// platform's compliance with the request (GDPR Art. 17(3)(b)).
///
/// FOUNDATION (Stage 1): the record + workflow transitions exist. Export
/// + erasure EXECUTION is gated off (see src/app-layer/jobs/dsar-export.ts
/// + dsar-erasure.ts and docs/dsar.md for the multi-PR sequence).
model DataSubjectRequest {
  id              String                   @id @default(cuid())
  userId          String
  user            User                     @relation(fields: [userId], references: [id])
  type            DataSubjectRequestType
  status          DataSubjectRequestStatus @default(RECEIVED)
  requestedAt     DateTime                 @default(now())
  verifiedAt      DateTime?
  completedAt     DateTime?
  /// One of the DSAR_REJECTION_REASONS constants (src/lib/dsar.ts) when
  /// status = REJECTED.
  rejectionReason String?
  /// Signed-URL of the export bundle (EXPORT type). Expires in 7 days;
  /// deleted after consumption or expiry, whichever is first.
  exportUrl       String?
  exportExpiresAt DateTime?
  /// Staff member who last advanced this request. Fulfilment is MANUAL —
  /// this is the accountable human, and a register without one is not
  /// defensible under audit.
  handledById     String?
  handledBy       User?                    @relation("DsarHandler", fields: [handledById], references: [id])
  /// Free-text record of what was actually done to fulfil the request.
  ///
  /// Deliberately NOT in the field-encryption manifest. DataSubjectRequest is
  /// cross-tenant (no tenantId), but the encryption middleware keys on the
  /// ACTING request's tenantId — so a note written by tenant A's admin would
  /// be encrypted under tenant A's DEK, and tenant B's admin opening the same
  /// request would hit `decryptWithKeyOrPrevious`, which THROWS on failure.
  /// The read would crash rather than degrade. Sanitised on write instead.
  fulfilmentNotes String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@index([status, requestedAt])
}
