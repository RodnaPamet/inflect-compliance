// personnel.prisma — People hub (Employee) — devices, training, background checks, directory identity accounts.
// Split from compliance.prisma (2026-07-10) — pure reorg, no datamodel change.
// Enums live in enums.prisma; relations resolve across the schema folder.

/// A user account discovered in a connected directory / identity provider
/// (Okta, Google Workspace — PR-2). Synced idempotently by the
/// `identity-sync` job and joined against Personnel (PR-4) for
/// offboarded-access checks. `groupsJson` is a string[] of group names.
/// Not encrypted — directory metadata (email + status flags), not content.
model ConnectedIdentityAccount {
  id                    String                 @id @default(cuid())
  tenantId              String
  /// Provider prefix — 'okta' | 'google-workspace' | 'entra-id' | 'active-directory'. Matches the
  /// ScheduledCheckProvider id so `{provider}.{check}` routing lines up.
  provider              String
  /// Stable id of the user in the provider's directory.
  externalUserId        String
  email                 String
  displayName           String?
  status                ConnectedAccountStatus @default(ACTIVE)
  isAdmin               Boolean                @default(false)
  mfaEnrolled           Boolean                @default(false)
  /// Whether this account is mastered ON-PREMISES and projected into the cloud
  /// directory by Azure AD Connect. Null = the provider cannot answer it.
  ///
  /// A WRITE-PATH signal, not a posture one. Reading a hybrid directory through
  /// Graph is correct; WRITING to it is not — for a synced account the source of
  /// authority is on-prem AD and the sync runs one way, so disabling it via
  /// Graph is reverted at the next cycle. An offboarding that does that reports
  /// success and then re-enables the account by itself.
  ///
  /// Nullable rather than defaulted false: "we do not know" and "cloud-only" are
  /// different answers, and only one of them is safe to write against.
  onPremisesSyncEnabled Boolean?
  /// The connection whose sync observed this account.
  ///
  /// One tenant may hold SEVERAL connections for one provider — IntegrationConnection
  /// is unique on (tenantId, provider, NAME), so two AD forests or two Entra tenants
  /// are a supported configuration. Without this column the nightly deprovision
  /// reconcile could only scope itself by `provider`, so every connection marked
  /// every OTHER connection's accounts DEPROVISIONED, both passes reporting PASSED.
  ///
  /// NULLABLE, and the null means something specific: "observed before this column
  /// existed, or the observing connection has since been deleted". It is NOT "belongs
  /// to every connection" — code that treats it that way re-creates the bug. See the
  /// reconcile in identity-sync.ts for the one place null is deliberately included,
  /// and why that is only safe when the tenant has a single connection.
  connectionId          String?
  /// string[] of group / role names the account belongs to.
  groupsJson            Json                   @default("[]")
  lastActiveAt          DateTime?
  syncedAt              DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  tenant          Tenant                          @relation(fields: [tenantId], references: [id])
  connection      IntegrationConnection?          @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  reviewDecisions AccessReviewConnectedDecision[]
  identityLink    IdentityAccountLink?

  // DELIBERATELY still keyed on `provider`, not `connectionId`, and this is a
  // transitional state rather than the end state. Old containers in a rolling
  // deploy upsert through this exact compound key; dropping it in the same
  // release that introduces the column would fail their writes outright. The
  // swap to [tenantId, connectionId, externalUserId] + NOT NULL is a second,
  // separate migration, and it is the one that also has to scope
  // createSnapshotWriter's readState — which is unambiguous ONLY while this
  // unique stands.
  @@unique([tenantId, provider, externalUserId])
  @@index([tenantId, provider])
  @@index([tenantId, status])
  @@index([tenantId, connectionId])
}

/// A security-awareness training course (PR-6). Provider-synced (KnowBe4) or
/// manual. `cadenceDays` drives the annual-completion check.
model TrainingCourse {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  provider    String?
  cadenceDays Int?     @default(365)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  assignments TrainingAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A training assignment to an employee (PR-6).
model TrainingAssignment {
  id          String         @id @default(cuid())
  tenantId    String
  employeeId  String
  courseId    String
  status      TrainingStatus @default(ASSIGNED)
  assignedAt  DateTime       @default(now())
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, courseId])
  // Compliance-calendar training loader: tenant-scoped range scan on the
  // due date, ordered ascending so a capped page keeps the nearest.
  @@index([tenantId, dueAt])
}

/// A background check for an employee (PR-6). `resultSummary` is encrypted at
/// rest (Epic B manifest) — it can quote adverse-action detail.
model BackgroundCheck {
  id            String                @id @default(cuid())
  tenantId      String
  employeeId    String
  provider      String?
  status        BackgroundCheckStatus @default(PENDING)
  requestedAt   DateTime?
  completedAt   DateTime?
  resultSummary String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

/// A managed endpoint / device (PR-5). Reported by an MDM or a per-tenant
/// device agent (token-authed) or entered manually. Optionally linked to an
/// Employee. The boolean posture fields are THREE-STATE: true (pass), false
/// (fail), null (NOT_APPLICABLE — e.g. LINUX has no screen-lock check). Never
/// treat null as fail.
model Device {
  id                     String         @id @default(cuid())
  tenantId               String
  employeeId             String?
  serialNumber           String?
  hostname               String?
  platform               DevicePlatform
  /// 'MDM' | 'AGENT' | 'MANUAL'.
  source                 String         @default("MANUAL")
  diskEncrypted          Boolean?
  screenLockEnabled      Boolean?
  antivirusRunning       Boolean?
  passwordManagerPresent Boolean?
  lastCheckIn            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, serialNumber])
  @@index([tenantId, employeeId])
  @@index([tenantId, platform])
}

/// A personnel record (PR-4). The people-layer hub — PR-5 devices + PR-6
/// training/background attach here. Synced from an HRIS or entered manually;
/// idempotent by (tenantId, workEmail). TERMINATED employees whose identity
/// account is still ACTIVE are the offboarded_access_removed gap signal.
model Employee {
  id                String           @id @default(cuid())
  tenantId          String
  /// Stable id in the source HRIS (null for manual records).
  externalId        String?
  fullName          String
  workEmail         String
  status            EmploymentStatus @default(ACTIVE)
  department        String?
  jobTitle          String?
  /// Self-reference to the manager's Employee row.
  managerEmployeeId String?
  startDate         DateTime?
  endDate           DateTime?
  /// 'HRIS' | 'MANUAL'.
  source            String           @default("MANUAL")
  syncedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  manager             Employee?             @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  reports             Employee[]            @relation("EmployeeManager")
  devices             Device[]
  trainingAssignments TrainingAssignment[]
  backgroundChecks    BackgroundCheck[]
  identityLinks       IdentityAccountLink[]

  @@unique([tenantId, workEmail])
  @@index([tenantId, status])
  @@index([tenantId, managerEmployeeId])
}

/// The worker <-> directory-account pairing, established while BOTH sides are
/// healthy.
///
/// WHY A TABLE AND NOT A JOIN AT TERMINATION TIME
///
/// The leaver flow needs to answer "which directory accounts belong to the
/// person Workday just marked terminated?". Computing that answer at
/// termination is the worst possible moment to compute it: by then the account
/// may have been renamed, its mail attribute cleared, its UPN changed, or the
/// HR row already scrubbed. Email equality — the only bridge available today —
/// is exactly what stops being reliable at the moment it is relied on.
///
/// So the pairing is observed continuously during healthy syncs and READ at
/// termination. A disable then looks up a previously-verified fact instead of
/// inferring a fresh one under time pressure.
///
/// ABSENCE OF A ROW IS A REFUSAL, NOT A FALLBACK
///
/// If no link exists the leaver path must refuse and escalate, never fall back
/// to matching by email in the moment. That fallback would reintroduce the
/// entire failure mode this table exists to remove, and it would do so only on
/// the unhappy path where nobody is watching.
model IdentityAccountLink {
  id                 String             @id @default(cuid())
  tenantId           String
  employeeId         String
  connectedAccountId String             @unique
  /// The basis of the pairing, so a disable can justify itself.
  matchMethod        IdentityLinkMethod

  /// When this pairing was first observed.
  firstLinkedAt  DateTime  @default(now())
  /// The most recent healthy sync that re-observed it. A link not re-verified
  /// recently is stale evidence — the leaver path can require freshness rather
  /// than trusting a pairing last seen months ago.
  lastVerifiedAt DateTime
  /// Set when a sync OBSERVED this pairing to be contradicted — the account's
  /// current email now resolves to a different worker, to none, or to an
  /// ambiguous one.
  ///
  /// Without it, `lastVerifiedAt` is not a witness that the pairing is still
  /// true; it is only a bound on how long ago it was last true. The reconciler
  /// already computes the contradiction and correctly refuses to re-point the
  /// link — but a disproven link with a recent stamp would otherwise stay in
  /// the leaver candidate set for the rest of its freshness window, which is
  /// precisely the wrong-person write everything else here exists to prevent.
  ///
  /// Cleared when a later sync re-confirms the pairing.
  contradictedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  writeJournal     IdentityWriteJournal[]
  connectedAccount ConnectedIdentityAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  /// `connectedAccountId` carries a field-level @unique (above), so an account
  /// belongs to AT MOST ONE worker. Two workers claiming one account makes
  /// "whose account is this?" unanswerable at exactly the moment it must be
  /// answered, so the database refuses the state outright.
  ///
  /// Global rather than per-tenant, and that is stronger, not looser: a
  /// ConnectedIdentityAccount row already belongs to exactly one tenant, so a
  /// cross-tenant collision is impossible by construction and the narrower
  /// composite would only have been redundant index cost on every write.
  ///
  /// Deliberately NOT unique on employeeId: one worker legitimately holds
  /// several accounts (Entra + Okta + on-prem AD), and disabling all of them
  /// is the point.
  @@index([tenantId, employeeId])
  @@index([tenantId, lastVerifiedAt])
  @@index([tenantId, contradictedAt])
}

/// One attempted write to a customer's directory, with the state it replaced.
///
/// ═══ WHY THE PRIOR STATE IS CAPTURED, AND WHY *BEFORE* ═══
///
/// Disabling an account destroys the evidence of what it was. On-prem AD packs
/// the answer into a single `userAccountControl` integer whose other bits
/// (password-never-expires, smartcard-required, …) are gone the moment it is
/// overwritten; Entra's `accountEnabled` is recoverable in principle but says
/// nothing about the group memberships a disable may have taken with it.
///
/// So "undo the offboarding" is answerable only if the answer was written down
/// first. A row here is created and COMMITTED before the provider call — never
/// after — because a capture that happens after a successful write does not
/// exist for the write that crashed halfway.
///
/// ═══ WHY A JOURNAL AND NOT A COLUMN ON THE LINK ═══
///
/// A single `priorState` on IdentityAccountLink would hold one outstanding
/// disable and be overwritten by the next. Rehire → disable → rehire is an
/// ordinary sequence, and the second cycle would silently destroy the first
/// cycle's record. Append-only also matches what this is: evidence, in a
/// compliance product, that an automated system changed a person's access.
model IdentityWriteJournal {
  id       String @id @default(cuid())
  tenantId String

  /// The link this write acted through. Nullable so the journal OUTLIVES the
  /// link: an employee row deleted for privacy must not erase the record that
  /// their access was revoked, which is often the evidence an auditor wants.
  linkId String?

  /// Denormalised target, so a restore can still find the account after the
  /// link or the employee is gone. Deliberately duplicated rather than joined.
  provider       String
  externalUserId String

  /// What was attempted, and under which rung of the write-mode ladder.
  action IdentityWriteAction
  mode   IdentityWriteMode

  /// The provider-shaped state this write replaced — `userAccountControl` for
  /// AD, `accountEnabled` (+ groups where touched) for Entra. Opaque here on
  /// purpose: the provider that captured it is the only thing that can
  /// meaningfully interpret it, and freezing a schema would date badly.
  priorStateJson Json

  outcome IdentityWriteOutcome @default(PENDING)
  /// Why a FAILED write failed, or why a REVERTED one was undone.
  detail  String?

  attemptedAt DateTime  @default(now())
  settledAt   DateTime?

  /// Who or what caused it. Null for a scheduled run with no human behind it.
  actorUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  link   IdentityAccountLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  /// The restore lookup: "what did we last do to this account?"
  @@index([tenantId, provider, externalUserId])
  /// The operator sweep: "what is still PENDING and needs a human to look?"
  @@index([tenantId, outcome])
  @@index([tenantId, attemptedAt])
  @@index([linkId])
}
