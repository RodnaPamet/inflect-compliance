// ═══════════════════════════════════════════════════════════════════════════
// Legacy access recertification — snapshots pulled from operator-hosted MCP
// servers in front of legacy applications.
//
// Two models, and the split is the whole design: a SNAPSHOT is the integrity
// evidence (what was asked for, what came back, whether it was whole), and an
// ACCOUNT is one row of the canonical schema. Readers only ever use accounts
// belonging to a snapshot whose status is COMPLETE, because a snapshot that is
// anything else is a population nobody can vouch for — and a recertification
// campaign over an incomplete population produces an artefact attesting that
// every account in scope was reviewed, which would be true of its rows and
// false of the application.
//
// Canonical fields ONLY. Whatever else the legacy table carried was dropped at
// the boundary by src/lib/legacy-access/ingest.ts. A column nobody mapped is a
// column nobody classified, and the retention policy, the encryption manifest
// and the erasure path all range over columns somebody classified.
// ═══════════════════════════════════════════════════════════════════════════

/// One pull from one connection.
///
/// `status` starts PENDING and becomes COMPLETE only as the final act of a
/// successful pull, after every account row is written. A crash part-way
/// through therefore leaves PENDING, which no reader will touch — the absence
/// of a transition is the failure signal, so nothing has to run to record it.
model LegacyAccessSnapshot {
  id           String @id @default(cuid())
  tenantId     String
  connectionId String

  /// The snapshot id the FAR END minted, carried so a torn read can be
  /// recognised across pages and so an operator can correlate with their own
  /// server's logs. Not unique here: a server may legitimately re-serve one
  /// snapshot id to a retried pull.
  remoteSnapshotId String

  /// The mapping version this pull applied, and the column-set fingerprint the
  /// mapping was confirmed against. Stored on the snapshot rather than only in
  /// `configJson` because the mapping will change and this row must keep
  /// meaning what it meant: "these rows were produced by THAT mapping".
  mappingVersion       Int
  columnSetFingerprint String

  /// SHA-256 over the mapped rows in canonical form. Re-derivable from the
  /// stored accounts, which is what makes it evidence rather than a checksum.
  /// Null while PENDING and on a refusal — a hash over a population we never
  /// finished reading would certify the wrong thing.
  payloadHash String?

  /// Which canonicalisation produced `payloadHash`. Recorded per row, never
  /// read from the current source constant: a verifier that assumed today's
  /// algorithm would report every snapshot taken before a canonicalisation fix
  /// as corrupt, which is the opposite of what integrity evidence is for.
  payloadHashAlgorithmVersion Int @default(1)

  /// Accounts actually stored. Compare with `rowsReceived` to see what the
  /// mapping collapsed (a long entitlement layout legitimately yields fewer
  /// accounts than rows).
  rowCount     Int @default(0)
  rowsReceived Int @default(0)

  status        LegacyAccessSnapshotStatus  @default(PENDING)
  refusalReason LegacyAccessRefusalReason?
  /// Operator-facing explanation. System-generated and never a cell value —
  /// see the LegacyIngestError docblock, which is where that rule is enforced.
  refusalDetail String?

  /// Columns the server returned that the `?fields=` projection did not ask
  /// for. NAMES only; no value of these columns is stored anywhere. A
  /// non-empty array is the OVERSHARING condition, mirrored onto the
  /// connection so an operator sees it without opening a snapshot.
  oversharedColumns String[]

  /// Date cells that could not be parsed, across the whole pull. A number
  /// rather than a refusal: an unparseable `createdAt` disables the temporal
  /// veto for that account, and the veto only ever removes candidates, so
  /// losing it yields more for a human to look at rather than fewer.
  unparsedDateCount Int @default(0)

  pulledAt    DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId, tenantId], references: [id, tenantId])
  accounts   LegacyAccount[]

  /// Lets a child row's FK be composite, which is what makes a cross-tenant
  /// parent pointer unrepresentable rather than merely checked.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, connectionId, status, pulledAt])
  @@index([tenantId, connectionId, completedAt])
  resolutions LegacyAccountResolution[]

}

/// One account from one snapshot, in canonical form.
///
/// Immutable once written. A snapshot is a point-in-time observation, so an
/// account that changed in the legacy application is a new row in a new
/// snapshot — never an update here. Keeping the history is what lets a reviewer
/// be asked "this is what we saw on the 9th" and what lets an auditor recompute
/// the payload hash of a snapshot taken months ago.
model LegacyAccount {
  id         String @id @default(cuid())
  tenantId   String
  snapshotId String

  /// The account's key in the source application, and the unit of review.
  /// Unique per snapshot: a duplicate is refused at ingestion rather than
  /// collapsed by an upsert, because two rows claiming one key give no reason
  /// to trust what either says.
  accountKey String

  username       String?
  displayName    String?
  givenName      String?
  familyName     String?
  email          String?
  employeeNumber String?
  department     String?
  title          String?
  managerRef     String?

  status      LegacyAccountStatus @default(UNKNOWN)
  lastLoginAt DateTime?
  /// Drives the temporal veto — an account that did not exist when a person
  /// left cannot be that person's — so it is load-bearing for correctness
  /// rather than informational.
  sourceCreatedAt DateTime?
  expiresAt       DateTime?

  entitlements String[]
  isPrivileged Boolean?
  accountType  LegacyAccountType @default(UNKNOWN)

  createdAt DateTime @default(now())

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  snapshot LegacyAccessSnapshot @relation(fields: [snapshotId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([snapshotId, accountKey])
  @@index([tenantId])
  /// Backs the verify query exactly: equality on `tenantId` + `snapshotId`, then
  /// a range scan and ordering on `accountKey` — which is the order the payload
  /// hash is defined over, so the recompute pages without a sort. Supersedes a
  /// plain `[tenantId, snapshotId]`, which this covers as a prefix.
  @@index([tenantId, snapshotId, accountKey])
  @@index([tenantId, email])
  @@index([tenantId, employeeNumber])
}

/// One account's resolution, from one run. IMMUTABLE.
///
/// There is deliberately no update seam. A second run over the same snapshot
/// writes a NEW set of rows against its own execution, and the old set stays as
/// it was — because "why was this account suggested to that person in March?" is
/// a question about what the engine saw in March, and an updated row cannot
/// answer it. The roster moves, links go stale, aliases get confirmed; a
/// resolution is a record of a judgement under conditions that no longer hold.
///
/// `signalsJson`, `candidatesJson` and `vetoesJson` carry the engine's own
/// evidence, which is what makes a suggestion reviewable rather than an opaque
/// verdict. They hold identifiers — an account key, an employee number, an email
/// key — because those ARE the evidence for the strong signals.
model LegacyAccountResolution {
  id       String @id @default(cuid())
  tenantId String

  /// The run. An `IntegrationExecution` IS the run rather than a sibling table:
  /// the execution already records when it started, when it finished, what
  /// triggered it and how it ended, and inventing a second row to mean the same
  /// thing is how two records of one event come to disagree.
  executionId String
  /// The snapshot resolved. Always a COMPLETE one — the usecase refuses
  /// otherwise, because a resolution over a population nobody can vouch for
  /// inherits exactly that problem.
  snapshotId String

  accountKey String
  outcome    LegacyResolutionOutcome
  method     LegacyMatchMethod
  /// Null for every outcome but LINKED, and for LINKED it is the one employee a
  /// strong unvetoed signal pointed at.
  employeeId String?

  /// The engine's evidence. Arrays of `{ kind, score, evidence }` and
  /// `{ employeeId, score, signals, vetoes, strongest }`.
  signalsJson    Json
  candidatesJson Json
  vetoesJson     Json
  /// Is the SUGGESTED employee involved in a re-key? Null when there is none.
  ///
  /// Stamped by the run, not computed by the reader. `makeRekeyLookup` takes the
  /// WHOLE roster, so asking this on a queue page would be a full `Employee`
  /// read on an interactive surface — the shape Layer D of
  /// `query-shape-guardrails` exists to refuse. The job already holds the roster
  /// and already builds the lookup, so the cost goes there. Owner decision,
  /// 2026-10-10.
  ///
  /// About the SUGGESTED employee specifically, not a per-candidate map, because
  /// the `AGREES` bulk lane ratifies exactly that person: `AGREES` means the
  /// model picked the engine's suggestion, so `employeeId` IS the candidate whose
  /// eligibility this term is about. A map would be storage for a question the
  /// lane never asks.
  ///
  /// AS-OF THE RUN, like every other field on this row. A re-key that happens
  /// after the run is not reflected until the next one, and that is correct for
  /// a lane that ratifies rows as the run resolved them.
  suggestedRekeyed Boolean?
  /// System-generated, and the only one the engine writes is
  /// `service token: <token>` — a token from the connection's own configuration,
  /// never a cell value.
  note String?

  createdAt DateTime @default(now())

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  execution IntegrationExecution  @relation(fields: [executionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  snapshot  LegacyAccessSnapshot  @relation(fields: [snapshotId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Step 6c's model opinions about this resolution, one per model revision.
  verdicts LegacyMatchVerdict[]

  /// One row per account per RUN. The run is in the key, which is what makes a
  /// second run an addition rather than a collision.
  /// Step 6c's verdict table needs a tenant-safe composite FK into this model,
  /// and `references` must name a unique criterion. The same pattern every
  /// tenant-scoped child in this subsystem uses.
  @@unique([id, tenantId])
  @@unique([executionId, accountKey])
  @@index([tenantId])
  @@index([tenantId, snapshotId, outcome])
  @@index([tenantId, employeeId])
  /// The version check in usecases/legacy-reviewer-actions.ts: "is the result
  /// this reviewer was shown still the latest for this account". Runs once per
  /// decision AND once per bulk row, so an unindexed form is a scan per click.
  @@index([tenantId, accountKey, createdAt])
  /// The queue listing: equality on tenantId + executionId, then the outcome
  /// filter that selects the three a human has to look at.
  @@index([tenantId, executionId, outcome])
}

/// The durable crosswalk: this legacy account belongs to this employee, because
/// a person said so.
///
/// Written only by Step 4b. Step 3c READS it and nothing else — the engine takes
/// confirmed aliases as its strongest signal, so a row here is the one thing that
/// can turn an account into a `LINKED` without any other evidence. That is why a
/// person has to put it there.
///
/// `signalsJson` records what the confirmer was SHOWN, not what is true now. If
/// the roster has since changed, the question "was this a reasonable thing to
/// confirm?" is still answerable.
model LegacyIdentityAlias {
  id       String @id @default(cuid())
  tenantId String

  connectionId String
  accountKey   String

  /// The person, when the classification is EMPLOYEE.
  ///
  /// Nullable because three of Step 4b's six reviewer actions do not produce an
  /// employee link at all. The guarantee this gave up is NOT traded for a
  /// comment — `LegacyIdentityAlias_classification_shape` reinstates it in the
  /// database: EMPLOYEE requires an employeeId, and the other three forbid one.
  /// Prisma's `migrate diff` does not see CHECK constraints, which is why this
  /// one does not appear in `prisma/fresh-db-schema-drift.expected.sql` and why
  /// `Tenant_previousEncryptedDek_differs` has lived there unlisted since
  /// April.
  employeeId String?

  /// What the reviewer decided this account IS. One row per account either way,
  /// so an account cannot be both aliased to a person and marked NON_PERSON —
  /// which two tables would have permitted, and which would make the strongest
  /// signal in the system ambiguous.
  classification LegacyAliasClassification @default(EMPLOYEE)

  /// Required for NON_PERSON, and only meaningful there: a service account
  /// nobody owns is the thing this classification exists to stop somebody
  /// declaring. Not in the shape CHECK constraint — see the migration for why
  /// "contradictory" and "incomplete" are enforced differently.
  ownerUserId String?

  /// Why, for the decisions a machine cannot check: MANUAL, EXTERNAL and
  /// NON_PERSON. Encrypted at rest and sanitised at the write path — it is free
  /// text a reviewer typed about a named person, read back into a review
  /// surface.
  justification String?

  /// When an EXTERNAL classification stops being a claim about today.
  ///
  /// An expired EXTERNAL returns to the QUEUE rather than being suspended.
  /// Nothing about it became doubtful — it became old, and those are different
  /// findings for a reviewer.
  expiresAt DateTime?

  /// The verdict this decision was made against, when one existed.
  ///
  /// "What did the model say about the row this person ratified" is a question
  /// an auditor asks, and without this it is answerable only by guessing which
  /// run's resolution the alias came from.
  ///
  /// A PLAIN COLUMN, DELIBERATELY NOT A FOREIGN KEY, and the reason is a
  /// lifetime mismatch rather than convenience. An alias is the durable record
  /// of a person's decision; a verdict is an annotation that cascades away with
  /// its reconciliation run. No referential action expresses "keep the alias,
  /// forget the verdict":
  ///
  ///   - `Cascade` would delete the DECISION when an annotation is purged;
  ///   - `Restrict` would make a run un-purgeable because somebody ratified a
  ///     row in it, so retention would fight the trail;
  ///   - `SetNull` is what the semantics want and is impossible here — the key
  ///     would have to be `(verdictId, tenantId)` to stop a cross-tenant
  ///     reference, and `tenantId` is required, so there is nothing to null.
  ///
  /// So a purged verdict leaves the id behind, which is honest: the decision WAS
  /// made against that verdict, and that stays true after the row is gone.
  /// Same-tenant correctness is held by RLS and by the single write path, as it
  /// is for every other id this subsystem stores.
  ///
  /// SET EVEN FOR A BLIND-SAMPLED ROW, the opposite of how `method` treats one.
  /// The method must not credit the model for a pick the reviewer could not
  /// see; the REFERENCE is what makes the blind comparison possible at all.
  ///
  /// Null for every alias confirmed without adjudication, which is all of them
  /// today.
  verdictId String?

  method LegacyMatchMethod
  status LegacyAliasStatus @default(ACTIVE)

  /// Who confirmed it, and when. Nullable `confirmedByUserId` because a user row
  /// can be deleted while the decision it recorded stands — the alias outlives
  /// the account that made it, the same way `IdentityWriteJournal` outlives the
  /// link it describes.
  confirmedByUserId String?
  confirmedAt       DateTime

  /// What the confirmer was shown. See the model docblock.
  signalsJson Json

  /// Why it was suspended, when it was. System-generated.
  suspendedReason String?
  suspendedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One alias per account per connection. A second confirmation for the same
  /// account is a CHANGE of the existing row, not a rival to it — two live
  /// aliases disagreeing about one account would make the strongest signal in the
  /// system ambiguous.
  @@unique([connectionId, accountKey])
  @@index([tenantId])
  @@index([tenantId, connectionId, status])
  @@index([tenantId, employeeId])
  /// The expiry sweep's own read: "which EXTERNAL aliases have expired?" runs
  /// every cycle for every connection, and without this it scans every alias
  /// the tenant holds.
  @@index([tenantId, classification, expiresAt])
  @@index([tenantId, verdictId])
}

/// Step 6c — one model opinion about one resolution, under one model revision.
///
/// IMMUTABLE, and one row per `(resolutionId, modelRevision)`. A re-run under the
/// same revision is the same question and must not produce a second answer; a
/// re-run under a NEW revision is a different question and gets its own row, so
/// "what did revision X say about this account" stays answerable after a model
/// change.
///
/// Every row holds EITHER a verdict with its probabilities OR a non-verdict
/// reason — never both, never neither. The pair is enforced by
/// `LegacyMatchVerdict_outcome_shape`: a row claiming both would make the queue
/// ambiguous about whether a model spoke, and a row claiming neither is a
/// question nobody asked.
///
/// Nothing here can change an outcome or create an alias. The verdict chooses a
/// review LANE; `lib/legacy-access/verdict.ts` is a pure module that imports no
/// writer, and a test proves it by loading it with every writer mocked to throw.
model LegacyMatchVerdict {
  id       String @id @default(cuid())
  tenantId String

  /// The resolution this is an opinion about.
  resolutionId String
  /// The model and the EXACT revision the endpoint reported. Exact, because a
  /// near-match would wave through the vendor-update case the canary exists to
  /// catch, one step before the canary runs.
  modelId       String
  modelRevision String

  /// The lane, when a verdict was produced.
  verdict LegacyMatchVerdictClass?
  /// Why not, when one was not.
  nonVerdictReason LegacyMatchNonVerdictReason?

  /// Per-candidate probabilities as the model returned them, keyed by the
  /// SHUFFLED letter it was shown. The letter-to-employee mapping stays on the
  /// server and is deliberately not stored here: a verdict row that named
  /// employees would be a second, weaker copy of the resolution's own evidence.
  probabilitiesJson Json?
  /// The letter-to-employee mapping, so the row explains its own probabilities.
  ///
  /// WITHOUT THIS A `PROPOSES` VERDICT IS UNACTIONABLE. `probabilitiesJson` is
  /// keyed by the SHUFFLED letters actually sent, which is the right audit
  /// record of what the model was asked — and on its own it says "the model
  /// picked C" with nothing able to say who C was.
  ///
  /// Not re-derivable in practice, although the shuffle is deterministic: the
  /// permutation is a hash over the account key and each employee id, so
  /// recomputing it needs the SAME candidate set, and that set is the one
  /// surviving a budget trim whose size depends on the model. A roster change
  /// between the run and the review would silently re-letter the row.
  ///
  /// "Letters, not ids" is a rule about the PAYLOAD — the mapping never leaves
  /// Inflect — and this column does not leave Inflect either. The row is
  /// already classed PII subject in docs/data-retention.md.
  labellingJson     Json?
  /// P(the subject is a person at all).
  personProbability Float?
  /// The top option's probability, and its gap to the runner-up. Stored rather
  /// than re-derived so the queue can sort and filter without parsing JSON.
  topProbability Float?
  topMargin      Float?

  /// Round-trip latency, and the input tokens the provider reported. The token
  /// count is what `OVER_BUDGET` is judged against.
  latencyMs   Int?
  inputTokens Int?

  createdAt DateTime @default(now())

  tenant     Tenant                  @relation(fields: [tenantId], references: [id])
  resolution LegacyAccountResolution @relation(fields: [resolutionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One answer per question. The revision is in the key, which is what makes a
  /// model change an addition rather than a collision.
  @@unique([resolutionId, modelRevision])
  @@index([tenantId])
  @@index([tenantId, verdict])
  @@index([tenantId, nonVerdictReason])
}
