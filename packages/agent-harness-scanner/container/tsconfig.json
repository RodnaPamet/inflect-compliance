// The scanner image's tsconfig, copied to /app, where tsx reads it from the
// working directory. The scanner imports the wire contract from its package
// (`@rodnapamet/scanent-contract`), so no `@/` alias is declared: an
// application import has nothing to resolve to in the image.
// See ../README.md, Container.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
