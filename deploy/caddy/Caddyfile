#
# Caddy reverse proxy for inflect-compliance.
#
# TWO hostnames reach the same app, and they are NOT interchangeable:
#
#   app.inflect.bg                        the real production domain
#   inflect.<ip-with-dashes>.sslip.io     the IP-derived fallback, substituted
#                                         by the deploy script once the VM's
#                                         external IP is known
#
# Let's Encrypt issues a cert for each automatically on first request.
#
# ── WHY THE SHARED CONFIGURATION IS A SNIPPET ───────────────────────────────
#
# Because the two blocks drifted, and the duplication is how. The live copy
# grew the `app.inflect.bg` vhost by hand and never received the HTTP/3 and
# cache-header work (#1275) the repo copy carries; the repo copy never learned
# the vhost. `check-drift.sh` has reported the pair as UNRECONCILED ever since,
# with the note that "each side has content the other lacks, so neither can
# simply overwrite the other".
#
# Two near-identical site blocks are a standing invitation to fix one and
# forget the other. `import` makes that impossible: there is one body, and a
# change to it reaches both names or neither.
#
# NOTE, for whoever reads the drift note next: it also says the repo's retry
# settings never reached the live copy. That is now stale — the live file
# carries `lb_try_duration 120s` and `lb_try_interval 250ms`. What it genuinely
# lacked was HTTP/3 and the Cache-Control matchers.
#
{
    # Use the production LE endpoint by default (default behaviour).
    # Set ACME_EMAIL in the env if you want certificate expiry mail.
    email {$ACME_EMAIL:admin@inflect.app}

    # Advertise HTTP/3 (QUIC) at the origin as well as h1/h2. Caddy emits
    # the Alt-Svc header automatically so direct-to-origin clients (no CDN
    # in front) negotiate h3; behind CloudFront the edge speaks h3 to the
    # viewer (see http_version in infra/terraform/modules/cdn/main.tf).
    servers {
        protocols h1 h2 h3
    }
}

# Everything both hostnames serve. Imported, never copied.
(app_site) {
    encode gzip zstd

    # Client-body limit roughly matches FILE_MAX_SIZE_BYTES above.
    request_body {
        max_size 110MB
    }

    # Security headers.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    # Cache-Control for CDN origin pulls (CloudFront — see docs/cdn.md).
    # Caddy emits these on the origin response so the edge caches with the
    # right TTL. They are correct even with no CDN in front (browsers
    # cache the immutable hashed bundles locally too).
    @nextStatic path /_next/static/* /static/*
    header @nextStatic Cache-Control "public, max-age=31536000, immutable"

    @nextImage path /_next/image*
    header @nextImage Cache-Control "public, max-age=2592000"

    # Everything else (HTML shell + /api/*) carries auth context — never
    # cache it at the edge or in shared caches.
    @dynamic not path /_next/static/* /static/* /_next/image*
    header @dynamic Cache-Control "no-store"

    reverse_proxy app:3000 {
        # Ride out the unavailability window during a Watchtower image swap
        # (the new container runs `prisma migrate deploy` + the
        # self-assessment seed before `next start` listens on :3000). Without
        # this, Caddy returns 502 "connection refused" for that whole window.
        #
        # 120s, not 30s. Measured on the prod VM 2026-08-09: container start →
        # listening took 28s and 33s on two consecutive restarts, of which
        # ~27s and ~32s were `prisma migrate deploy` alone. 30s was already
        # being exceeded, and migrations only accumulate — the budget has to
        # clear the slowest migrate run by a wide margin, not track it.
        lb_try_duration 120s
        lb_try_interval 250ms
        # Next.js sits behind the proxy — forward the original host so
        # NextAuth + server-side redirects resolve to the public URL.
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ── app.inflect.bg — the real production domain ─────────────────────────────
app.inflect.bg {
    import app_site
}

# ── the IP-derived fallback, substituted by the deploy script ───────────────
inflect.34-140-180-255.sslip.io {
    import app_site
}
