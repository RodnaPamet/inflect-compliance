{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@inflect/ui/*": [
        "./packages/ui/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "prisma/seed.ts",
    "dub-reference",
    // The public docs site (docs/docs-site.md): its own package, built by Astro,
    // with no TypeScript of its own. Excluded so Astro's generated types under
    // site/.astro/ never reach the application's typecheck.
    "site",
    ".next-test",
    // Claude Code runtime state. `.claude/worktrees/<id>/` holds FULL
    // checkouts of the repo, so `include: ["**/*.ts"]` would hand tsc a
    // second (and third…) copy of every file in the project — slower, and
    // errors reported against paths that are not the repo.
    ".claude"
  ]
}
