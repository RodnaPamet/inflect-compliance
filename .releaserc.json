{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "./scripts/semrel-minor-cap.mjs",
      {
        "_comment": "Wraps @semantic-release/commit-analyzer (forwarded this preset + releaseRules verbatim) to cap the MINOR component at three digits: the release that would become X.1000.0 rolls over to (X+1).0.0 instead. That rollover major is COSMETIC \u2014 no breaking change behind it \u2014 and is safe here because the app is npmPublish:false (the version only feeds Helm appVersion + Docker tags). A real breaking change still bumps the major the normal way via feat!/BREAKING CHANGE. See scripts/lib/minor-cap.mjs.",
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "type": "revert",
            "release": "patch"
          },
          {
            "breaking": true,
            "release": "major"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "\u2728 Features",
              "hidden": false
            },
            {
              "type": "fix",
              "section": "\ud83d\udc1b Bug Fixes",
              "hidden": false
            },
            {
              "type": "perf",
              "section": "\u26a1 Performance",
              "hidden": false
            },
            {
              "type": "refactor",
              "section": "\u267b\ufe0f Refactoring",
              "hidden": false
            },
            {
              "type": "revert",
              "section": "\u23ea Reverted",
              "hidden": false
            },
            {
              "type": "docs",
              "section": "\ud83d\udcda Documentation",
              "hidden": false
            },
            {
              "type": "chore",
              "section": "\ud83d\udd27 Maintenance",
              "hidden": true
            },
            {
              "type": "test",
              "section": "\u2705 Tests",
              "hidden": true
            },
            {
              "type": "ci",
              "section": "\ud83c\udfd7\ufe0f CI/CD",
              "hidden": true
            },
            {
              "type": "build",
              "section": "\ud83d\udce6 Build",
              "hidden": true
            },
            {
              "type": "style",
              "section": "\ud83d\udc84 Style",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to **inflect-compliance** are documented here.\nThis file is auto-generated by [semantic-release](https://github.com/semantic-release/semantic-release)."
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "package-lock.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}",
        "_comment": "Assets committed with the release. `infra/helm/inflect/Chart.yaml` was removed from this list on 2026-09-02 together with `infra/helm/` itself \u2014 the chart described a Kubernetes deployment that was never provisioned. The paired `@semantic-release/exec` step that ran `scripts/sync-chart-version.mjs` went with it: that script exits non-zero when its regex misses, so leaving it would have failed the PREPARE phase of every release once the file was gone, taking the release pipeline dark on the next push to main."
      }
    ],
    "@semantic-release/github"
  ]
}
